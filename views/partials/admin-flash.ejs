<% if (typeof success !== "undefined" && success && success.length) { %>
  <div class="flash flash-s"><i class="fa-solid fa-circle-check"></i><span><%= success[0] %></span><span class="flash-x">&times;</span></div>
<% } %>
<% if (typeof error !== "undefined" && error && error.length) { %>
  <div class="flash flash-e"><i class="fa-solid fa-triangle-exclamation"></i><span><%= error[0] %></span><span class="flash-x">&times;</span></div>
<% } %>
