<header class="header">
  <nav class="navbar">
    <div class="nav-container">
      <ul class="nav-links nav-links--primary" id="navLinks">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Brands</a></li>
        <li><a href="/shop?strength=STRONG">Strength</a></li>
        <li><a href="/shop?flavour=mint">Flavours</a></li>
        <li><a href="/#reviews">Reviews</a></li>
      </ul>

      <div class="logo">
        <a href="/">
          <img src="/images/logo/snus-village-lion-shield.png" alt="Snus Village" />
          <span>
            <strong>Snus Village</strong>
            <small>Premium Snus Store</small>
          </span>
        </a>
      </div>

      <div class="header-tools">
        <form class="header-search" action="/shop" method="GET">
          <label for="headerSearch">Search products</label>
          <input id="headerSearch" type="search" name="search" placeholder="Search products" />
          <button type="submit">Search</button>
        </form>

        <a class="header-cart" href="/cart">Cart</a>

        <% if (user) { %>
          <a class="customer-nav__link" href="/auth/dashboard">Account</a>
        <% } else { %>
          <a class="customer-nav__link" href="/auth/login">Login</a>
        <% } %>
      </div>

      <button id="nav-icon4" type="button" aria-label="Toggle navigation"></button>
    </div>
  </nav>
</header>
