<header class="header">
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">
        <a href="/">
          <img src="/images/logo/snus-village-lion-shield.png" alt="Snus Village" />
          <span>
            <strong>Snus Village</strong>
            <small>London's premium snus store</small>
          </span>
        </a>
      </div>

      <ul class="nav-links" id="navLinks">
        <li><a href="/shop">All Products</a></li>
        <li><a href="/wholesale">Wholesale</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>

      <div class="customer-nav">
        <% if (user) { %>
          <a class="customer-nav__link" href="/auth/dashboard">
            <i class="fa-solid fa-user"></i>
            Account
          </a>
          <a class="customer-nav__link customer-nav__link--ghost" href="/auth/logout">
            Logout
          </a>
        <% } else { %>
          <a class="customer-nav__link customer-nav__link--ghost" href="/auth/register">
            Register
          </a>
          <a class="customer-nav__link" href="/auth/login">
            <i class="fa-solid fa-user"></i>
            Login
          </a>
        <% } %>
      </div>

      <button id="nav-icon4" type="button" aria-label="Toggle navigation"></button>
    </div>
  </nav>
</header>
