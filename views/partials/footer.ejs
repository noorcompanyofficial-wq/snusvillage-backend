<footer class="footer sv-footer">
  <div class="footer-strip">
    <div>
      <span>18+ only</span>
      <strong>Premium nicotine pouches and smoke-free alternatives for adult customers.</strong>
    </div>
    <a href="/shop">Shop products</a>
  </div>

  <div class="footer-container">
    <!-- BRAND -->
    <div class="footer-col footer-brand-col">
      <img src="/images/logo/snus-village-logo.webp" class="footer-logo" alt="Snus Village" />

      <p>
        London’s premium nicotine pouch store for trusted brands, clear support, and fast UK delivery.
      </p>

      <!-- SOCIAL -->
      <div class="footer-socials">
        <a href="https://www.instagram.com/snusvillage.uk/" class="social-icon" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">IG</span>
        </a>
        <a href="https://www.youtube.com/@SnusVillage" class="social-icon" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">YT</span>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Legal</h4>
      <a href="/terms-and-conditions">Terms & Conditions</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/cookies-policy">Cookies Policy</a>
      <a href="/shipping-policy">Shipping Policy</a>
    </div>

    <div class="footer-col">
      <h4>Our Office</h4>
      <p>📍 Snus Village</p>
      <p>89 Edgware Road</p>
      <p>London, W2 2HX</p>
    </div>

    <div class="footer-col footer-service-col">
      <h4>Help & FAQ</h4>
      <a href="/customer-service">FAQ & Customer Service</a>
      <a href="/customer-service#orders">Orders & Payments</a>
      <a href="/customer-service#delivery">Delivery & Tracking</a>
      <a href="/customer-service#returns">Returns & Damaged Items</a>
      <a href="/contact">Contact Form</a>
    </div>

    <div class="footer-col footer-contact-col" id="newsletter">
      <div class="newsletter-card">
        <span class="newsletter-eyebrow">Snus Village updates</span>
        <h4>Join The Newsletter</h4>
        <p>Receive new stock alerts, product drops, delivery updates, and store notices for adult customers.</p>

        <% if (typeof query !== "undefined" && query.newsletter === "joined") { %>
          <p class="newsletter-message newsletter-message--success">You are subscribed to Snus Village updates.</p>
        <% } else if (typeof query !== "undefined" && query.newsletter === "already") { %>
          <p class="newsletter-message newsletter-message--success">You are already on the Snus Village newsletter list.</p>
        <% } else if (typeof query !== "undefined" && query.newsletter === "invalid") { %>
          <p class="newsletter-message newsletter-message--error">Please enter a valid email address.</p>
        <% } else if (typeof query !== "undefined" && query.newsletter === "consent") { %>
          <p class="newsletter-message newsletter-message--error">Please tick the marketing consent box to subscribe.</p>
        <% } else if (typeof query !== "undefined" && query.newsletter === "limited") { %>
          <p class="newsletter-message newsletter-message--error">Too many signup attempts. Please try again shortly.</p>
        <% } else if (typeof query !== "undefined" && query.newsletter === "error") { %>
          <p class="newsletter-message newsletter-message--error">We could not save your signup right now. Please try again.</p>
        <% } %>

        <form class="newsletter" action="/newsletter/subscribe" method="POST" aria-label="Newsletter signup">
          <div class="newsletter-input-row">
            <label for="newsletterEmail">Email address</label>
            <input id="newsletterEmail" name="email" type="email" placeholder="hello@example.com" autocomplete="email" required />
            <button type="submit" aria-label="Join newsletter">
              <span aria-hidden="true">→</span>
            </button>
          </div>
          <label class="newsletter-consent">
            <input type="checkbox" name="marketingConsent" required>
            <span>I am 18+ and agree to receive Snus Village marketing emails. I understand I can unsubscribe at any time.</span>
          </label>
          <small class="newsletter-privacy">
            We handle your data under our <a href="/privacy-policy">Privacy Policy</a>.
          </small>
        </form>
      </div>
    </div>
  </div>

  <!-- BOTTOM -->
  <div class="footer-bottom">
    <p>© 2026 Snus Village. All rights reserved.</p>
    <p>Premium Brands · London Locations · Fast UK Delivery</p>
  </div>
</footer>
