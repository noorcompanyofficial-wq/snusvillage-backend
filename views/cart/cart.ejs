<div class="cv4-page">

  <!-- Dark nav breadcrumb strip -->
  <div class="cv4-breadcrumb-bar">
    <div class="cv4-breadcrumb-inner">
      <a href="/">Home</a>
      <span class="cv4-sep">›</span>
      <strong>Your Cart</strong>
    </div>
  </div>

  <% if (!cart || !cart.items || cart.items.length === 0) { %>
    <div class="cv4-empty">
      <div class="cv4-empty__icon"><i class="fa-solid fa-bag-shopping"></i></div>
      <h2>Your cart is empty</h2>
      <p>Add products from the shop to start your order.</p>
      <a href="/shop" class="cv4-btn cv4-btn--primary">Shop Products</a>
    </div>

  <% } else { %>
    <%
      const subtotal = cart.items.reduce((sum, item) => sum + (item.priceAtTime * item.quantity), 0);
      const freeDeliveryThreshold = Number(storeSettings?.freeDeliveryThreshold || 10);
      const standardDeliveryFee = Number(storeSettings?.deliveryPrice || 1.99);
      const deliveryFee = subtotal >= freeDeliveryThreshold ? 0 : standardDeliveryFee;
      const cartTotal = subtotal + deliveryFee;
    %>
    <div class="cv4-layout">

      <!-- Items column -->
      <div class="cv4-items-col">
        <div class="cv4-items-head">
          <span class="cv4-items-count"><%= cart.items.length %> item<%= cart.items.length === 1 ? "" : "s" %></span>
          <form action="/cart/clear" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="cv4-clear-btn">
              <i class="fa-solid fa-trash-can"></i> Clear Cart
            </button>
          </form>
        </div>

        <div class="cv4-items">
          <% cart.items.forEach(item => { %>
            <% if (item.product) { %>
              <div class="cv4-item">
                <div class="cv4-item__img">
                  <% if (item.product.images && item.product.images.length > 0) { %>
                    <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
                  <% } else { %>
                    <span>No image</span>
                  <% } %>
                </div>

                <div class="cv4-item__info">
                  <div class="cv4-item__brand"><%= item.product.brand || "Snus Village" %></div>
                  <h2 class="cv4-item__name"><%= item.product.name %></h2>
                  <div class="cv4-item__price">£<%= item.priceAtTime.toFixed(2) %> each</div>
                </div>

                <div class="cv4-item__controls">
                  <div class="cv4-qty">
                    <form action="/cart/update" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="productId" value="<%= item.product._id %>">
                      <input type="hidden" name="action" value="minus">
                      <button type="submit" class="cv4-qty__btn" <%= item.quantity <= 1 ? 'disabled' : '' %>>−</button>
                    </form>
                    <span class="cv4-qty__num"><%= item.quantity %></span>
                    <form action="/cart/update" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="productId" value="<%= item.product._id %>">
                      <input type="hidden" name="action" value="plus">
                      <button type="submit" class="cv4-qty__btn">+</button>
                    </form>
                  </div>
                  <div class="cv4-item__line-price">£<%= (item.priceAtTime * item.quantity).toFixed(2) %></div>
                  <form action="/cart/remove" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= item.product._id %>">
                    <button type="submit" class="cv4-remove-btn" title="Remove item">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </form>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>

        <a href="/shop" class="cv4-continue-link">
          <i class="fa-solid fa-arrow-left"></i> Continue Shopping
        </a>
      </div>

      <!-- Summary column -->
      <aside class="cv4-summary">
        <h2 class="cv4-summary__title">Order Summary</h2>

        <div class="cv4-summary__rows">
          <div class="cv4-summary__row">
            <span>Subtotal</span>
            <strong>£<%= subtotal.toFixed(2) %></strong>
          </div>
          <div class="cv4-summary__row">
            <span>Delivery</span>
            <strong>
              <% if (deliveryFee === 0) { %>Free
              <% } else { %>£<%= standardDeliveryFee.toFixed(2) %><% } %>
            </strong>
          </div>
          <% if (deliveryFee > 0) { %>
            <div class="cv4-summary__shipping-note">
              Spend <strong>£<%= (freeDeliveryThreshold - subtotal).toFixed(2) %></strong> more for free delivery
            </div>
          <% } else { %>
            <div class="cv4-summary__shipping-note cv4-summary__shipping-note--free">
              <i class="fa-solid fa-circle-check"></i> You qualify for free delivery
            </div>
          <% } %>
        </div>

        <div class="cv4-summary__total">
          <span>Total</span>
          <strong>£<%= cartTotal.toFixed(2) %></strong>
        </div>

        <div
          class="cv4-express"
          id="cartExpressCheckout"
          data-sumup-public-key="<%= sumupPublicKey || "" %>"
          data-google-pay-merchant-id="<%= googlePayMerchantId || "" %>"
          hidden
        >
          <p class="cv4-express__title">Express checkout</p>
          <div id="cartExpressCheckoutContainer"></div>
          <p
            class="cv4-express__error"
            id="cartExpressCheckoutError"
            role="alert"
            aria-live="polite"
            hidden
          ></p>
          <div class="cv4-express__divider"><span>Or continue to checkout</span></div>
        </div>

        <a href="/checkout" class="cv4-btn cv4-btn--primary cv4-btn--full">
          <i class="fa-solid fa-lock"></i> Secure Checkout
        </a>

        <div class="cv4-summary__payments">
          <span>Accepted payments via SumUp</span>
          <div class="cv4-payment-badges">
            <span>Visa</span>
            <span>Mastercard</span>
            <span>Debit / Credit</span>
          </div>
        </div>

        <div class="cv4-summary__trust">
          <div><i class="fa-solid fa-shield-halved"></i> Age-verified checkout</div>
          <div><i class="fa-solid fa-truck-fast"></i> Fast UK delivery</div>
          <div><i class="fa-solid fa-rotate-left"></i> Hassle-free returns</div>
        </div>
      </aside>
    </div>
  <% } %>
</div>

<% if (sumupPublicKey) { %>
  <script src="https://js.sumup.com/swift-checkout/v1/sdk.js"></script>
  <script>
    (function () {
      const section = document.getElementById("cartExpressCheckout");
      const container = document.getElementById("cartExpressCheckoutContainer");
      const errorArea = document.getElementById("cartExpressCheckoutError");
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || "";
      const publicKey = section?.dataset.sumupPublicKey || "";
      const googlePayMerchantId = section?.dataset.googlePayMerchantId || "";
      const googlePayDemoMode = [
        "#sumup:google-pay-demo-mode",
        "#sumup-widget:google-pay-demo-mode",
      ].includes(window.location.hash);
      let client;
      let paymentRequest;
      let walletButtons;
      let processing = false;
      let selectedDeliveryService = "standard";

      function showError(message) {
        if (!errorArea) return;
        errorArea.textContent = message || "";
        errorArea.hidden = !message;
      }

      async function postJson(url, body) {
        const response = await fetch(url, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
            "X-CSRF-Token": csrfToken,
          },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Express checkout is unavailable.");
        }

        return result;
      }

      function paymentRequestOptions(quote) {
        const options = {
          countryCode: "GB",
          locale: "en-GB",
          total: quote.total,
          shippingOptions: quote.shippingOptions,
        };

        if (googlePayMerchantId) {
          options.methodData = [{
            supportedMethods: "google_pay",
            data: {
              merchantInfo: {
                merchantId: googlePayMerchantId,
                merchantName: "Snus Village",
              },
            },
          }];
        }

        return options;
      }

      async function getQuote(deliveryService, countryCode) {
        return postJson("/checkout/express/quote", {
          deliveryService: deliveryService || selectedDeliveryService,
          countryCode: countryCode || "GB",
        });
      }

      function configureShippingCallbacks(request) {
        request.onShippingAddressChange(async (address) => {
          const countryCode =
            address?.countryCode || address?.country || address?.country_code || "GB";
          const quote = await getQuote(selectedDeliveryService, countryCode);
          return { total: quote.total, shippingOptions: quote.shippingOptions };
        });

        request.onShippingOptionsChange(async (shippingOption) => {
          selectedDeliveryService =
            shippingOption?.id || shippingOption?.shippingOption || shippingOption || "standard";
          const quote = await getQuote(selectedDeliveryService, "GB");
          return { total: quote.total, shippingOptions: quote.shippingOptions };
        });
      }

      function splitName(name) {
        const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
        return {
          firstName: parts.shift() || "",
          lastName: parts.join(" "),
        };
      }

      function normaliseWalletDetails(paymentResponse) {
        const details = paymentResponse?.details || {};
        const contact =
          details.contactInformation || details.contact || details.payer || {};
        const address =
          details.shippingAddress || details.shipping_address || {};
        const contactName = splitName(
          contact.name || contact.fullName || address.recipient || address.name
        );
        const addressLines =
          address.addressLine || address.addressLines || address.address_line || [];
        const selectedOption =
          details.shippingOption?.id ||
          details.shippingOption ||
          details.shippingOptions?.id ||
          details.shippingOptions?.[0]?.id ||
          selectedDeliveryService;

        return {
          customer: {
            email: contact.email || details.payerEmail || "",
            phone: contact.phone || contact.phoneNumber || details.payerPhone || "",
            firstName: contact.firstName || contact.givenName || contactName.firstName,
            lastName: contact.lastName || contact.familyName || contactName.lastName,
          },
          delivery: {
            address: Array.isArray(addressLines)
              ? addressLines.filter(Boolean).join(", ")
              : String(addressLines || ""),
            city: address.city || address.locality || address.town || "",
            postcode: address.postalCode || address.postcode || address.postal_code || "",
            countryCode: (
              address.countryCode || address.country || address.country_code || ""
            ).toUpperCase(),
          },
          deliveryService:
            selectedOption === "next-day" ? "next_day" : selectedOption,
        };
      }

      function createAttemptId() {
        if (window.crypto?.randomUUID) return window.crypto.randomUUID();
        return `wallet-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      async function handleWalletSubmit(paymentMethodEvent) {
        if (processing || !paymentRequest) return;

        processing = true;
        showError("");
        section.classList.add("is-processing");
        let returnUrl = "";

        try {
          const paymentResponse = await paymentRequest.show(paymentMethodEvent);
          const orderDetails = normaliseWalletDetails(paymentResponse);
          const orderResult = await postJson("/checkout/express/create-order", {
            ...orderDetails,
            attemptId: createAttemptId(),
          });

          returnUrl = orderResult.returnUrl;
          await client.processCheckout(orderResult.checkoutId, paymentResponse);
          window.location.assign(returnUrl);
        } catch (error) {
          const cancelledError =
            window.SumUp?.SwiftCheckout?.Errors?.PaymentRequestCancelledError;

          if (returnUrl) {
            window.location.assign(returnUrl);
            return;
          }

          if (cancelledError && error instanceof cancelledError) {
            showError("Express checkout was cancelled. You have not been charged.");
          } else {
            showError(
              error?.message ||
                "Express checkout is unavailable. Please continue to the normal checkout."
            );
          }

          processing = false;
          section.classList.remove("is-processing");
        }
      }

      async function initialiseExpressCheckout() {
        if (!section || !container || !publicKey || !window.SumUp?.SwiftCheckout) return;

        try {
          const quote = await getQuote("standard", "GB");
          client = new window.SumUp.SwiftCheckout(publicKey);
          paymentRequest = client.paymentRequest(paymentRequestOptions(quote));
          configureShippingCallbacks(paymentRequest);

          if (!(await paymentRequest.canMakePayment())) return;

          let paymentMethods = await paymentRequest.availablePaymentMethods();

          if (
            googlePayDemoMode &&
            !paymentMethods.some((method) => method.id === "google_pay")
          ) {
            paymentMethods.push({ id: "google_pay" });
          } else if (!googlePayMerchantId) {
            paymentMethods = paymentMethods.filter((method) => method.id !== "google_pay");
          }

          if (!paymentMethods.length) return;

          walletButtons = client.elements({ label: "buy" });
          walletButtons.onSubmit(handleWalletSubmit).mount({
            paymentMethods,
            container,
          });
          section.hidden = false;
        } catch (error) {
          console.warn("Cart express checkout unavailable:", error?.message || error);
        }
      }

      initialiseExpressCheckout();
    })();
  </script>
<% } %>
