<%
  const memberSinceLabel = memberSince ? new Date(memberSince).toLocaleDateString("en-GB", { month: "long", year: "numeric" }) : "—";
  const isAgeVerified = user.isAgeVerified || user.didit?.verified;
%>

<div class="dsh-ph">
  <div>
    <div class="dsh-ph-eye">Account</div>
    <h1>Profile</h1>
    <p>Manage your account details.</p>
  </div>
</div>

<div class="dsh-profile-layout">
  <div>
    <div class="dsh-card" style="margin-bottom:14px;">
      <div class="dsh-card-head"><h2>Personal Details</h2></div>
      <div style="padding:20px;">
        <form action="/auth/dashboard/profile" method="POST" data-no-spa>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="dsh-fgrid">
            <div class="dsh-fld"><label>First name</label><input type="text" name="firstName" value="<%= user.firstName || '' %>" /></div>
            <div class="dsh-fld"><label>Last name</label><input type="text" name="lastName" value="<%= user.lastName || '' %>" /></div>
            <div class="dsh-fld dsh-fspan"><label>Email address</label><input type="email" name="email" value="<%= user.email %>" /></div>
            <div class="dsh-fld dsh-fspan"><label>Phone (optional)</label><input type="tel" name="phone" value="<%= user.phone || '' %>" placeholder="+44 7700 000000" /></div>
          </div>
          <button type="submit" class="dsh-btn dsh-btn-navy"><i class="fa-solid fa-floppy-disk"></i> Save changes</button>
        </form>
      </div>
    </div>

    <% if (user.password) { %>
      <div class="dsh-card">
        <div class="dsh-card-head"><h2>Change Password</h2></div>
        <div style="padding:20px;">
          <form action="/auth/dashboard/password" method="POST" data-no-spa>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="dsh-fld"><label>Current password</label><input type="password" name="currentPassword" required /></div>
            <div class="dsh-fgrid">
              <div class="dsh-fld"><label>New password</label><input type="password" name="newPassword" placeholder="Minimum 8 characters" required minlength="8" /></div>
              <div class="dsh-fld"><label>Confirm new password</label><input type="password" name="confirmPassword" placeholder="Repeat new password" required minlength="8" /></div>
            </div>
            <button type="submit" class="dsh-btn dsh-btn-navy"><i class="fa-solid fa-lock"></i> Update password</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <div class="dsh-card" style="margin-bottom:14px;">
      <div class="dsh-card-head"><h2>Account Info</h2></div>
      <div style="padding:16px;display:grid;gap:10px;">
        <div class="dsh-info-row"><span>Member since</span><span><%= memberSinceLabel %></span></div>
        <div class="dsh-info-row"><span>Total orders</span><span><%= stats.totalOrders %></span></div>
        <div class="dsh-info-row"><span>Total spent</span><span>&pound;<%= stats.totalSpent.toFixed(2) %></span></div>
        <div class="dsh-info-row">
          <span>Age verified</span>
          <% if (isAgeVerified) { %>
            <span style="color:var(--dsh-grn);display:flex;align-items:center;gap:5px;"><i class="fa-solid fa-circle-check"></i> Yes</span>
          <% } else { %>
            <span style="color:var(--dsh-mu);">Not yet</span>
          <% } %>
        </div>
      </div>
    </div>

    <% if (user.deletionRequestedAt) { %>
      <div class="dsh-card" style="border-color:rgba(217,119,6,.25);">
        <div class="dsh-card-head" style="border-color:rgba(217,119,6,.15);"><h2 style="color:var(--dsh-amb);">Deletion Requested</h2></div>
        <div style="padding:16px;">
          <p style="font-size:12px;color:var(--dsh-mu);line-height:1.65;">You requested account deletion on <%= new Date(user.deletionRequestedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) %>. Our team will review and action this shortly.</p>
        </div>
      </div>
    <% } else { %>
      <div class="dsh-card" style="border-color:rgba(220,38,38,.2);">
        <div class="dsh-card-head" style="border-color:rgba(220,38,38,.12);"><h2 style="color:#dc2626;">Delete Account</h2></div>
        <div style="padding:16px;">
          <p style="font-size:12px;color:var(--dsh-mu);line-height:1.65;margin-bottom:14px;">Request deletion of your account and associated data. Our team will review and confirm by email — nothing is deleted immediately.</p>
          <form action="/auth/dashboard/delete-request" method="POST" data-no-spa data-delete-account-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="dsh-btn dsh-btn-danger dsh-btn-sm"><i class="fa-solid fa-trash"></i> Request account deletion</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>
