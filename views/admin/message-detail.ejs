<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Customer Message</div>
    <h1><%= message.subject %></h1>
    <p>Submitted by <%= message.name %> on <%= new Date(message.createdAt).toLocaleString("en-GB") %>.</p>
  </div>
  <div class="ph-right">
    <a class="btn btn-ghost" href="/admin/messages"><i class="fa-solid fa-arrow-left"></i> Back To Messages</a>
    <a class="btn btn-red" href="mailto:<%= message.email %>?subject=Re: <%= encodeURIComponent(message.subject) %>" data-no-spa><i class="fa-solid fa-reply"></i> Reply By Email</a>
  </div>
</div>

<div class="dg2">
  <div class="sec">
    <div class="sec-head"><h2>Sender</h2><span class="pill <%= message.isRead ? 'p-completed' : 'p-pending' %>"><%= message.isRead ? "Read" : "Unread" %></span></div>
    <div class="sec-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div><div class="stat-lbl">Name</div><strong><%= message.name %></strong></div>
      <div><div class="stat-lbl">Email</div><strong><%= message.email %></strong></div>
      <div><div class="stat-lbl">Phone</div><strong><%= message.phone || "No phone" %></strong></div>
      <div><div class="stat-lbl">Date</div><strong><%= new Date(message.createdAt).toLocaleString("en-GB") %></strong></div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Actions</h2></div>
    <div class="sec-body t-actions">
      <% if (message.isRead) { %>
        <form action="/admin/messages/<%= message._id %>/unread" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-ghost">Mark As Unread</button></form>
      <% } else { %>
        <form action="/admin/messages/<%= message._id %>/read" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-ghost">Mark As Read</button></form>
      <% } %>
      <form action="/admin/messages/<%= message._id %>/delete" method="POST" onsubmit="return confirm('Delete this message?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-danger">Delete Message</button></form>
    </div>
  </div>
</div>

<div class="sec">
  <div class="sec-head"><h2>Conversation</h2></div>
  <div class="msg-bubbles" style="max-height:none;">
    <div class="bub bub-in"><%= message.message %><div class="bub-time"><%= message.name %> &middot; <%= new Date(message.createdAt).toLocaleString("en-GB") %></div></div>
    <% (message.replies || []).forEach((reply) => { %>
      <div class="bub bub-out"><%= reply.body %><div class="bub-time">Snus Village &middot; <%= new Date(reply.sentAt).toLocaleString("en-GB") %></div></div>
    <% }) %>
  </div>
  <form class="msg-reply" action="/admin/messages/<%= message._id %>/reply" method="POST" data-message-reply-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <textarea name="replyBody" placeholder="Write your reply to <%= message.name %>..." required></textarea>
    <button type="submit" class="btn btn-red"><i class="fa-solid fa-paper-plane"></i> Send</button>
  </form>
</div>
