<%- include("../partials/admin-flash") %>

<% if (account.deletionRequestedAt) { %>
  <div class="sec" style="border-color:rgba(217,119,6,.35);margin-bottom:16px;">
    <div class="sec-head" style="border-color:rgba(217,119,6,.2);">
      <h2 style="color:#d97706;"><i class="fa-solid fa-triangle-exclamation"></i> Account Deletion Requested</h2>
    </div>
    <div class="sec-body" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <p style="color:var(--mu);font-size:12px;margin:0;">This customer requested account deletion on <%= new Date(account.deletionRequestedAt).toLocaleString("en-GB") %>. Review and action manually, then dismiss once handled.</p>
      <form action="/admin/users/<%= account._id %>/dismiss-deletion-request" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-ghost btn-sm"><i class="fa-solid fa-check"></i> Dismiss Request</button>
      </form>
    </div>
  </div>
<% } %>

<div class="ph">
  <div>
    <div class="ph-eye">Customer Profile</div>
    <h1><%= [account.firstName, account.lastName].filter(Boolean).join(" ") || "User Account" %></h1>
    <p><%= account.email %></p>
  </div>
  <div class="ph-right">
    <a class="btn btn-ghost" href="/admin/users"><i class="fa-solid fa-arrow-left"></i> Back To Users</a>
    <a class="btn btn-red" href="mailto:<%= account.email %>" data-no-spa><i class="fa-solid fa-envelope"></i> Email Customer</a>
  </div>
</div>

<div class="stats">
  <div class="stat stat-blue"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-receipt"></i></div></div><div class="stat-lbl">Total Orders</div><div class="stat-val"><%= stats.totalOrders || 0 %></div></div>
  <div class="stat stat-grn"><div class="stat-top"><div class="stat-icon si-g"><i class="fa-solid fa-circle-check"></i></div></div><div class="stat-lbl">Paid Orders</div><div class="stat-val"><%= stats.paidOrders || 0 %></div></div>
  <div class="stat stat-blue"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-sterling-sign"></i></div></div><div class="stat-lbl">Total Spend</div><div class="stat-val" style="font-size:19px;">&pound;<%= Number(stats.totalSpend || 0).toFixed(2) %></div></div>
  <div class="stat stat-amb"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-calendar"></i></div></div><div class="stat-lbl">Last Order</div><div class="stat-val" style="font-size:16px;"><%= stats.lastOrder ? new Date(stats.lastOrder.createdAt).toLocaleDateString("en-GB") : "None" %></div></div>
</div>

<div class="dg2">
  <div class="sec">
    <div class="sec-head"><h2>Account Details</h2></div>
    <div class="sec-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div><div class="stat-lbl">Name</div><strong><%= [account.firstName, account.lastName].filter(Boolean).join(" ") || "Not Provided" %></strong></div>
      <div><div class="stat-lbl">Email</div><strong><%= account.email %></strong></div>
      <div><div class="stat-lbl">Role</div><strong><%= account.role || "user" %></strong></div>
      <div><div class="stat-lbl">Email Verified</div><strong><%= account.isVerified ? "Yes" : "No" %></strong></div>
      <div><div class="stat-lbl">Age Verified</div><strong><%= account.isAgeVerified ? "Yes" : "No" %></strong></div>
      <div><div class="stat-lbl">Didit Status</div><strong><%= account.didit?.status || account.diditStatus || "Not Started" %></strong></div>
      <div><div class="stat-lbl">Trader Status</div><strong><%= account.traderStatus || "none" %></strong></div>
      <div><div class="stat-lbl">Joined</div><strong><%= account.createdAt ? new Date(account.createdAt).toLocaleString("en-GB") : "N/A" %></strong></div>
    </div>
  </div>

  <% if (["owner", "admin"].includes(user?.role || "")) { %>
    <div class="sec">
      <div class="sec-head"><h2>Staff Role Control</h2></div>
      <div class="sec-body">
        <% if (String(user?._id || "") === String(account._id || "")) { %>
          <p style="color:var(--mu);font-size:12px;">You cannot change your own role from this page.</p>
        <% } else { %>
          <form action="/admin/users/<%= account._id %>/role" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="fld"><label>Account Role</label>
              <select name="role">
                <option value="user" <%= account.role === "user" ? "selected" : "" %>>User</option>
                <option value="owner" <%= account.role === "owner" ? "selected" : "" %>>Owner</option>
                <option value="admin" <%= account.role === "admin" ? "selected" : "" %>>Admin</option>
                <option value="manager" <%= account.role === "manager" ? "selected" : "" %>>Manager</option>
                <option value="fulfilment" <%= account.role === "fulfilment" ? "selected" : "" %>>Fulfilment</option>
                <option value="support" <%= account.role === "support" ? "selected" : "" %>>Support</option>
                <option value="product_manager" <%= account.role === "product_manager" ? "selected" : "" %>>Product Manager</option>
              </select>
            </div>
            <button type="submit" class="btn btn-red" onclick="return confirm('Change this user\'s role?')"><i class="fa-solid fa-user-shield"></i> Update Role</button>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="sec">
    <div class="sec-head"><h2>Private Admin Notes</h2></div>
    <form class="sec-body" action="/admin/users/<%= account._id %>/notes" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="fld"><label>Notes</label><textarea name="adminNotes" rows="3" placeholder="Add private notes about this customer..."><%= account.adminNotes || "" %></textarea></div>
      <button type="submit" class="btn btn-red"><i class="fa-solid fa-floppy-disk"></i> Save Notes</button>
    </form>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Security Details</h2></div>
    <div class="sec-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div><div class="stat-lbl">Login Attempts</div><strong><%= account.loginAttempts || 0 %></strong></div>
      <div><div class="stat-lbl">Locked Until</div><strong><%= account.lockUntil ? new Date(account.lockUntil).toLocaleString("en-GB") : "Not Locked" %></strong></div>
      <div><div class="stat-lbl">Suspicious IPs</div><strong><%= account.suspiciousIPs?.length || 0 %></strong></div>
      <div><div class="stat-lbl">Blocked IPs</div><strong><%= account.blockedIPs?.length || 0 %></strong></div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Trader Record</h2></div>
    <div class="sec-body">
      <% if (trader) { %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div><div class="stat-lbl">Business</div><strong><%= trader.businessName || "N/A" %></strong></div>
          <div><div class="stat-lbl">Contact</div><strong><%= trader.contactName || "N/A" %></strong></div>
          <div><div class="stat-lbl">Status</div><strong><%= trader.status || "N/A" %></strong></div>
          <div><div class="stat-lbl">Phone</div><strong><%= trader.phone || "N/A" %></strong></div>
        </div>
      <% } else { %>
        <p style="color:var(--mu);font-size:12px;">No trader record linked to this customer.</p>
      <% } %>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Cart History</h2><span class="panel-lk" onclick="location.href='/admin/carts'">View carts &rarr;</span></div>
    <div class="sec-body">
      <% if (carts && carts.length) { %>
        <div class="al-list" style="padding:0;">
          <% carts.forEach((cart) => {
            const cartTotal = cart.items.reduce((sum, item) => sum + ((item.priceAtTime || 0) * (item.quantity || 0)), 0);
          %>
            <a class="msg-item2" href="/admin/carts">
              <div style="flex:1;"><div class="msg-name"><%= cart.items.length %> item<%= cart.items.length === 1 ? "" : "s" %></div><div class="msg-prev" style="max-width:none;">Updated <%= new Date(cart.updatedAt).toLocaleString("en-GB") %></div></div>
              <span class="t-amt">&pound;<%= Number(cartTotal || 0).toFixed(2) %></span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p style="color:var(--mu);font-size:12px;">No carts found for this customer.</p>
      <% } %>
    </div>
  </div>
</div>

<div class="sec">
  <div class="sec-head"><h2>Order History</h2><span class="panel-lk" onclick="location.href='/admin/orders'">View all orders &rarr;</span></div>
  <% if (orders && orders.length) { %>
    <div class="tbl-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Status</th><th>Total</th><th>Action</th></tr></thead><tbody>
      <% orders.forEach((order) => { %>
        <tr>
          <td class="t-mono">#<%= order._id.toString().slice(-6).toUpperCase() %></td>
          <td class="t-sub"><%= new Date(order.createdAt).toLocaleString("en-GB") %></td>
          <td><span class="pill p-<%= order.paymentStatus || 'pending' %>"><%= order.paymentStatus || "pending" %></span></td>
          <td><span class="pill p-<%= order.orderStatus || 'new' %>"><%= order.orderStatus || "new" %></span></td>
          <td><span class="t-amt">&pound;<%= Number(order.total || 0).toFixed(2) %></span></td>
          <td><a class="btn btn-sm btn-ghost" href="/admin/orders/<%= order._id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody></table></div>
  <% } else { %>
    <div class="admin-empty-state"><h2>No Orders Found</h2><p>This customer has not placed an order yet.</p></div>
  <% } %>
</div>
