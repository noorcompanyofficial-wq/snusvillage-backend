<section class="admin-page admin-seo-page">
  <div class="admin-page-head">
    <div>
      <span>SEO Dashboard</span>
      <h1>Product SEO Health</h1>
      <p>Find missing SEO titles, weak descriptions, missing images, inactive products, and products that need optimisation before launch.</p>
    </div>

    <div class="admin-head-actions">
      <a class="admin-secondary" href="/admin/products">
        <i class="fa-solid fa-boxes-stacked"></i>
        Products
      </a>
      <a class="admin-secondary" href="/shop" target="_blank" rel="noopener">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        Preview Shop
      </a>
    </div>
  </div>

  <div class="admin-analytics-grid">
    <a class="admin-analytics-card admin-analytics-card--dark" href="/admin/seo">
      <i class="fa-solid fa-magnifying-glass-chart"></i>
      <span>Total Products</span>
      <strong><%= stats.totalProducts %></strong>
      <small>Products scanned</small>
    </a>

    <a class="admin-analytics-card admin-analytics-card--warning" href="/admin/seo?issue=missingTitle">
      <i class="fa-solid fa-heading"></i>
      <span>Missing SEO Title</span>
      <strong><%= stats.missingSeoTitle %></strong>
      <small>Needs meta title</small>
    </a>

    <a class="admin-analytics-card admin-analytics-card--warning" href="/admin/seo?issue=missingDescription">
      <i class="fa-solid fa-align-left"></i>
      <span>Missing SEO Description</span>
      <strong><%= stats.missingSeoDescription %></strong>
      <small>Needs meta description</small>
    </a>

    <a class="admin-analytics-card" href="/admin/seo?issue=shortDescription">
      <i class="fa-solid fa-file-lines"></i>
      <span>Short Description</span>
      <strong><%= stats.shortDescription %></strong>
      <small>Less than 80 characters</small>
    </a>

    <a class="admin-analytics-card admin-analytics-card--warning" href="/admin/seo?issue=noImage">
      <i class="fa-solid fa-image"></i>
      <span>No Image</span>
      <strong><%= stats.noImage %></strong>
      <small>Product image missing</small>
    </a>

    <a class="admin-analytics-card" href="/admin/seo?issue=hidden">
      <i class="fa-solid fa-eye-slash"></i>
      <span>Hidden Products</span>
      <strong><%= stats.hiddenProducts %></strong>
      <small>Not active</small>
    </a>
  </div>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <div>
        <h2>SEO Filters</h2>
        <p>Filter products by SEO issue and fix them quickly.</p>
      </div>
      <a href="/admin/seo">Reset</a>
    </div>

    <form class="admin-seo-filter-form" method="GET" action="/admin/seo">
      <label>
        SEO Issue
        <select name="issue">
          <option value="">All Products</option>
          <option value="missingTitle" <%= query.issue === "missingTitle" ? "selected" : "" %>>Missing SEO Title</option>
          <option value="missingDescription" <%= query.issue === "missingDescription" ? "selected" : "" %>>Missing SEO Description</option>
          <option value="shortDescription" <%= query.issue === "shortDescription" ? "selected" : "" %>>Short Product Description</option>
          <option value="noImage" <%= query.issue === "noImage" ? "selected" : "" %>>No Product Image</option>
          <option value="hidden" <%= query.issue === "hidden" ? "selected" : "" %>>Hidden Products</option>
        </select>
      </label>

      <label>
        Search
        <input name="search" value="<%= query.search || '' %>" placeholder="Product name, brand, SKU, slug">
      </label>

      <button type="submit">Apply</button>
    </form>
  </section>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <h2>Product SEO Checklist</h2>
      <span><%= products.length %> Product<%= products.length === 1 ? "" : "s" %></span>
    </div>

    <% if (!products.length) { %>
      <div class="admin-empty-state">
        <h2>No Products Found</h2>
        <p>No products match this SEO filter.</p>
      </div>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table admin-seo-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>SEO Score</th>
              <th>SEO Title</th>
              <th>SEO Description</th>
              <th>Issues</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% products.forEach((product) => { %>
              <tr>
                <td>
                  <strong><%= product.name %></strong>
                  <span><%= product.brand || "No Brand" %> · <%= product.sku || "No SKU" %></span>
                  <span>Slug: <%= product.slug || "Missing slug" %></span>
                </td>

                <td>
                  <strong><%= product.seoScore %>%</strong>
                  <span class="status-pill <%= product.seoScore >= 80 ? 'order-completed' : product.seoScore >= 50 ? 'payment-pending' : 'payment-failed' %>">
                    <%= product.seoScore >= 80 ? "Good" : product.seoScore >= 50 ? "Needs Work" : "Poor" %>
                  </span>
                </td>

                <td>
                  <strong><%= product.seoTitle || "Missing" %></strong>
                  <span><%= product.seoTitleLength %> characters</span>
                </td>

                <td>
                  <strong><%= product.seoDescription || "Missing" %></strong>
                  <span><%= product.seoDescriptionLength %> characters</span>
                </td>

                <td>
                  <% if (product.issues.length) { %>
                    <% product.issues.forEach((issue) => { %>
                      <span class="status-pill payment-pending" style="margin: 3px;"><%= issue %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="status-pill order-completed">No Major Issues</span>
                  <% } %>
                </td>

                <td>
                  <a class="admin-table-action" href="/admin/products/edit/<%= product._id %>">Edit SEO</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</section>
