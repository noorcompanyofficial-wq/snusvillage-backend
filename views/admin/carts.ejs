<section class="admin-page">
  <div class="admin-page-head">
    <div>
      <span>Carts</span>
      <h1>Unfinished Customer Carts</h1>
      <p>Track active and abandoned carts so you can understand missed orders and product interest.</p>
    </div>

    <a class="admin-primary" href="/admin/dashboard">
      <i class="fa-solid fa-chart-line"></i>
      Back To Dashboard
    </a>
  </div>

  <% if (!carts || carts.length === 0) { %>
    <div class="admin-empty-state">
      <h2>No Active Or Abandoned Carts</h2>
      <p>Carts with products will appear here once customers add items.</p>
    </div>
  <% } else { %>
    <div class="admin-carts-grid">
      <% carts.forEach((cart) => { %>
        <% const cartTotal = cart.items.reduce((sum, item) => sum + ((item.priceAtTime || 0) * (item.quantity || 0)), 0); %>
        <% const isAbandoned = new Date(cart.updatedAt) < cartStaleCutoff; %>

        <article class="admin-cart-card">
          <div class="admin-cart-card__top">
            <div>
              <span class="<%= isAbandoned ? 'status-pill payment-failed' : 'status-pill order-processing' %>">
                <%= isAbandoned ? "Abandoned" : "Active" %>
              </span>
              <h2><%= cart.user ? "User Cart" : "Guest Cart" %></h2>
              <p>Last Active: <%= new Date(cart.updatedAt).toLocaleString("en-GB") %></p>
            </div>

            <strong>£<%= Number(cartTotal || 0).toFixed(2) %></strong>
          </div>

          <div class="admin-cart-items">
            <% cart.items.forEach((item) => { %>
              <div class="admin-cart-item">
                <% if (item.product && item.product.images && item.product.images[0]) { %>
                  <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
                <% } else { %>
                  <span>No Image</span>
                <% } %>

                <div>
                  <strong><%= item.product?.name || "Deleted Product" %></strong>
                  <small>Qty: <%= item.quantity %> × £<%= Number(item.priceAtTime || 0).toFixed(2) %></small>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="admin-cart-card__footer">
            <span><%= cart.items.length %> Item<%= cart.items.length === 1 ? "" : "s" %></span>
            <span>Session: <%= cart.sessionId ? cart.sessionId.slice(-8) : "N/A" %></span>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
