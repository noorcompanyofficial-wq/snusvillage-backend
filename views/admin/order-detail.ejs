<%
  const shortId = order._id.toString().slice(-6).toUpperCase();
  const isClickCollect = order.fulfilment?.method === "click_collect";
  const checklist = order.fulfilmentChecklist || {};
  const discountAmount = Number(order.discount?.amount || 0);
  const paidAt = order.sumup?.paidAt ? new Date(order.sumup.paidAt).toLocaleString("en-GB") : "Not paid yet";
%>
<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Order Detail</div>
    <h1>Order #<%= shortId %></h1>
    <p>Customer, payment, discount, fulfilment, Royal Mail, and internal admin notes.</p>
  </div>
  <div class="ph-right">
    <a class="btn btn-ghost" href="/admin/orders/export/csv" data-no-spa><i class="fa-solid fa-file-export"></i> Export CSV</a>
    <a class="btn btn-red" href="/admin/orders"><i class="fa-solid fa-arrow-left"></i> Back To Orders</a>
  </div>
</div>

<div class="stats">
  <div class="stat stat-blue"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-sterling-sign"></i></div></div><div class="stat-lbl">Total</div><div class="stat-val">&pound;<%= Number(order.total || 0).toFixed(2) %></div><div class="stat-sub">Final customer payment</div></div>
  <div class="stat stat-grn"><div class="stat-top"><div class="stat-icon si-g"><i class="fa-solid fa-credit-card"></i></div></div><div class="stat-lbl">Payment</div><div class="stat-val" style="font-size:16px;text-transform:capitalize;"><%= order.paymentStatus || "pending" %></div><div class="stat-sub">SumUp: <%= order.sumup?.status || "Not started" %></div></div>
  <div class="stat stat-amb"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-box"></i></div></div><div class="stat-lbl">Order Status</div><div class="stat-val" style="font-size:16px;text-transform:capitalize;"><%= order.orderStatus || "new" %></div><div class="stat-sub">Created <%= new Date(order.createdAt).toLocaleString("en-GB") %></div></div>
  <div class="stat stat-red"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid <%= isClickCollect ? 'fa-store' : 'fa-truck' %>"></i></div></div><div class="stat-lbl">Fulfilment</div><div class="stat-val" style="font-size:16px;"><%= isClickCollect ? "Click & Collect" : "Delivery" %></div><div class="stat-sub"><%= order.fulfilment?.deliveryServiceLabel || (isClickCollect ? (order.fulfilment?.collectionBranch || "Collection") : "Royal Mail") %></div></div>
</div>

<div class="od-layout">
  <div>
    <div class="sec">
      <div class="sec-head"><h2>Customer</h2><% if (order.user) { %><a class="btn btn-sm btn-ghost" href="/admin/users/<%= order.user %>">View Customer</a><% } %></div>
      <div class="sec-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div><div class="stat-lbl">Name</div><strong><%= [order.customer?.firstName, order.customer?.lastName].filter(Boolean).join(" ") || "No name" %></strong></div>
        <div><div class="stat-lbl">Email</div><strong><%= order.customer?.email || "No email" %></strong></div>
        <div><div class="stat-lbl">Phone</div><strong><%= order.customer?.phone || "No phone" %></strong></div>
        <div><div class="stat-lbl">Order ID</div><strong style="font-size:11px;"><%= order._id %></strong></div>
      </div>
    </div>

    <div class="sec">
      <div class="sec-head"><h2><%= isClickCollect ? "Collection" : "Delivery" %></h2></div>
      <div class="sec-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div><div class="stat-lbl">Method</div><strong><%= order.fulfilment?.deliveryServiceLabel || (isClickCollect ? "Click & Collect" : "Delivery") %></strong></div>
        <% if (!isClickCollect && order.fulfilment?.deliveryService === "next_day") { %><div><div class="stat-lbl">Cut-Off</div><strong>Before <%= order.fulfilment?.deliveryCutoff || "4:30pm" %></strong></div><% } %>
        <div><div class="stat-lbl">Delivery Charge</div><strong><%= Number(order.shipping || 0) === 0 ? "Free" : "£" + Number(order.shipping || 0).toFixed(2) %></strong></div>
        <div><div class="stat-lbl">Address</div><strong><%= order.delivery?.address || "No address" %></strong></div>
        <div><div class="stat-lbl">City</div><strong><%= order.delivery?.city || "No city" %></strong></div>
        <div><div class="stat-lbl">Postcode</div><strong><%= order.delivery?.postcode || "No postcode" %></strong></div>
        <% if (isClickCollect) { %><div><div class="stat-lbl">Collection Branch</div><strong><%= order.fulfilment?.collectionBranch || "N/A" %></strong></div><% } %>
      </div>
    </div>

    <div class="sec">
      <div class="sec-head"><h2>Items</h2><span style="font-size:11px;color:var(--mu);"><%= order.items?.length || 0 %> item<%= order.items?.length === 1 ? "" : "s" %></span></div>
      <div class="sec-body" style="display:grid;gap:10px;">
        <% (order.items || []).forEach(item => { %>
          <div style="display:flex;align-items:center;gap:12px;">
            <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" style="width:44px;height:44px;object-fit:contain;flex-shrink:0;background:var(--bg);border-radius:6px;"><% } %>
            <div style="flex:1;"><strong style="display:block;font-size:12px;"><%= item.name %></strong><span style="font-size:10px;color:var(--mu);"><%= item.brand || "Snus Village" %> &middot; Qty: <%= item.quantity %> &times; &pound;<%= Number(item.price || 0).toFixed(2) %></span></div>
            <strong class="t-amt">&pound;<%= Number((item.quantity || 0) * (item.price || 0)).toFixed(2) %></strong>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="dg2">
      <div class="sec">
        <div class="sec-head"><h2>Totals</h2></div>
        <div class="sec-body">
          <div class="checkout-total-row" style="display:flex;justify-content:space-between;padding:6px 0;font-size:12px;"><span>Subtotal</span><strong>&pound;<%= Number(order.subtotal || 0).toFixed(2) %></strong></div>
          <div style="display:flex;justify-content:space-between;padding:6px 0;font-size:12px;"><span>Shipping</span><strong><%= Number(order.shipping || 0) === 0 ? "Free" : "£" + Number(order.shipping || 0).toFixed(2) %></strong></div>
          <% if (discountAmount > 0) { %><div style="display:flex;justify-content:space-between;padding:6px 0;font-size:12px;color:var(--grn);"><span>Discount <%= order.discount?.code ? "(" + order.discount.code + ")" : "" %></span><strong>-&pound;<%= discountAmount.toFixed(2) %></strong></div><% } %>
          <div style="display:flex;justify-content:space-between;padding:10px 0 0;margin-top:6px;border-top:1px solid var(--bdr);font-size:14px;font-weight:800;"><span>Total</span><strong>&pound;<%= Number(order.total || 0).toFixed(2) %></strong></div>
        </div>
      </div>

      <div class="sec">
        <div class="sec-head"><h2>Discount</h2></div>
        <div class="sec-body">
          <% if (order.discount?.code) { %>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <div><div class="stat-lbl">Code</div><strong><%= order.discount.code %></strong></div>
              <div><div class="stat-lbl">Type</div><strong><%= order.discount.type || "N/A" %></strong></div>
              <div><div class="stat-lbl">Value</div><strong><% if (order.discount.type === "percentage") { %><%= Number(order.discount.value || 0).toFixed(0) %>%<% } else { %>&pound;<%= Number(order.discount.value || 0).toFixed(2) %><% } %></strong></div>
              <div><div class="stat-lbl">Saved</div><strong>&pound;<%= discountAmount.toFixed(2) %></strong></div>
            </div>
          <% } else { %>
            <p style="color:var(--mu);font-size:12px;">No discount code used on this order.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="sec">
      <div class="sec-head"><h2>Royal Mail</h2></div>
      <div class="sec-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
          <div><div class="stat-lbl">Status</div><span class="pill p-<%= order.royalMail?.syncStatus || 'not_sent' %>"><%= order.royalMail?.syncStatus || "not_sent" %></span></div>
          <div><div class="stat-lbl">Order Identifier</div><strong><%= order.royalMail?.orderIdentifier || "N/A" %></strong></div>
          <div><div class="stat-lbl">Reference</div><strong><%= order.royalMail?.orderReference || "N/A" %></strong></div>
          <div><div class="stat-lbl">Tracking</div><strong><%= order.royalMail?.trackingNumber || "N/A" %></strong></div>
          <% if (order.royalMail?.syncError) { %><div style="grid-column:1/-1;"><div class="stat-lbl">Error</div><strong style="color:#dc2626;"><%= order.royalMail.syncError %></strong></div><% } %>
        </div>
        <div class="t-actions">
          <% if (!isClickCollect && order.royalMail?.syncStatus !== "sent") { %>
            <form action="/admin/orders/<%= order._id %>/send-royal-mail" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-blue">Send To Royal Mail</button></form>
          <% } %>
          <% if (!isClickCollect && order.royalMail?.syncStatus === "sent" && !order.royalMail?.labelGenerated) { %>
            <form action="/admin/orders/<%= order._id %>/generate-label" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-ghost">Generate Label</button></form>
          <% } %>
          <% if (order.royalMail?.labelGenerated) { %><a class="btn btn-sm btn-ghost" href="/admin/orders/<%= order._id %>/download-label" data-no-spa>Download Label</a><% } %>
        </div>
      </div>
    </div>

    <div class="sec">
      <div class="sec-head"><h2>Internal Admin Notes</h2></div>
      <form class="sec-body" action="/admin/orders/<%= order._id %>/admin-update" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px;font-size:12px;">
          <label style="display:flex;align-items:center;gap:6px;font-weight:600;"><input type="checkbox" name="paymentChecked" style="width:auto;min-height:0;" <%= checklist.paymentChecked ? "checked" : "" %>> Payment Checked</label>
          <label style="display:flex;align-items:center;gap:6px;font-weight:600;"><input type="checkbox" name="stockChecked" style="width:auto;min-height:0;" <%= checklist.stockChecked ? "checked" : "" %>> Stock Checked</label>
          <label style="display:flex;align-items:center;gap:6px;font-weight:600;"><input type="checkbox" name="packed" style="width:auto;min-height:0;" <%= checklist.packed ? "checked" : "" %>> Packed</label>
          <label style="display:flex;align-items:center;gap:6px;font-weight:600;"><input type="checkbox" name="labelReady" style="width:auto;min-height:0;" <%= checklist.labelReady ? "checked" : "" %>> Label Ready</label>
          <label style="display:flex;align-items:center;gap:6px;font-weight:600;"><input type="checkbox" name="customerNotified" style="width:auto;min-height:0;" <%= checklist.customerNotified ? "checked" : "" %>> Customer Notified</label>
        </div>
        <div class="fld"><label>Notes</label><textarea name="adminNotes" rows="3" placeholder="Add internal order notes here..."><%= order.adminNotes || "" %></textarea></div>
        <button type="submit" class="btn btn-red">Save Internal Notes</button>
      </form>
    </div>
  </div>

  <div>
    <div class="sec">
      <div class="sec-head"><h2>Status Update</h2></div>
      <form class="sec-body" action="/admin/orders/<%= order._id %>/status" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="fld"><label>Payment</label>
          <select name="paymentStatus">
            <option value="pending" <%= order.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
            <option value="paid" <%= order.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
            <option value="failed" <%= order.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
          </select>
        </div>
        <div class="fld"><label>Order</label>
          <select name="orderStatus">
            <option value="new" <%= order.orderStatus === "new" ? "selected" : "" %>>New</option>
            <option value="processing" <%= order.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
            <option value="packed" <%= order.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
            <option value="shipped" <%= order.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
            <option value="completed" <%= order.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
            <option value="cancelled" <%= order.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
          </select>
        </div>
        <button type="submit" class="btn btn-red" style="width:100%;justify-content:center;">Update Status</button>
      </form>
    </div>

    <div class="sec">
      <div class="sec-head"><h2>SumUp Payment</h2></div>
      <div class="sec-body" style="display:grid;gap:10px;">
        <div><div class="stat-lbl">Checkout ID</div><strong style="font-size:11px;word-break:break-all;"><%= order.sumup?.checkoutId || "N/A" %></strong></div>
        <div><div class="stat-lbl">Reference</div><strong style="font-size:11px;"><%= order.sumup?.checkoutReference || "N/A" %></strong></div>
        <div><div class="stat-lbl">Status</div><strong><%= order.sumup?.status || "N/A" %></strong></div>
        <div><div class="stat-lbl">Paid At</div><strong style="font-size:11px;"><%= paidAt %></strong></div>
        <% if (order.sumup?.error) { %><div><div class="stat-lbl">Error</div><strong style="color:#dc2626;font-size:11px;"><%= order.sumup.error %></strong></div><% } %>
        <% if (order.sumup?.refunded) { %>
          <div><div class="stat-lbl">Refunded At</div><strong style="font-size:11px;"><%= new Date(order.sumup.refundedAt).toLocaleString("en-GB") %></strong></div>
          <div><div class="stat-lbl">Refund Amount</div><strong>&pound;<%= Number(order.sumup.refundAmount || 0).toFixed(2) %></strong></div>
          <div><div class="stat-lbl">Refund Transaction</div><strong style="font-size:11px;"><%= order.sumup.refundTransactionId || "N/A" %></strong></div>
          <% if (order.sumup.refundedBy) { %><div><div class="stat-lbl">Refunded By</div><strong style="font-size:11px;"><%= order.sumup.refundedBy %></strong></div><% } %>
        <% } %>
        <% if (order.sumup?.refundError && !order.sumup?.refunded) { %><div><div class="stat-lbl">Last Refund Attempt</div><strong style="color:#dc2626;font-size:11px;"><%= order.sumup.refundError %></strong></div><% } %>
      </div>
      <% if (order.paymentStatus === "paid" && !order.sumup?.refunded) { %>
        <div class="sec-body" style="padding-top:0;">
          <form action="/admin/orders/<%= order._id %>/cancel-refund" method="POST" onsubmit="return confirm('Cancel this order and refund £<%= Number(order.total || 0).toFixed(2) %> to the customer via SumUp? This cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger" style="width:100%;justify-content:center;"><i class="fa-solid fa-rotate-left"></i> Cancel &amp; Refund</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
