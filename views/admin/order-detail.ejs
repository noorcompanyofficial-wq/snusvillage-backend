<%
  const shortId = order._id.toString().slice(-6).toUpperCase();
  const isClickCollect = order.fulfilment?.method === "click_collect";
  const checklist = order.fulfilmentChecklist || {};
  const discountAmount = Number(order.discount?.amount || 0);
  const paidAt = order.sumup?.paidAt ? new Date(order.sumup.paidAt).toLocaleString("en-GB") : "Not paid yet";
%>

<section class="admin-page admin-order-detail-page">
  <div class="admin-page-head">
    <div>
      <span>Order Detail</span>
      <h1>Order #<%= shortId %></h1>
      <p>Customer, payment, discount, fulfilment, Royal Mail, and internal admin notes.</p>
    </div>

    <div class="admin-head-actions">
      <a href="/admin/orders/export/csv" class="admin-secondary">
        <i class="fa-solid fa-file-export"></i>
        Export CSV
      </a>
      <a href="/admin/orders" class="admin-primary">
        <i class="fa-solid fa-arrow-left"></i>
        Back To Orders
      </a>
    </div>
  </div>

  <div class="admin-order-overview-grid">
    <div class="admin-analytics-card admin-analytics-card--dark">
      <i class="fa-solid fa-sterling-sign"></i>
      <span>Total</span>
      <strong>£<%= Number(order.total || 0).toFixed(2) %></strong>
      <small>Final customer payment amount</small>
    </div>

    <div class="admin-analytics-card">
      <i class="fa-solid fa-credit-card"></i>
      <span>Payment</span>
      <strong><%= order.paymentStatus || "pending" %></strong>
      <small>SumUp: <%= order.sumup?.status || "Not started" %></small>
    </div>

    <div class="admin-analytics-card">
      <i class="fa-solid fa-box"></i>
      <span>Order Status</span>
      <strong><%= order.orderStatus || "new" %></strong>
      <small>Created <%= new Date(order.createdAt).toLocaleString("en-GB") %></small>
    </div>

    <div class="admin-analytics-card">
      <i class="fa-solid <%= isClickCollect ? 'fa-store' : 'fa-truck' %>"></i>
      <span>Fulfilment</span>
      <strong><%= isClickCollect ? "Click & Collect" : "Delivery" %></strong>
      <small><%= order.fulfilment?.deliveryServiceLabel || (isClickCollect ? (order.fulfilment?.collectionBranch || "Collection") : "Royal Mail / Delivery") %></small>
    </div>
  </div>

  <div class="admin-order-detail-grid">
    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>Customer</h2>
        <% if (order.user) { %>
          <a href="/admin/users/<%= order.user %>">View Customer</a>
        <% } %>
      </div>

      <div class="admin-detail-list">
        <div>
          <span>Name</span>
          <strong><%= [order.customer?.firstName, order.customer?.lastName].filter(Boolean).join(" ") || "No name" %></strong>
        </div>

        <div>
          <span>Email</span>
          <strong><%= order.customer?.email || "No email" %></strong>
        </div>

        <div>
          <span>Phone</span>
          <strong><%= order.customer?.phone || "No phone" %></strong>
        </div>

        <div>
          <span>Order ID</span>
          <strong><%= order._id %></strong>
        </div>
      </div>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2><%= isClickCollect ? "Collection" : "Delivery" %></h2>
      </div>

      <div class="admin-detail-list">
        <div>
          <span>Method</span>
          <strong><%= order.fulfilment?.deliveryServiceLabel || (isClickCollect ? "Click & Collect" : "Delivery") %></strong>
        </div>

        <% if (!isClickCollect && order.fulfilment?.deliveryService === "next_day") { %>
          <div>
            <span>Cut-Off</span>
            <strong>Order before <%= order.fulfilment?.deliveryCutoff || "4:30pm" %></strong>
          </div>
        <% } %>

        <% if (!isClickCollect) { %>
          <div>
            <span>Courier</span>
            <strong>Royal Mail</strong>
          </div>
        <% } %>

        <div>
          <span>Delivery Charge</span>
          <strong><%= Number(order.shipping || 0) === 0 ? "Free" : "£" + Number(order.shipping || 0).toFixed(2) %></strong>
        </div>

        <div>
          <span>Address</span>
          <strong><%= order.delivery?.address || "No address" %></strong>
        </div>

        <div>
          <span>City</span>
          <strong><%= order.delivery?.city || "No city" %></strong>
        </div>

        <div>
          <span>Postcode</span>
          <strong><%= order.delivery?.postcode || "No postcode" %></strong>
        </div>

        <% if (isClickCollect) { %>
          <div>
            <span>Collection Branch</span>
            <strong><%= order.fulfilment?.collectionBranch || "N/A" %></strong>
          </div>
        <% } %>
      </div>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>Status Update</h2>
      </div>

      <div class="admin-status-stack">
        <p>
          <strong>Payment</strong>
          <span class="status-pill payment-<%= order.paymentStatus %>"><%= order.paymentStatus || "pending" %></span>
        </p>

        <p>
          <strong>Order</strong>
          <span class="status-pill order-<%= order.orderStatus %>"><%= order.orderStatus || "new" %></span>
        </p>
      </div>

      <form class="admin-order-status-form" action="/admin/orders/<%= order._id %>/status" method="POST">
        <label>
          Payment
          <select name="paymentStatus">
            <option value="pending" <%= order.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
            <option value="paid" <%= order.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
            <option value="failed" <%= order.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
          </select>
        </label>

        <label>
          Order
          <select name="orderStatus">
            <option value="new" <%= order.orderStatus === "new" ? "selected" : "" %>>New</option>
            <option value="processing" <%= order.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
            <option value="packed" <%= order.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
            <option value="shipped" <%= order.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
            <option value="completed" <%= order.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
            <option value="cancelled" <%= order.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
          </select>
        </label>

        <button type="submit">Update Status</button>
      </form>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>SumUp Payment</h2>
      </div>

      <div class="admin-detail-list">
        <div>
          <span>Checkout ID</span>
          <strong><%= order.sumup?.checkoutId || "N/A" %></strong>
        </div>

        <div>
          <span>Reference</span>
          <strong><%= order.sumup?.checkoutReference || "N/A" %></strong>
        </div>

        <div>
          <span>Status</span>
          <strong><%= order.sumup?.status || "N/A" %></strong>
        </div>

        <div>
          <span>Paid At</span>
          <strong><%= paidAt %></strong>
        </div>

        <% if (order.sumup?.error) { %>
          <div>
            <span>Error</span>
            <strong><%= order.sumup.error %></strong>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <section class="admin-detail-card admin-items-card">
    <div class="admin-panel__head">
      <h2>Items</h2>
      <span><%= order.items?.length || 0 %> Item<%= order.items?.length === 1 ? "" : "s" %></span>
    </div>

    <% (order.items || []).forEach(item => { %>
      <div class="admin-detail-item">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.name %>">
        <% } %>

        <div>
          <strong><%= item.name %></strong>
          <span><%= item.brand || "Snus Village" %></span>
          <small>Qty: <%= item.quantity %> × £<%= Number(item.price || 0).toFixed(2) %></small>
        </div>

        <strong>£<%= Number((item.quantity || 0) * (item.price || 0)).toFixed(2) %></strong>
      </div>
    <% }) %>
  </section>

  <div class="admin-order-detail-grid">
    <section class="admin-detail-card admin-total-card">
      <div class="admin-panel__head">
        <h2>Totals</h2>
      </div>

      <p>
        <strong>Subtotal</strong>
        <span>£<%= Number(order.subtotal || 0).toFixed(2) %></span>
      </p>

      <p>
        <strong>Shipping</strong>
        <span><%= Number(order.shipping || 0) === 0 ? "Free" : "£" + Number(order.shipping || 0).toFixed(2) %></span>
      </p>

      <% if (discountAmount > 0) { %>
        <p class="admin-discount-line">
          <strong>Discount <%= order.discount?.code ? "(" + order.discount.code + ")" : "" %></strong>
          <span>-£<%= discountAmount.toFixed(2) %></span>
        </p>
      <% } %>

      <p class="admin-grand-total">
        <strong>Total</strong>
        <span>£<%= Number(order.total || 0).toFixed(2) %></span>
      </p>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>Discount</h2>
      </div>

      <% if (order.discount?.code) { %>
        <div class="admin-detail-list">
          <div>
            <span>Code</span>
            <strong><%= order.discount.code %></strong>
          </div>

          <div>
            <span>Type</span>
            <strong><%= order.discount.type || "N/A" %></strong>
          </div>

          <div>
            <span>Value</span>
            <strong>
              <% if (order.discount.type === "percentage") { %>
                <%= Number(order.discount.value || 0).toFixed(0) %>%
              <% } else { %>
                £<%= Number(order.discount.value || 0).toFixed(2) %>
              <% } %>
            </strong>
          </div>

          <div>
            <span>Saved</span>
            <strong>£<%= discountAmount.toFixed(2) %></strong>
          </div>
        </div>
      <% } else { %>
        <div class="admin-empty-small">
          <p>No discount code used on this order.</p>
        </div>
      <% } %>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>Royal Mail</h2>
      </div>

      <div class="admin-detail-list">
        <div>
          <span>Status</span>
          <strong><%= order.royalMail?.syncStatus || "not_sent" %></strong>
        </div>

        <div>
          <span>Order Identifier</span>
          <strong><%= order.royalMail?.orderIdentifier || "N/A" %></strong>
        </div>

        <div>
          <span>Reference</span>
          <strong><%= order.royalMail?.orderReference || "N/A" %></strong>
        </div>

        <div>
          <span>Tracking</span>
          <strong><%= order.royalMail?.trackingNumber || "N/A" %></strong>
        </div>

        <% if (order.royalMail?.syncError) { %>
          <div>
            <span>Error</span>
            <strong><%= order.royalMail.syncError %></strong>
          </div>
        <% } %>
      </div>

      <div class="admin-order-action-row">
        <% if (!isClickCollect && order.royalMail?.syncStatus !== "sent") { %>
          <form action="/admin/orders/<%= order._id %>/send-royal-mail" method="POST">
            <button type="submit">Send To Royal Mail</button>
          </form>
        <% } %>

        <% if (!isClickCollect && order.royalMail?.syncStatus === "sent" && !order.royalMail?.labelGenerated) { %>
          <form action="/admin/orders/<%= order._id %>/generate-label" method="POST">
            <button type="submit">Generate Label</button>
          </form>
        <% } %>

        <% if (order.royalMail?.labelGenerated) { %>
          <a href="/admin/orders/<%= order._id %>/download-label">Download Label</a>
        <% } %>
      </div>
    </section>

    <section class="admin-detail-card">
      <div class="admin-panel__head">
        <h2>Internal Admin Notes</h2>
      </div>

      <form class="admin-order-admin-form" action="/admin/orders/<%= order._id %>/admin-update" method="POST">
        <div class="admin-checklist-grid">
          <label><input type="checkbox" name="paymentChecked" <%= checklist.paymentChecked ? "checked" : "" %>> Payment Checked</label>
          <label><input type="checkbox" name="stockChecked" <%= checklist.stockChecked ? "checked" : "" %>> Stock Checked</label>
          <label><input type="checkbox" name="packed" <%= checklist.packed ? "checked" : "" %>> Packed</label>
          <label><input type="checkbox" name="labelReady" <%= checklist.labelReady ? "checked" : "" %>> Label Ready</label>
          <label><input type="checkbox" name="customerNotified" <%= checklist.customerNotified ? "checked" : "" %>> Customer Notified</label>
        </div>

        <label class="admin-note-label">
          Notes
          <textarea name="adminNotes" placeholder="Add internal order notes here..."><%= order.adminNotes || "" %></textarea>
        </label>

        <button type="submit">Save Internal Notes</button>
      </form>
    </section>
  </div>
</section>
