<section class="admin-order-detail-page">
  <div class="admin-page-header">
    <div>
      <span class="eyebrow">ORDER DETAIL</span>
      <h1>Order #<%= order._id.toString().slice(-6).toUpperCase() %></h1>
      <p>Customer, delivery, products, payment status and fulfilment details.</p>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/admin/orders/export/csv" class="admin-back-link">Export CSV</a>
      <a href="/admin/orders" class="admin-back-link">Back to Orders</a>
    </div>
  </div>

  <div class="admin-detail-card" style="margin-bottom: 18px;">
    <h2>Manual Fulfilment Steps</h2>

    <p>
      <strong>Step 1</strong>
      <span>Check payment and order details before sending.</span>
    </p>

    <p>
      <strong>Step 2</strong>
      <span>Export CSV or copy the delivery details into Royal Mail Click & Drop.</span>
    </p>

    <p>
      <strong>Step 3</strong>
      <span>Update the order status to Packed, Shipped, then Completed.</span>
    </p>
  </div>

  <div class="admin-order-detail-grid">
    <div class="admin-detail-card">
      <h2>Customer</h2>

      <p>
        <strong>Name</strong>
        <span><%= order.customer?.firstName || "" %> <%= order.customer?.lastName || "" %></span>
      </p>

      <p>
        <strong>Email</strong>
        <span><%= order.customer?.email || "No email" %></span>
      </p>

      <p>
        <strong>Phone</strong>
        <span><%= order.customer?.phone || "No phone" %></span>
      </p>
    </div>

    <div class="admin-detail-card">
      <h2>Delivery</h2>

      <p>
        <strong>Address</strong>
        <span><%= order.delivery?.address || "No address" %></span>
      </p>

      <p>
        <strong>City</strong>
        <span><%= order.delivery?.city || "No city" %></span>
      </p>

      <p>
        <strong>Postcode</strong>
        <span><%= order.delivery?.postcode || "No postcode" %></span>
      </p>

      <p>
        <strong>Country</strong>
        <span><%= order.delivery?.country || "United Kingdom" %></span>
      </p>
    </div>

    <div class="admin-detail-card">
      <h2>Status</h2>

      <p>
        <strong>Payment</strong>
        <span class="status-pill payment-<%= order.paymentStatus %>"><%= order.paymentStatus %></span>
      </p>

      <p>
        <strong>Order</strong>
        <span class="status-pill order-<%= order.orderStatus %>"><%= order.orderStatus %></span>
      </p>

      <p>
        <strong>Created</strong>
        <span><%= new Date(order.createdAt).toLocaleString("en-GB") %></span>
      </p>

      <form class="admin-order-status-form" action="/admin/orders/<%= order._id %>/status" method="POST" style="margin-top: 16px;">
        <label>
          Payment
          <select name="paymentStatus">
            <option value="pending" <%= order.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
            <option value="paid" <%= order.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
            <option value="failed" <%= order.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
          </select>
        </label>

        <label>
          Order
          <select name="orderStatus">
            <option value="new" <%= order.orderStatus === "new" ? "selected" : "" %>>New</option>
            <option value="processing" <%= order.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
            <option value="packed" <%= order.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
            <option value="shipped" <%= order.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
            <option value="completed" <%= order.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
            <option value="cancelled" <%= order.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
          </select>
        </label>

        <button type="submit">Update Status</button>
      </form>
    </div>

    <div class="admin-detail-card">
      <h2>Royal Mail / Fulfilment</h2>

      <% if (order.royalMail && order.royalMail.syncStatus === "sent") { %>
        <p>
          <strong>Status</strong>
          <span class="status-pill order-completed">Sent</span>
        </p>

        <p>
          <strong>Royal Mail ID</strong>
          <span><%= order.royalMail.orderIdentifier || "N/A" %></span>
        </p>

        <p>
          <strong>Reference</strong>
          <span><%= order.royalMail.orderReference || "N/A" %></span>
        </p>

        <p>
          <strong>Label</strong>
          <span>Create in Click & Drop manually if label is not already generated.</span>
        </p>
      <% } else if (order.royalMail && order.royalMail.syncStatus === "failed") { %>
        <p>
          <strong>Status</strong>
          <span class="status-pill payment-failed">Manual required</span>
        </p>

        <p>
          <strong>Note</strong>
          <span>Create this shipment manually in Royal Mail Click & Drop.</span>
        </p>
      <% } else { %>
        <p>
          <strong>Status</strong>
          <span class="status-pill payment-pending">Manual</span>
        </p>

        <p>
          <strong>Next step</strong>
          <span>Use Export CSV or copy the customer delivery details into Royal Mail Click & Drop.</span>
        </p>
      <% } %>
    </div>
  </div>

  <div class="admin-detail-card admin-items-card">
    <h2>Items</h2>

    <% order.items.forEach(item => { %>
      <div class="admin-detail-item">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.name %>">
        <% } %>

        <div>
          <strong><%= item.name %></strong>
          <span><%= item.brand || "Snus Village" %></span>
          <small>Qty: <%= item.quantity %> × £<%= item.price.toFixed(2) %></small>
        </div>

        <strong>£<%= (item.quantity * item.price).toFixed(2) %></strong>
      </div>
    <% }) %>
  </div>

  <div class="admin-detail-card admin-total-card">
    <h2>Totals</h2>

    <p>
      <strong>Subtotal</strong>
      <span>£<%= order.subtotal.toFixed(2) %></span>
    </p>

    <p>
      <strong>Shipping</strong>
      <span>£<%= order.shipping.toFixed(2) %></span>
    </p>

    <p class="admin-grand-total">
      <strong>Total</strong>
      <span>£<%= order.total.toFixed(2) %></span>
    </p>
  </div>
</section>
