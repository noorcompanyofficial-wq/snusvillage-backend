<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Commerce</div>
    <h1>Stock Control</h1>
    <p>Track low stock, out of stock products, total units, estimated stock value, and quick stock updates.</p>
  </div>
  <div class="ph-right"><a class="btn btn-red" href="/admin/products/add"><i class="fa-solid fa-plus"></i> Add Product</a></div>
</div>

<div class="stats">
  <a class="stat stat-blue" href="/admin/inventory"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-boxes-stacked"></i></div></div><div class="stat-lbl">Total Products</div><div class="stat-val"><%= stats.totalProducts || 0 %></div></a>
  <a class="stat stat-grn" href="/admin/inventory?stock=in"><div class="stat-top"><div class="stat-icon si-g"><i class="fa-solid fa-cubes"></i></div></div><div class="stat-lbl">Total Units</div><div class="stat-val"><%= stats.totalStockUnits || 0 %></div></a>
  <a class="stat stat-amb" href="/admin/inventory?stock=low"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-arrow-trend-down"></i></div></div><div class="stat-lbl">Low Stock</div><div class="stat-val"><%= stats.lowStockProducts || 0 %></div></a>
  <a class="stat stat-red" href="/admin/inventory?stock=out"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-circle-xmark"></i></div></div><div class="stat-lbl">Out Of Stock</div><div class="stat-val"><%= stats.outStockProducts || 0 %></div></a>
  <a class="stat stat-blue" href="/admin/inventory"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-sterling-sign"></i></div></div><div class="stat-lbl">Stock Value</div><div class="stat-val" style="font-size:19px;">&pound;<%= Number(stats.estimatedStockValue || 0).toFixed(2) %></div></a>
</div>

<div class="sec">
  <div class="sec-head"><h2>Inventory Filters</h2><a href="/admin/inventory" class="btn btn-sm btn-ghost">Reset</a></div>
  <form class="sec-body" style="display:flex;gap:12px;align-items:end;flex-wrap:wrap;" method="GET" action="/admin/inventory">
    <div class="fld" style="margin-bottom:0;"><label>Stock Status</label>
      <select name="stock">
        <option value="all" <%= !query.stock || query.stock === "all" ? "selected" : "" %>>All Stock</option>
        <option value="in" <%= query.stock === "in" ? "selected" : "" %>>In Stock</option>
        <option value="low" <%= query.stock === "low" ? "selected" : "" %>>Low Stock</option>
        <option value="out" <%= query.stock === "out" ? "selected" : "" %>>Out Of Stock</option>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Brand</label>
      <select name="brand">
        <option value="">All Brands</option>
        <% brands.forEach((brand) => { %><option value="<%= brand %>" <%= query.brand === brand ? "selected" : "" %>><%= brand %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-red">Apply Filters</button>
  </form>
</div>

<div class="sec">
  <div class="sec-head">
    <h2>Stock List</h2>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:11px;color:var(--mu);"><%= products.length %> product<%= products.length === 1 ? "" : "s" %></span>
      <% if (products.length) { %><button type="submit" form="bulkStockForm" class="btn btn-sm btn-red"><i class="fa-solid fa-floppy-disk"></i> Save All</button><% } %>
    </div>
  </div>

  <% if (!products.length) { %>
    <div class="admin-empty-state"><h2>No Products Found</h2><p>Try another stock filter or add products first.</p></div>
  <% } else { %>
    <form id="bulkStockForm" action="/admin/inventory/bulk-stock" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="toolbar admin-inventory-bulk-actions">
        <strong style="font-size:12px;"><span id="inventorySelectedCount">0</span> selected</strong>
        <button type="button" id="inventoryClearSelection" class="btn btn-sm btn-ghost">Clear</button>
        <div class="fld" style="margin:0;"><input type="number" name="bulkStockValue" min="0" inputmode="numeric" placeholder="Quantity" style="height:32px;"></div>
        <button type="submit" name="bulkAction" value="set_stock" class="btn btn-sm btn-blue" disabled><i class="fa-solid fa-layer-group"></i> Apply Quantity</button>
        <button type="submit" name="bulkAction" value="out_of_stock" class="btn btn-sm btn-danger admin-bulk-button--danger" disabled><i class="fa-solid fa-box-open"></i> Mark Out Of Stock</button>
      </div>

      <div class="tbl-wrap">
        <table>
          <thead><tr>
            <th><input type="checkbox" id="inventorySelectAll" aria-label="Select all visible products"></th>
            <th>Product</th><th>Brand</th><th>SKU</th><th>Strength</th><th>Cost</th><th>Price</th><th>Stock</th><th>Status</th><th>New Stock</th>
          </tr></thead>
          <tbody>
            <% products.forEach((product) => {
              const productPrice = product.discountPrice && product.discountPrice > 0 ? product.discountPrice : product.price;
            %>
              <tr>
                <td><input type="checkbox" name="selectedProducts" value="<%= product._id %>" class="inventory-product-checkbox" aria-label="Select <%= product.name %>"></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <% if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="" style="width:32px;height:32px;object-fit:contain;flex-shrink:0;"><% } %>
                    <div><span class="t-name"><%= product.name %></span><span class="t-sub"><%= product.flavour || product.category || "" %></span></div>
                  </div>
                </td>
                <td class="t-sub"><%= product.brand || "N/A" %></td>
                <td class="t-sub"><%= product.sku || "N/A" %></td>
                <td class="t-sub"><%= product.strength || "N/A" %></td>
                <td>&pound;<%= Number(product.costPrice || 0).toFixed(2) %></td>
                <td>&pound;<%= Number(productPrice || 0).toFixed(2) %></td>
                <td><strong><%= product.stock || 0 %></strong></td>
                <td>
                  <% if (product.stock <= 0) { %><span class="pill p-failed">Out</span>
                  <% } else if (product.stock <= 5) { %><span class="pill p-pending">Low</span>
                  <% } else { %><span class="pill p-completed">In Stock</span><% } %>
                </td>
                <td><input class="inv-inp" type="number" name="updates[<%= product._id %>]" min="0" value="<%= product.stock || 0 %>"></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div style="display:flex;justify-content:flex-end;padding:16px;">
        <button type="submit" class="btn btn-red"><i class="fa-solid fa-floppy-disk"></i> Save All Changes</button>
      </div>
    </form>
  <% } %>
</div>
