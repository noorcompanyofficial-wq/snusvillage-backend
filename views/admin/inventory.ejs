<section class="admin-page admin-inventory-page">
  <div class="admin-page-head">
    <div>
      <span>Inventory</span>
      <h1>Stock Control</h1>
      <p>Track low stock, out of stock products, total units, estimated stock value, and quick stock updates.</p>
    </div>

    <a class="admin-primary" href="/admin/products/add">
      <i class="fa-solid fa-plus"></i>
      Add Product
    </a>
  </div>

  <div class="admin-analytics-grid admin-inventory-stats">
    <a class="admin-analytics-card admin-analytics-card--dark" href="/admin/inventory">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Total Products</span>
      <strong><%= stats.totalProducts || 0 %></strong>
      <small>Products In Catalogue</small>
    </a>

    <a class="admin-analytics-card" href="/admin/inventory?stock=in">
      <i class="fa-solid fa-cubes"></i>
      <span>Total Units</span>
      <strong><%= stats.totalStockUnits || 0 %></strong>
      <small>All Stock Units Combined</small>
    </a>

    <a class="admin-analytics-card admin-analytics-card--warning" href="/admin/inventory?stock=low">
      <i class="fa-solid fa-arrow-trend-down"></i>
      <span>Low Stock</span>
      <strong><%= stats.lowStockProducts || 0 %></strong>
      <small>5 Or Less Remaining</small>
    </a>

    <a class="admin-analytics-card" href="/admin/inventory?stock=out">
      <i class="fa-solid fa-circle-xmark"></i>
      <span>Out Of Stock</span>
      <strong><%= stats.outStockProducts || 0 %></strong>
      <small>Needs Restock</small>
    </a>

    <a class="admin-analytics-card" href="/admin/inventory">
      <i class="fa-solid fa-sterling-sign"></i>
      <span>Stock Value</span>
      <strong>£<%= Number(stats.estimatedStockValue || 0).toFixed(2) %></strong>
      <small>Estimated Retail Value</small>
    </a>
  </div>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <h2>Inventory Filters</h2>
      <a href="/admin/inventory">Reset</a>
    </div>

    <form class="admin-inventory-filters" method="GET" action="/admin/inventory">
      <label>
        Stock Status
        <select name="stock">
          <option value="all" <%= !query.stock || query.stock === "all" ? "selected" : "" %>>All Stock</option>
          <option value="in" <%= query.stock === "in" ? "selected" : "" %>>In Stock</option>
          <option value="low" <%= query.stock === "low" ? "selected" : "" %>>Low Stock</option>
          <option value="out" <%= query.stock === "out" ? "selected" : "" %>>Out Of Stock</option>
        </select>
      </label>

      <label>
        Brand
        <select name="brand">
          <option value="">All Brands</option>
          <% brands.forEach((brand) => { %>
            <option value="<%= brand %>" <%= query.brand === brand ? "selected" : "" %>><%= brand %></option>
          <% }) %>
        </select>
      </label>

      <button type="submit">Apply Filters</button>
    </form>
  </section>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <h2>Stock List</h2>
      <span><%= products.length %> Product<%= products.length === 1 ? "" : "s" %></span>
    </div>

    <% if (!products.length) { %>
      <div class="admin-empty-state">
        <h2>No Products Found</h2>
        <p>Try another stock filter or add products first.</p>
      </div>
    <% } else { %>
      <div class="admin-inventory-table-wrap">
        <table class="admin-inventory-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Brand</th>
              <th>SKU</th>
              <th>Supplier</th>
              <th>Strength</th>
              <th>Cost</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Reorder Value</th>
              <th>Status</th>
              <th>Quick Update</th>
            </tr>
          </thead>

          <tbody>
            <% products.forEach((product) => { %>
              <% const productPrice = product.discountPrice && product.discountPrice > 0 ? product.discountPrice : product.price; %>
              <tr>
                <td>
                  <div class="admin-inventory-product">
                    <% if (product.images && product.images[0]) { %>
                      <img src="<%= product.images[0] %>" alt="<%= product.name %>">
                    <% } else { %>
                      <span>No Image</span>
                    <% } %>

                    <div>
                      <strong><%= product.name %></strong>
                      <small><%= product.flavour || product.category || "No Flavour" %></small>
                    </div>
                  </div>
                </td>

                <td><%= product.brand || "N/A" %></td>

                <td>
                  <strong><%= product.sku || "N/A" %></strong>
                  <% if (product.barcode) { %>
                    <small style="display:block;color:#64748b;margin-top:4px;"><%= product.barcode %></small>
                  <% } %>
                </td>

                <td>
                  <strong><%= product.supplier || "N/A" %></strong>
                  <% if (product.supplierCode) { %>
                    <small style="display:block;color:#64748b;margin-top:4px;"><%= product.supplierCode %></small>
                  <% } %>
                </td>

                <td><%= product.strength || "N/A" %></td>
                <td>£<%= Number(product.costPrice || 0).toFixed(2) %></td>
                <td>£<%= Number(productPrice || 0).toFixed(2) %></td>

                <td>
                  <strong><%= product.stock || 0 %></strong>
                </td>

                <td>
                  <strong>£<%= Number((product.costPrice || 0) * Math.max(0, 10 - (product.stock || 0))).toFixed(2) %></strong>
                  <small style="display:block;color:#64748b;margin-top:4px;">To reach 10 units</small>
                </td>

                <td>
                  <% if (product.stock <= 0) { %>
                    <span class="status-pill payment-failed">Out</span>
                  <% } else if (product.stock <= 5) { %>
                    <span class="status-pill payment-pending">Low</span>
                  <% } else { %>
                    <span class="status-pill order-completed">In Stock</span>
                  <% } %>
                </td>

                <td>
                  <form class="admin-stock-form" action="/admin/inventory/<%= product._id %>/stock" method="POST">
                    <input type="number" name="stock" min="0" value="<%= product.stock || 0 %>">
                    <button type="submit">Update</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</section>
