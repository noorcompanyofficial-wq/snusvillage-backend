<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Customers</div>
    <h1>Wholesale Applications</h1>
    <p>Review trader requests before enabling wholesale access.</p>
  </div>
</div>

<% if (!applications || applications.length === 0) { %>
  <div class="sec"><div class="admin-empty-state"><h2>No Applications Yet</h2><p>Wholesale applications will appear here once submitted.</p></div></div>
<% } else { %>
  <% applications.forEach((application) => { %>
    <div class="ws-card <%= application.status === 'pending' ? 'ws-pend' : application.status === 'rejected' ? 'ws-rej' : 'ws-appr' %>">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
            <span class="pill <%= application.status === 'pending' ? 'p-pending' : application.status === 'rejected' ? 'p-rejected' : 'p-approved' %>"><%= application.status %></span>
            <span style="font-size:10px;color:var(--mu);">Submitted <%= application.createdAt ? new Date(application.createdAt).toLocaleDateString("en-GB") : "" %></span>
          </div>
          <div style="font-family:var(--fh);font-size:16px;font-weight:800;margin-bottom:4px;">
            <%= application.businessName %>
            <% if (application.website) { %> &middot; <a href="<%= application.website %>" target="_blank" style="color:var(--blue);font-size:11px;font-weight:600;"><%= application.website %></a><% } %>
          </div>
          <div style="font-size:12px;color:var(--mu);margin-bottom:3px;"><%= application.contactName %> &middot; <%= application.email %> &middot; <%= application.phone %></div>
          <div style="font-size:12px;color:var(--mu);margin-bottom:8px;"><%= application.businessType %><% if (application.companyNumber) { %> &middot; Company no: <%= application.companyNumber %><% } %></div>
          <% if (application.message) { %><div style="font-size:12px;background:var(--bg);border-radius:7px;padding:10px 12px;">"<%= application.message %>"</div><% } %>
        </div>
        <div style="display:flex;flex-direction:column;gap:7px;flex-shrink:0;">
          <% if (application.status !== "approved") { %>
            <form method="POST" action="/admin/wholesale/<%= application._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-grn" style="width:100%;justify-content:center;"><i class="fa-solid fa-check"></i> Approve</button></form>
          <% } %>
          <% if (application.status !== "rejected") { %>
            <form method="POST" action="/admin/wholesale/<%= application._id %>/reject" onsubmit="return confirm('Reject this wholesale application?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost" style="width:100%;justify-content:center;color:#dc2626;border-color:#dc2626;"><i class="fa-solid fa-x"></i> Reject</button></form>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>
