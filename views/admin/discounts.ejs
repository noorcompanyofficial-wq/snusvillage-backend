<section class="admin-page admin-discounts-page">
  <div class="admin-page-head">
    <div>
      <span>Marketing</span>
      <h1>Discount Codes</h1>
      <p>Create and manage promo codes for checkout, campaigns, branches, brands, and customer offers.</p>
    </div>

    <div class="admin-head-actions">
      <a class="admin-primary" href="/admin/orders">
        <i class="fa-solid fa-receipt"></i>
        View Orders
      </a>
    </div>
  </div>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <h2>Create Discount Code</h2>
      <span>Checkout Connection Comes Next</span>
    </div>

    <form class="admin-discount-form" action="/admin/discounts" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Code
        <input name="code" placeholder="WELCOME10" required>
      </label>

      <label>
        Description
        <input name="description" placeholder="10% off first order">
      </label>

      <label>
        Discount Type
        <select name="type" required>
          <option value="percentage">Percentage</option>
          <option value="fixed">Fixed Amount</option>
        </select>
      </label>

      <label>
        Value
        <input type="number" name="value" min="0" step="0.01" placeholder="10" required>
      </label>

      <label>
        Minimum Spend
        <input type="number" name="minimumSpend" min="0" step="0.01" placeholder="0">
      </label>

      <label>
        Usage Limit
        <input type="number" name="usageLimit" min="0" step="1" placeholder="0 = unlimited">
      </label>

      <label>
        Applies To Brand
        <input name="appliesToBrand" placeholder="White Fox">
      </label>

      <label>
        Applies To Category
        <input name="appliesToCategory" placeholder="Nicotine Pouches">
      </label>

      <label>
        Expiry Date
        <input type="date" name="expiresAt">
      </label>

      <label class="admin-checkbox-label">
        <input type="checkbox" name="isActive" checked>
        Active Code
      </label>

      <button class="admin-primary" type="submit">
        <i class="fa-solid fa-plus"></i>
        Create Discount
      </button>
    </form>
  </section>

  <section class="admin-panel">
    <div class="admin-panel__head">
      <h2>All Discount Codes</h2>
      <span><%= discounts.length %> Code<%= discounts.length === 1 ? "" : "s" %></span>
    </div>

    <% if (!discounts || discounts.length === 0) { %>
      <div class="admin-empty-state">
        <h2>No Discount Codes Yet</h2>
        <p>Create your first code above, for example WELCOME10 or CAMDEN20.</p>
      </div>
    <% } else { %>
      <div class="admin-discount-grid">
        <% discounts.forEach((discount) => { %>
          <% const isExpired = discount.expiresAt && new Date(discount.expiresAt) < new Date(); %>
          <% const usageFinished = discount.usageLimit > 0 && discount.usedCount >= discount.usageLimit; %>

          <article class="admin-discount-card">
            <div class="admin-discount-card__top">
              <div>
                <span class="status-pill <%= discount.isActive && !isExpired && !usageFinished ? 'order-completed' : 'payment-failed' %>">
                  <%= discount.isActive && !isExpired && !usageFinished ? "Active" : "Inactive" %>
                </span>

                <h3><%= discount.code %></h3>
                <p><%= discount.description || "No description added." %></p>
              </div>

              <strong>
                <% if (discount.type === "percentage") { %>
                  <%= Number(discount.value || 0).toFixed(0) %>%
                <% } else { %>
                  £<%= Number(discount.value || 0).toFixed(2) %>
                <% } %>
              </strong>
            </div>

            <div class="admin-discount-meta">
              <div>
                <span>Type</span>
                <strong><%= discount.type === "percentage" ? "Percentage" : "Fixed" %></strong>
              </div>

              <div>
                <span>Minimum Spend</span>
                <strong>£<%= Number(discount.minimumSpend || 0).toFixed(2) %></strong>
              </div>

              <div>
                <span>Usage</span>
                <strong>
                  <%= discount.usedCount || 0 %>
                  /
                  <%= discount.usageLimit > 0 ? discount.usageLimit : "∞" %>
                </strong>
              </div>

              <div>
                <span>Expires</span>
                <strong><%= discount.expiresAt ? new Date(discount.expiresAt).toLocaleDateString("en-GB") : "Never" %></strong>
              </div>

              <div>
                <span>Brand</span>
                <strong><%= discount.appliesToBrand || "Any" %></strong>
              </div>

              <div>
                <span>Category</span>
                <strong><%= discount.appliesToCategory || "Any" %></strong>
              </div>
            </div>

            <% if (isExpired) { %>
              <div class="admin-discount-warning">Expired Code</div>
            <% } else if (usageFinished) { %>
              <div class="admin-discount-warning">Usage Limit Reached</div>
            <% } %>

            <div class="admin-discount-actions">
              <form action="/admin/discounts/<%= discount._id %>/toggle" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">
                  <%= discount.isActive ? "Disable" : "Enable" %>
                </button>
              </form>

              <form action="/admin/discounts/<%= discount._id %>/delete" method="POST" onsubmit="return confirm('Delete this discount code?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="is-danger">Delete</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>
