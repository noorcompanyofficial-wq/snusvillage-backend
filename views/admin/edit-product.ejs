<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Commerce</div>
    <h1>Edit Product</h1>
    <p>Update product details, images, display controls, stock, and SEO fields.</p>
  </div>
  <div class="ph-right"><a class="btn btn-ghost" href="/admin/products"><i class="fa-solid fa-arrow-left"></i> Back To Products</a></div>
</div>

<form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="sec">
    <div class="sec-head"><h2>Product Details</h2><span style="font-size:11px;color:var(--mu);">Main catalogue information</span></div>
    <div class="sec-body">
      <div class="fgrid-3">
        <div class="fld"><label>Product Name</label><input type="text" name="name" value="<%= product.name || '' %>" required></div>
        <div class="fld"><label>Brand</label><input list="brandOptions" type="text" name="brand" value="<%= product.brand || '' %>" required></div>
        <div class="fld"><label>Category</label><input list="categoryOptions" type="text" name="category" value="<%= product.category || '' %>"></div>
        <div class="fld"><label>SKU</label><input type="text" name="sku" value="<%= product.sku || '' %>"></div>
        <div class="fld"><label>Barcode / EAN</label><input type="text" name="barcode" value="<%= product.barcode || '' %>"></div>
        <div class="fld"><label>Supplier</label><input type="text" name="supplier" value="<%= product.supplier || '' %>"></div>
        <div class="fld"><label>Supplier Code</label><input type="text" name="supplierCode" value="<%= product.supplierCode || '' %>"></div>
        <div class="fld"><label>Cost Price</label><input type="number" name="costPrice" step="0.01" min="0" value="<%= product.costPrice || 0 %>"></div>
        <div class="fld"><label>Flavour</label><input type="text" name="flavour" value="<%= product.flavour || '' %>"></div>
        <div class="fld"><label>Strength</label>
          <select name="strength" required>
            <option value="">Select strength</option>
            <option value="LOW" <%= product.strength === "LOW" ? "selected" : "" %>>LOW</option>
            <option value="MEDIUM" <%= product.strength === "MEDIUM" ? "selected" : "" %>>MEDIUM</option>
            <option value="STRONG" <%= product.strength === "STRONG" ? "selected" : "" %>>STRONG</option>
            <option value="X-STRONG" <%= product.strength === "X-STRONG" ? "selected" : "" %>>X-STRONG</option>
            <option value="EXTREME" <%= product.strength === "EXTREME" ? "selected" : "" %>>EXTREME</option>
          </select>
        </div>
        <div class="fld"><label>Nicotine</label><input type="text" name="nicotine" value="<%= product.nicotine || '' %>"></div>
        <div class="fld"><label>Pouches Per Can</label><input type="number" name="pouchesPerCan" min="0" step="1" value="<%= product.pouchesPerCan || 20 %>"></div>
      </div>
      <div class="fld fspan"><label>Description</label><textarea name="description" rows="4" required><%= product.description || '' %></textarea></div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Pricing &amp; Stock</h2></div>
    <div class="sec-body"><div class="fgrid-3">
      <div class="fld"><label>Price (&pound;)</label><input type="number" name="price" step="0.01" min="0" value="<%= Number(product.price || 0).toFixed(2) %>" required></div>
      <div class="fld"><label>Discount Price (&pound;)</label><input type="number" name="discountPrice" step="0.01" min="0" value="<%= Number(product.discountPrice || 0).toFixed(2) %>"></div>
      <div class="fld"><label>Stock</label><input type="number" name="stock" min="0" value="<%= product.stock || 0 %>"></div>
    </div></div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Display Controls</h2></div>
    <div class="sec-body">
      <div class="toggle-wrap"><div class="toggle-info"><strong>Active Product</strong><span>Show this product on the website</span></div><label class="toggle"><input type="checkbox" name="isActive" <%= product.isActive !== false ? "checked" : "" %>><span class="tslider"></span></label></div>
      <div class="toggle-wrap"><div class="toggle-info"><strong>Featured</strong><span>Prioritise in featured &amp; same-brand collections</span></div><label class="toggle"><input type="checkbox" name="isFeatured" <%= product.isFeatured ? "checked" : "" %>><span class="tslider"></span></label></div>
      <div class="toggle-wrap"><div class="toggle-info"><strong>Best Seller</strong><span>Show in best seller areas</span></div><label class="toggle"><input type="checkbox" name="isBestSeller" <%= product.isBestSeller ? "checked" : "" %>><span class="tslider"></span></label></div>
      <div class="toggle-wrap"><div class="toggle-info"><strong>Sale Badge</strong><span>Show sale badge when discount price is active</span></div><label class="toggle"><input type="checkbox" name="showSaleBadge" <%= product.showSaleBadge ? "checked" : "" %>><span class="tslider"></span></label></div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>Product Images</h2><span style="font-size:11px;color:var(--mu);">Remove old images or add new ones</span></div>
    <div class="sec-body">
      <% if (product.images && product.images.length) { %>
        <div class="img-thumbs" style="margin-bottom:14px;">
          <% product.images.forEach((img) => { %>
            <label class="img-th" style="width:90px;height:90px;flex-direction:column;gap:4px;cursor:pointer;">
              <img src="<%= img %>" alt="<%= product.name %>" style="max-height:56px;">
              <span style="font-size:8px;font-weight:800;color:var(--red);display:flex;align-items:center;gap:3px;"><input type="checkbox" name="removeImages" value="<%= img %>" style="margin:0;width:auto;min-height:0;"> Remove</span>
            </label>
          <% }) %>
        </div>
      <% } else { %>
        <p style="color:var(--mu);font-size:12px;margin-bottom:14px;">No images uploaded yet.</p>
      <% } %>

      <label class="img-drop" for="productImages" style="display:block;">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <p>Click to add new images</p>
        <small>JPG, PNG, WEBP or AVIF &mdash; max 15MB each</small>
      </label>
      <input id="productImages" type="file" name="images" accept="image/jpeg,image/png,image/webp,image/avif" multiple hidden data-image-drop-input="#imagePreviewGrid">
      <div class="img-thumbs" id="imagePreviewGrid"></div>
    </div>
  </div>

  <div class="sec">
    <div class="sec-head"><h2>SEO</h2></div>
    <div class="sec-body">
      <div class="fld"><label>SEO Title</label><input type="text" name="seoTitle" value="<%= product.seoTitle || '' %>"></div>
      <div class="fld fspan"><label>SEO Description</label><textarea name="seoDescription" rows="2"><%= product.seoDescription || '' %></textarea></div>
    </div>
  </div>

  <button type="submit" class="btn btn-red" style="width:100%;justify-content:center;height:44px;margin-bottom:24px;"><i class="fa-solid fa-floppy-disk"></i> Update Product</button>
</form>

<datalist id="brandOptions">
  <option value="WHITE FOX"><option value="SIBERIA"><option value="VELO"><option value="KILLA"><option value="PABLO">
  <option value="GARANT"><option value="ICEBERG CUBA"><option value="LOOP"><option value="CAFERO"><option value="HIT"><option value="ODEN'S">
</datalist>
<datalist id="categoryOptions">
  <option value="Nicotine Pouches"><option value="Snus"><option value="Vape"><option value="Accessories">
</datalist>
