<link rel="stylesheet" href="/css/admin-products.css" />

<section class="admin-page admin-products-page">
  <div class="admin-page-head">
    <div>
      <span>Products</span>
      <h1>Product Catalogue</h1>
      <p>Manage products, stock status, pricing, images, brands, nicotine strength, and catalogue visibility.</p>
    </div>

    <div class="admin-head-actions">
      <a class="admin-primary" href="/admin/products/add">
        <i class="fa-solid fa-plus"></i>
        Add Product
      </a>

      <a class="admin-secondary" href="/admin/inventory">
        <i class="fa-solid fa-warehouse"></i>
        Inventory
      </a>
    </div>
  </div>

  <div class="admin-products-stats">
    <a href="/admin/products" class="admin-products-stat admin-products-stat--dark">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Total Products</span>
      <strong><%= totalProducts %></strong>
    </a>

    <a href="/admin/products?stock=in" class="admin-products-stat">
      <i class="fa-solid fa-circle-check"></i>
      <span>In Stock</span>
      <strong><%= inStock %></strong>
    </a>

    <a href="/admin/products?stock=out" class="admin-products-stat admin-products-stat--danger">
      <i class="fa-solid fa-circle-xmark"></i>
      <span>Out Of Stock</span>
      <strong><%= outStock %></strong>
    </a>

    <a href="/admin/products?visibility=hidden" class="admin-products-stat admin-products-stat--danger">
      <i class="fa-solid fa-eye-slash"></i>
      <span>Hidden</span>
      <strong><%= hiddenProducts %></strong>
    </a>

    <a href="/admin/products?featured=yes" class="admin-products-stat">
      <i class="fa-solid fa-star"></i>
      <span>Featured</span>
      <strong><%= featuredProducts %></strong>
    </a>

    <a href="/admin/products?bestSeller=yes" class="admin-products-stat admin-products-stat--action">
      <i class="fa-solid fa-fire"></i>
      <span>Best Sellers</span>
      <strong><%= bestSellerProducts %></strong>
    </a>
  </div>

  <section class="admin-products-filter-panel">
    <div class="admin-products-filter-head">
      <div>
        <h2>Filter Catalogue</h2>
        <p>Find products by brand, strength, stock status, or sorting preference.</p>
      </div>

      <a href="/admin/products">Reset Filters</a>
    </div>

    <div class="admin-products-filters admin-products-filters--extended">
      <label class="admin-products-search-label">
        Search
        <input
          id="searchFilter"
          type="text"
          value="<%= query.search || '' %>"
          placeholder="Search name, brand, flavour, nicotine..."
          onkeydown="if(event.key === 'Enter') applyFilter()"
        >
      </label>

      <label>
        Brand
        <select onchange="applyFilter()" id="brandFilter">
          <option value="">All Brands</option>
          <option value="WHITE FOX" <%= query.brand === "WHITE FOX" ? "selected" : "" %>>WHITE FOX</option>
          <option value="SIBERIA" <%= query.brand === "SIBERIA" ? "selected" : "" %>>SIBERIA</option>
          <option value="VELO" <%= query.brand === "VELO" ? "selected" : "" %>>VELO</option>
          <option value="KILLA" <%= query.brand === "KILLA" ? "selected" : "" %>>KILLA</option>
          <option value="PABLO" <%= query.brand === "PABLO" ? "selected" : "" %>>PABLO</option>
          <option value="GARANT" <%= query.brand === "GARANT" ? "selected" : "" %>>GARANT</option>
          <option value="ICEBERG CUBA" <%= query.brand === "ICEBERG CUBA" ? "selected" : "" %>>ICEBERG CUBA</option>
          <option value="LOOP" <%= query.brand === "LOOP" ? "selected" : "" %>>LOOP</option>
          <option value="CAFERO" <%= query.brand === "CAFERO" ? "selected" : "" %>>CAFERO</option>
          <option value="HIT" <%= query.brand === "HIT" ? "selected" : "" %>>HIT</option>
          <option value="ODEN'S" <%= query.brand === "ODEN'S" ? "selected" : "" %>>ODEN'S</option>
        </select>
      </label>

      <label>
        Strength
        <select onchange="applyFilter()" id="strengthFilter">
          <option value="">All Strengths</option>
          <option value="LOW" <%= query.strength === "LOW" ? "selected" : "" %>>LOW</option>
          <option value="MEDIUM" <%= query.strength === "MEDIUM" ? "selected" : "" %>>MEDIUM</option>
          <option value="STRONG" <%= query.strength === "STRONG" ? "selected" : "" %>>STRONG</option>
          <option value="X-STRONG" <%= query.strength === "X-STRONG" ? "selected" : "" %>>X-STRONG</option>
          <option value="EXTREME" <%= query.strength === "EXTREME" ? "selected" : "" %>>EXTREME</option>
        </select>
      </label>

      <label>
        Sort
        <select onchange="applyFilter()" id="sortFilter">
          <option value="" <%= !query.sort ? "selected" : "" %>>Newest</option>
          <option value="price-low" <%= query.sort === "price-low" ? "selected" : "" %>>Price Low</option>
          <option value="price-high" <%= query.sort === "price-high" ? "selected" : "" %>>Price High</option>
          <option value="name" <%= query.sort === "name" ? "selected" : "" %>>Name A-Z</option>
        </select>
      </label>

      <label>
        Stock
        <select onchange="applyFilter()" id="stockFilter">
          <option value="" <%= !query.stock ? "selected" : "" %>>All Stock</option>
          <option value="in" <%= query.stock === "in" ? "selected" : "" %>>In Stock</option>
          <option value="out" <%= query.stock === "out" ? "selected" : "" %>>Out Of Stock</option>
        </select>
      </label>

      <label>
        Visibility
        <select onchange="applyFilter()" id="visibilityFilter">
          <option value="" <%= !query.visibility ? "selected" : "" %>>All</option>
          <option value="active" <%= query.visibility === "active" ? "selected" : "" %>>Active</option>
          <option value="hidden" <%= query.visibility === "hidden" ? "selected" : "" %>>Hidden</option>
        </select>
      </label>

      <label>
        Featured
        <select onchange="applyFilter()" id="featuredFilter">
          <option value="" <%= !query.featured ? "selected" : "" %>>All</option>
          <option value="yes" <%= query.featured === "yes" ? "selected" : "" %>>Featured Only</option>
        </select>
      </label>

      <label>
        Best Seller
        <select onchange="applyFilter()" id="bestSellerFilter">
          <option value="" <%= !query.bestSeller ? "selected" : "" %>>All</option>
          <option value="yes" <%= query.bestSeller === "yes" ? "selected" : "" %>>Best Sellers Only</option>
        </select>
      </label>

      <label>
        Sale Badge
        <select onchange="applyFilter()" id="saleBadgeFilter">
          <option value="" <%= !query.saleBadge ? "selected" : "" %>>All</option>
          <option value="yes" <%= query.saleBadge === "yes" ? "selected" : "" %>>Sale Badge Only</option>
        </select>
      </label>
    </div>
  </section>

  <% if (!products || products.length === 0) { %>
    <div class="admin-empty-state">
      <h2>No Products Found</h2>
      <p>Add products or reset your filters to see catalogue items here.</p>
    </div>
  <% } else { %>
    <div class="admin-products-toolbar">
      <div>
        <span>Catalogue Results</span>
        <strong><%= products.length %> Product<%= products.length === 1 ? "" : "s" %> Showing</strong>
      </div>

      <a href="/shop" target="_blank" rel="noopener">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        Preview Shop
      </a>
    </div>

    <div class="admin-products-grid" id="adminProductsGrid">
      <% products.forEach(p => { %>
        <% const activePrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price; %>

        <article class="admin-product-card">
          <div class="admin-product-card__media">
            <% if (p.images && p.images[0]) { %>
              <img src="<%= p.images[0] %>" alt="<%= p.name %>">
            <% } else { %>
              <span>No Image</span>
            <% } %>

            <span class="admin-product-stock <%= p.stock > 0 ? 'is-in' : 'is-out' %>">
              <%= p.stock > 0 ? "In Stock" : "Out Of Stock" %>
            </span>

            <div class="admin-product-card-badges">
              <span class="<%= p.isActive === false ? 'is-hidden' : 'is-active' %>">
                <%= p.isActive === false ? "Hidden" : "Active" %>
              </span>

              <% if (p.isFeatured) { %>
                <span>Featured</span>
              <% } %>

              <% if (p.isBestSeller) { %>
                <span>Best Seller</span>
              <% } %>

              <% if (p.showSaleBadge) { %>
                <span>Sale Badge</span>
              <% } %>
            </div>
          </div>

          <div class="admin-product-card__body">
            <div class="admin-product-tags">
              <span><%= p.brand || "Brand N/A" %></span>
              <span><%= p.strength || "Strength N/A" %></span>
            </div>

            <h2><%= p.name %></h2>

            <p>
              <%= p.description ? p.description.substring(0, 92) : "No Description Added." %><%= p.description && p.description.length > 92 ? "..." : "" %>
            </p>

            <div class="admin-product-meta">
              <div>
                <small>Price</small>
                <strong>£<%= Number(activePrice || 0).toFixed(2) %></strong>
              </div>

              <div>
                <small>Stock</small>
                <strong><%= p.stock || 0 %></strong>
              </div>

              <div>
                <small>Nicotine</small>
                <strong><%= p.nicotine || "N/A" %></strong>
              </div>
            </div>

            <div class="admin-product-actions">
              <a href="/admin/products/edit/<%= p._id %>" class="admin-product-edit">
                <i class="fa-solid fa-pen"></i>
                Edit
              </a>

              <form action="/admin/products/<%= p._id %>/toggle-active" method="POST" class="admin-product-inline-form">
                <button type="submit" class="admin-product-visibility">
                  <i class="fa-solid <%= p.isActive === false ? 'fa-eye' : 'fa-eye-slash' %>"></i>
                  <%= p.isActive === false ? "Activate" : "Hide" %>
                </button>
              </form>

              <button type="button" class="admin-product-delete delete-btn" data-id="<%= p._id %>">
                <i class="fa-solid fa-trash"></i>
                Delete
              </button>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <% if (hasMore) { %>
      <button id="loadMore" class="admin-load-more">Load More</button>
    <% } %>
  <% } %>
</section>

<div id="deleteModal" class="delete-modal">
  <div class="delete-box">
    <h3>Delete Product</h3>
    <p>Are you sure you want to delete this product? This action cannot be undone.</p>

    <div class="delete-actions">
      <button id="cancelDelete" type="button">Cancel</button>
      <form id="deleteForm" method="POST">
        <button type="submit" class="confirm-delete">Yes, Delete</button>
      </form>
    </div>
  </div>
</div>

<script>
function applyFilter() {
  const search = document.getElementById("searchFilter")?.value || "";
  const brand = document.getElementById("brandFilter").value;
  const strength = document.getElementById("strengthFilter").value;
  const sort = document.getElementById("sortFilter").value;
  const stock = document.getElementById("stockFilter").value;
  const visibility = document.getElementById("visibilityFilter")?.value || "";
  const featured = document.getElementById("featuredFilter")?.value || "";
  const bestSeller = document.getElementById("bestSellerFilter")?.value || "";
  const saleBadge = document.getElementById("saleBadgeFilter")?.value || "";

  const params = new URLSearchParams();

  if (search) params.append("search", search);
  if (brand) params.append("brand", brand);
  if (strength) params.append("strength", strength);
  if (sort) params.append("sort", sort);
  if (stock) params.append("stock", stock);
  if (visibility) params.append("visibility", visibility);
  if (featured) params.append("featured", featured);
  if (bestSeller) params.append("bestSeller", bestSeller);
  if (saleBadge) params.append("saleBadge", saleBadge);

  window.location.href = "/admin/products" + (params.toString() ? "?" + params.toString() : "");
}

document.addEventListener("DOMContentLoaded", () => {
  const modal = document.getElementById("deleteModal");
  const deleteForm = document.getElementById("deleteForm");
  const cancelBtn = document.getElementById("cancelDelete");

  document.querySelectorAll(".delete-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      deleteForm.action = "/admin/products/delete/" + btn.dataset.id;
      modal.classList.add("active");
    });
  });

  cancelBtn?.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      modal.classList.remove("active");
    }
  });

  const loadBtn = document.getElementById("loadMore");
  const container = document.getElementById("adminProductsGrid");

  if (!loadBtn || !container) return;

  let page = 1;

  loadBtn.addEventListener("click", async () => {
    page++;

    const currentParams = new URLSearchParams(window.location.search);
    currentParams.set("page", page);

    const response = await fetch("/admin/products?" + currentParams.toString(), {
      headers: {
        Accept: "application/json",
      },
    });

    const data = await response.json();

    if (!data.products || data.products.length === 0) {
      loadBtn.style.display = "none";
      return;
    }

    data.products.forEach((p) => {
      const activePrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
      const image = p.images && p.images[0]
        ? `<img src="${p.images[0]}" alt="${p.name}">`
        : `<span>No Image</span>`;

      const badges = `
        <div class="admin-product-card-badges">
          <span class="${p.isActive === false ? "is-hidden" : "is-active"}">
            ${p.isActive === false ? "Hidden" : "Active"}
          </span>
          ${p.isFeatured ? "<span>Featured</span>" : ""}
          ${p.isBestSeller ? "<span>Best Seller</span>" : ""}
          ${p.showSaleBadge ? "<span>Sale Badge</span>" : ""}
        </div>
      `;

      const card = `
        <article class="admin-product-card">
          <div class="admin-product-card__media">
            ${image}
            <span class="admin-product-stock ${p.stock > 0 ? "is-in" : "is-out"}">
              ${p.stock > 0 ? "In Stock" : "Out Of Stock"}
            </span>
            ${badges}
          </div>

          <div class="admin-product-card__body">
            <div class="admin-product-tags">
              <span>${p.brand || "Brand N/A"}</span>
              <span>${p.strength || "Strength N/A"}</span>
            </div>

            <h2>${p.name}</h2>

            <p>${p.description ? p.description.substring(0, 92) : "No Description Added."}${p.description && p.description.length > 92 ? "..." : ""}</p>

            <div class="admin-product-meta">
              <div><small>Price</small><strong>£${Number(activePrice || 0).toFixed(2)}</strong></div>
              <div><small>Stock</small><strong>${p.stock || 0}</strong></div>
              <div><small>Nicotine</small><strong>${p.nicotine || "N/A"}</strong></div>
            </div>

            <div class="admin-product-actions">
              <a href="/admin/products/edit/${p._id}" class="admin-product-edit">
                <i class="fa-solid fa-pen"></i>
                Edit
              </a>

              <form action="/admin/products/${p._id}/toggle-active" method="POST" class="admin-product-inline-form">
                <button type="submit" class="admin-product-visibility">
                  <i class="fa-solid ${p.isActive === false ? "fa-eye" : "fa-eye-slash"}"></i>
                  ${p.isActive === false ? "Activate" : "Hide"}
                </button>
              </form>

              <button type="button" class="admin-product-delete delete-btn" data-id="${p._id}">
                <i class="fa-solid fa-trash"></i>
                Delete
              </button>
            </div>
          </div>
        </article>
      `;

      container.insertAdjacentHTML("beforeend", card);
    });

    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.onclick = () => {
        deleteForm.action = "/admin/products/delete/" + btn.dataset.id;
        modal.classList.add("active");
      };
    });

    if (!data.hasMore) {
      loadBtn.style.display = "none";
    }
  });
});
</script>
