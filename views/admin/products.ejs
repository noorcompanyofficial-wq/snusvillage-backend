<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Commerce</div>
    <h1>Product Catalogue</h1>
    <p>Manage products, stock status, pricing, images, brands, nicotine strength, and catalogue visibility.</p>
  </div>
  <div class="ph-right">
    <a class="btn btn-red" href="/admin/products/add"><i class="fa-solid fa-plus"></i> Add Product</a>
    <a class="btn btn-ghost" href="/admin/products/import"><i class="fa-solid fa-file-arrow-up"></i> Import CSV</a>
    <a class="btn btn-ghost" href="/admin/products/export/csv" data-no-spa><i class="fa-solid fa-file-export"></i> Export CSV</a>
    <a class="btn btn-ghost" href="/admin/inventory"><i class="fa-solid fa-warehouse"></i> Inventory</a>
  </div>
</div>

<div class="stats">
  <a class="stat stat-blue" href="/admin/products"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-boxes-stacked"></i></div></div><div class="stat-lbl">Total Products</div><div class="stat-val"><%= totalProducts %></div></a>
  <a class="stat stat-grn" href="/admin/products?stock=in"><div class="stat-top"><div class="stat-icon si-g"><i class="fa-solid fa-circle-check"></i></div></div><div class="stat-lbl">In Stock</div><div class="stat-val"><%= inStock %></div></a>
  <a class="stat stat-red" href="/admin/products?stock=out"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-circle-xmark"></i></div></div><div class="stat-lbl">Out Of Stock</div><div class="stat-val"><%= outStock %></div></a>
  <a class="stat stat-red" href="/admin/products?visibility=hidden"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-eye-slash"></i></div></div><div class="stat-lbl">Hidden</div><div class="stat-val"><%= hiddenProducts %></div></a>
  <a class="stat stat-amb" href="/admin/products?featured=yes"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-star"></i></div></div><div class="stat-lbl">Featured</div><div class="stat-val"><%= featuredProducts %></div></a>
  <a class="stat stat-amb" href="/admin/products?bestSeller=yes"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-fire"></i></div></div><div class="stat-lbl">Best Sellers</div><div class="stat-val"><%= bestSellerProducts %></div></a>
</div>

<div class="sec">
  <div class="sec-head">
    <h2>Filter Catalogue</h2>
    <a href="/admin/products" class="btn btn-sm btn-ghost">Reset Filters</a>
  </div>
  <form class="sec-body" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;" method="GET" action="/admin/products">
    <div class="fld" style="grid-column:1/-1;margin-bottom:0;">
      <label>Search</label>
      <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Search name, brand, flavour, nicotine...">
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Brand</label>
      <select name="brand" onchange="this.form.requestSubmit()">
        <option value="">All Brands</option>
        <% ["WHITE FOX","SIBERIA","VELO","KILLA","PABLO","GARANT","ICEBERG CUBA","LOOP","CAFERO","HIT","ODEN'S"].forEach((b) => { %>
          <option value="<%= b %>" <%= query.brand === b ? "selected" : "" %>><%= b %></option>
        <% }) %>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Strength</label>
      <select name="strength" onchange="this.form.requestSubmit()">
        <option value="">All Strengths</option>
        <% ["LOW","MEDIUM","STRONG","X-STRONG","EXTREME"].forEach((s) => { %>
          <option value="<%= s %>" <%= query.strength === s ? "selected" : "" %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Sort</label>
      <select name="sort" onchange="this.form.requestSubmit()">
        <option value="" <%= !query.sort ? "selected" : "" %>>Newest</option>
        <option value="price-low" <%= query.sort === "price-low" ? "selected" : "" %>>Price Low</option>
        <option value="price-high" <%= query.sort === "price-high" ? "selected" : "" %>>Price High</option>
        <option value="name" <%= query.sort === "name" ? "selected" : "" %>>Name A-Z</option>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Stock</label>
      <select name="stock" onchange="this.form.requestSubmit()">
        <option value="" <%= !query.stock ? "selected" : "" %>>All Stock</option>
        <option value="in" <%= query.stock === "in" ? "selected" : "" %>>In Stock</option>
        <option value="out" <%= query.stock === "out" ? "selected" : "" %>>Out Of Stock</option>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Visibility</label>
      <select name="visibility" onchange="this.form.requestSubmit()">
        <option value="" <%= !query.visibility ? "selected" : "" %>>All</option>
        <option value="active" <%= query.visibility === "active" ? "selected" : "" %>>Active</option>
        <option value="hidden" <%= query.visibility === "hidden" ? "selected" : "" %>>Hidden</option>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Featured</label>
      <select name="featured" onchange="this.form.requestSubmit()">
        <option value="" <%= !query.featured ? "selected" : "" %>>All</option>
        <option value="yes" <%= query.featured === "yes" ? "selected" : "" %>>Featured Only</option>
      </select>
    </div>
    <div class="fld" style="margin-bottom:0;"><label>Best Seller</label>
      <select name="bestSeller" onchange="this.form.requestSubmit()">
        <option value="" <%= !query.bestSeller ? "selected" : "" %>>All</option>
        <option value="yes" <%= query.bestSeller === "yes" ? "selected" : "" %>>Best Sellers Only</option>
      </select>
    </div>
  </form>
</div>

<div class="sec">
  <div class="sec-head">
    <h2>Quick Price Change</h2>
    <span style="font-size:11px;color:var(--mu);">Affects <strong><%= filteredTotal || 0 %></strong> product<%= Number(filteredTotal || 0) === 1 ? "" : "s" %> matching current filters</span>
  </div>
  <form class="sec-body" style="display:grid;grid-template-columns:repeat(3,1fr) auto;gap:12px;align-items:end;" action="/admin/products/bulk-prices" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="search" value="<%= query.search || '' %>">
    <input type="hidden" name="brand" value="<%= query.brand || '' %>">
    <input type="hidden" name="strength" value="<%= query.strength || '' %>">
    <input type="hidden" name="sort" value="<%= query.sort || '' %>">
    <input type="hidden" name="stock" value="<%= query.stock || '' %>">
    <input type="hidden" name="visibility" value="<%= query.visibility || '' %>">
    <input type="hidden" name="featured" value="<%= query.featured || '' %>">
    <input type="hidden" name="bestSeller" value="<%= query.bestSeller || '' %>">
    <div class="fld" style="margin-bottom:0;"><label>New Price (&pound;)</label><input type="number" name="price" min="0" step="0.01" placeholder="Leave blank to keep"></div>
    <div class="fld" style="margin-bottom:0;"><label>New Discount Price (&pound;)</label><input type="number" name="discountPrice" min="0" step="0.01" placeholder="Leave blank / 0 to clear"></div>
    <div class="fld" style="margin-bottom:0;"><label>Confirm</label><input type="text" name="confirmText" placeholder="Type UPDATE"></div>
    <button type="submit" class="btn btn-red" onclick="return confirm('Apply this price change to ' + <%- JSON.stringify(filteredTotal || 0) %> + ' product(s)?')"><i class="fa-solid fa-bolt"></i> Apply</button>
  </form>
</div>

<% if (!products || products.length === 0) { %>
  <div class="admin-empty-state"><h2>No Products Found</h2><p>Add products or reset your filters to see catalogue items here.</p></div>
<% } else { %>
  <div class="sec">
    <div class="sec-head">
      <h2><%= products.length %> Product<%= products.length === 1 ? "" : "s" %> Showing</h2>
      <a href="/shop" target="_blank" class="btn btn-sm btn-ghost"><i class="fa-solid fa-arrow-up-right-from-square"></i> Preview Shop</a>
    </div>
    <div class="prod-grid">
      <% products.forEach(p => {
        const activePrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
        const badgeClass = p.strength === "X-STRONG" || p.strength === "EXTREME" ? "pb-xstr" : p.strength === "STRONG" ? "pb-str" : p.strength === "MEDIUM" ? "pb-med" : "pb-low";
      %>
        <div class="prod-card">
          <div class="prod-img-wrap">
            <% if (p.strength) { %><span class="pb <%= badgeClass %>"><%= p.strength %></span><% } %>
            <% if (p.images && p.images[0]) { %><img src="<%= p.images[0] %>" alt="<%= p.name %>"><% } else { %><span style="color:var(--mu);font-size:11px;">No Image</span><% } %>
            <div class="p-sbar" style="background:<%= p.stock > 0 ? 'var(--grn)' : '#dc2626' %>;"></div>
          </div>
          <div class="prod-body">
            <div class="prod-brand"><%= p.brand || "Brand N/A" %><% if (p.isActive === false) { %> &middot; Hidden<% } %><% if (p.isBestSeller) { %> &middot; Best Seller<% } %><% if (p.isFeatured) { %> &middot; Featured<% } %></div>
            <div class="prod-name"><%= p.name %></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:10px;color:var(--mu);margin-bottom:9px;">
              <span>Cost: &pound;<%= Number(p.costPrice || 0).toFixed(2) %></span>
              <span>SKU: <%= p.sku || "N/A" %></span>
            </div>
            <div class="prod-foot">
              <span class="prod-price">&pound;<%= Number(activePrice || 0).toFixed(2) %></span>
              <div class="prod-stock"><span class="sdot <%= p.stock > 0 ? 's-ok' : 's-out' %>"></span><span style="color:<%= p.stock > 0 ? 'var(--grn)' : '#dc2626' %>;"><%= p.stock > 0 ? p.stock + " left" : "Out of stock" %></span></div>
            </div>
          </div>
          <div class="prod-actions">
            <a class="btn btn-sm btn-ghost" href="/admin/products/edit/<%= p._id %>"><i class="fa-solid fa-pen"></i> Edit</a>
            <form action="/admin/products/<%= p._id %>/toggle-active" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-ghost"><i class="fa-solid <%= p.isActive === false ? 'fa-eye' : 'fa-eye-slash' %>"></i> <%= p.isActive === false ? "Show" : "Hide" %></button>
            </form>
            <form action="/admin/products/delete/<%= p._id %>" method="POST" onsubmit="return confirm('Delete this product? This cannot be undone.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (hasMore) { %>
      <div style="padding:16px;text-align:center;">
        <a class="btn btn-ghost" href="/admin/products?<%- new URLSearchParams({ ...query, page: nextPage }).toString() %>">Next Page &rarr;</a>
      </div>
    <% } %>
  </div>
<% } %>
