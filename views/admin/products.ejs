<link rel="stylesheet" href="/css/admin-products.css" />
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
/>



<div class="admin-products">

  <div class="admin-stats">

  <div class="stat-box">
    <h3><%= totalProducts %></h3>
    <p>Total Products</p>
  </div>

  <div class="stat-box green">
    <h3><%= inStock %></h3>
    <p>In Stock</p>
  </div>

  <div class="stat-box red">
    <h3><%= outStock %></h3>
    <p>Out of Stock</p>
  </div>

</div>

  <!-- ===== FILTER BAR ===== -->
<div class="admin-filters">

  <!-- BRAND -->
  <select onchange="applyFilter()" id="brandFilter">
    <option value="">All Brands</option>
   <option value="WHITE FOX" <%= query.brand === "WHITE FOX" ? "selected" : "" %>>WHITE FOX</option>
<option value="SIBERIA" <%= query.brand === "SIBERIA" ? "selected" : "" %>>SIBERIA</option>
<option value="VELO" <%= query.brand === "VELO" ? "selected" : "" %>>VELO</option>
<option value="KILLA" <%= query.brand === "KILLA" ? "selected" : "" %>>KILLA</option>
<option value="PABLO" <%= query.brand === "PABLO" ? "selected" : "" %>>PABLO</option>
<option value="GARANT" <%= query.brand === "GARANT" ? "selected" : "" %>>GARANT</option>
<option value="ICEBERG CUBA" <%= query.brand === "ICEBERG CUBA" ? "selected" : "" %>>ICEBERG CUBA</option>
<option value="LOOP" <%= query.brand === "LOOP" ? "selected" : "" %>>LOOP</option>
<option value="CAFERO" <%= query.brand === "CAFERO" ? "selected" : "" %>>CAFERO</option>
<option value="HIT" <%= query.brand === "HIT" ? "selected" : "" %>>HIT</option>
<option value="ODEN'S" <%= query.brand === "ODEN'S" ? "selected" : "" %>>ODEN'S</option>
  </select>

  <!-- STRENGTH -->
  <select onchange="applyFilter()" id="strengthFilter">
    <option value="">All Strength</option>
    <option>LOW</option>
    <option>MEDIUM</option>
    <option>STRONG</option>
    <option>X-STRONG</option>
    <option>EXTREME</option>
  </select>

  <!-- SORT -->
  <select onchange="applyFilter()" id="sortFilter">
    <option value="">Newest</option>
    <option value="price-low">Price Low</option>
    <option value="price-high">Price High</option>
    <option value="name">Name A-Z</option>
  </select>

  <!-- STOCK -->
  <select onchange="applyFilter()" id="stockFilter">
    <option value="">All</option>
    <option value="in">In Stock</option>
    <option value="out">Out of Stock</option>
  </select>

</div>

  <div class="admin-header">

    <a href="/admin/products/add" class="admin-add-btn">
      <i class="fa-solid fa-plus"></i> Add Product
    </a>
  </div>


  <div class="admin-grid">
    <% products.forEach(p => { %>

      <div class="admin-card">

        <!-- IMAGE -->
        <div class="admin-img-box">
          <img src="<%= p.images[0] %>" />

          <span class="admin-stock <%= p.stock > 0 ? 'in' : 'out' %>">
            <%= p.stock > 0 ? 'In Stock' : 'Out of Stock' %>
          </span>
        </div>

        <!-- INFO -->
        <div class="admin-info">
          <h3><%= p.name %></h3>

          <div class="admin-price-box">
            <span class="admin-price">Price: £<%= p.price.toFixed(2) %></span>

            <% if(p.discountPrice) { %>
              <span class="admin-discount">Discount Price: £<%= p.discountPrice.toFixed(2) %></span>
            <% } %>
          </div>

          <p class="admin-category">
            <i class="fa-solid fa-tag"></i>Category: <%= p.category %>
          </p>

            <p class="admin-category">
            <i class="fa-solid fa-dot"></i> Nicotine: <%= p.nicotine %>
          </p>

           <p class="admin-category">
            <i class="fa-solid fa-dot"></i> Stock: <%= p.stock %>
          </p>

          <p class="admin-desc">
           Description: <%= p.description.substring(0, 80) %>...
          </p>

          
          <p class="admin-desc">
            Strength: <%= p.strength %>
          </p>

          <!-- ACTIONS -->
          <div class="admin-actions">
            <a href="/admin/products/edit/<%= p._id %>" class="edit">
              <i class="fa-solid fa-pen"></i>
            </a>

           <button class="delete-btn" data-id="<%= p._id %>">
                <i class="fa-solid fa-trash"></i>
          </button>
          </div>
        </div>

      </div>

    <% }) %>
  </div>

  <button id="loadMore" class="admin-load-more">Load More</button>

</div>

<div id="deleteModal" class="delete-modal">
  <div class="delete-box">
    <h3>Delete Product</h3>
    <p>Are you sure you want to delete?</p>

    <div class="delete-actions">
      <button id="cancelDelete">Cancel</button>
      <form id="deleteForm" method="POST">
        <button type="submit" class="confirm-delete">Yes, Delete</button>
      </form>
    </div>
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {

  let page = 1;

  const loadBtn = document.getElementById("loadMore");
  const container = document.querySelector(".admin-grid");

  console.log("LoadMore ready");

  loadBtn.addEventListener("click", async () => {

    console.log("CLICKED");

    page++;

    const res = await fetch(`/admin/products?page=${page}`, {
      headers: {
        "Accept": "application/json"
      }
    });

    const data = await res.json();

    console.log("DATA:", data);

    if (!data.products || data.products.length === 0) {
      loadBtn.style.display = "none";
      return;
    }

    data.products.forEach(p => {
      const card = `
        <div class="admin-card">

          <div class="admin-img-box">
            <img src="${p.images?.[0] || ''}" />
          </div>

          <div class="admin-info">
            <h3>${p.name}</h3>
            <p>£${p.price}</p>
          </div>

        </div>
      `;

      container.insertAdjacentHTML("beforeend", card);
    });

    if (!data.hasMore) {
      loadBtn.style.display = "none";
    }

  });

});
</script>
<!-- Delete Product -->
<script>
const modal = document.getElementById("deleteModal");
const deleteForm = document.getElementById("deleteForm");
const cancelBtn = document.getElementById("cancelDelete");

document.querySelectorAll(".delete-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    const id = btn.dataset.id;

    // set form action dynamically
    deleteForm.action = "/admin/products/delete/" + id;

    modal.classList.add("active");
  });
});

// cancel
cancelBtn.addEventListener("click", () => {
  modal.classList.remove("active");
});

// click outside to close
modal.addEventListener("click", (e) => {
  if (e.target === modal) {
    modal.classList.remove("active");
  }
});
</script>

<script>
function applyFilter() {
  const brand = document.getElementById("brandFilter").value;
  const strength = document.getElementById("strengthFilter").value;
  const sort = document.getElementById("sortFilter").value;
  const stock = document.getElementById("stockFilter").value;

  let params = new URLSearchParams();

  if (brand) params.append("brand", brand);
  if (strength) params.append("strength", strength);
  if (sort) params.append("sort", sort);
  if (stock) params.append("stock", stock);

  window.location.href = "/admin/products?" + params.toString();
}
</script>