<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">Operations</div>
    <h1>Dashboard</h1>
    <p>Track sales, orders, products, customers, carts, wholesale reviews, and key operating signals.</p>
  </div>
  <div class="ph-right">
    <a class="btn btn-red" href="/admin/products/add"><i class="fa-solid fa-plus"></i> Add Product</a>
    <a class="btn btn-ghost" href="/admin/orders/export/csv" data-no-spa><i class="fa-solid fa-file-export"></i> Export Orders</a>
  </div>
</div>

<div class="stats">
  <a class="stat stat-blue" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-bag-shopping"></i></div></div><div class="stat-lbl">Today's Orders</div><div class="stat-val"><%= stats.todayOrders || 0 %></div><div class="stat-sub">Orders created today</div></a>
  <a class="stat stat-grn" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-g"><i class="fa-solid fa-sterling-sign"></i></div></div><div class="stat-lbl">Today's Revenue</div><div class="stat-val">&pound;<%= Number(stats.todayRevenue || 0).toFixed(2) %></div><div class="stat-sub">Paid orders today</div></a>
  <a class="stat stat-amb" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-clock"></i></div></div><div class="stat-lbl">Pending Orders</div><div class="stat-val"><%= stats.pendingOrders || 0 %></div><div class="stat-sub">New, processing or packed</div></a>
  <a class="stat stat-red" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-triangle-exclamation"></i></div></div><div class="stat-lbl">Failed Payments</div><div class="stat-val"><%= stats.failedPayments || 0 %></div><div class="stat-sub">Needs attention</div></a>
  <a class="stat stat-blue" href="/admin/carts"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-cart-shopping"></i></div></div><div class="stat-lbl">Active Carts</div><div class="stat-val"><%= stats.activeCarts || 0 %></div><div class="stat-sub">Updated in last hour</div></a>
  <a class="stat stat-amb" href="/admin/carts"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-cart-arrow-down"></i></div></div><div class="stat-lbl">Abandoned Carts</div><div class="stat-val"><%= stats.abandonedCarts || 0 %></div><div class="stat-sub">Value: &pound;<%= Number(stats.abandonedCartValue || 0).toFixed(2) %></div></a>
  <a class="stat stat-blue" href="/admin/products"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-box"></i></div></div><div class="stat-lbl">Total Products</div><div class="stat-val"><%= stats.totalProducts || 0 %></div><div class="stat-sub"><%= stats.inStock || 0 %> in stock</div></a>
  <a class="stat stat-amb" href="/admin/products?stock=low"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-arrow-trend-down"></i></div></div><div class="stat-lbl">Low Stock</div><div class="stat-val"><%= stats.lowStock || 0 %></div><div class="stat-sub">5 or less remaining</div></a>
</div>

<div class="panel" style="margin-bottom:12px;">
  <div class="panel-head"><h2>Dashboard Alerts</h2><span class="panel-lk" onclick="location.href='/admin/orders'">Review Operations &rarr;</span></div>
  <div class="stats" style="padding:16px;margin-bottom:0;">
    <a class="stat stat-amb" href="/admin/products?stock=low"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-arrow-trend-down"></i></div></div><div class="stat-lbl">Low Stock</div><div class="stat-val"><%= dashboardAlerts.lowStockProducts.length %></div><div class="stat-sub">5 or less remaining</div></a>
    <a class="stat stat-red" href="/admin/products?stock=out"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-box-open"></i></div></div><div class="stat-lbl">Out Of Stock</div><div class="stat-val"><%= dashboardAlerts.outOfStockProducts.length %></div><div class="stat-sub">Currently unavailable</div></a>
    <a class="stat stat-red" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-r"><i class="fa-solid fa-credit-card"></i></div></div><div class="stat-lbl">Failed Payments</div><div class="stat-val"><%= dashboardAlerts.failedPaymentOrders.length %></div><div class="stat-sub">Needs payment review</div></a>
    <a class="stat stat-amb" href="/admin/orders"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-truck-fast"></i></div></div><div class="stat-lbl">Royal Mail Failed</div><div class="stat-val"><%= dashboardAlerts.royalMailFailedOrders.length %></div><div class="stat-sub">Fulfilment needs attention</div></a>
    <a class="stat stat-blue" href="/admin/messages?status=unread"><div class="stat-top"><div class="stat-icon si-b"><i class="fa-solid fa-envelope"></i></div></div><div class="stat-lbl">Unread Messages</div><div class="stat-val"><%= dashboardAlerts.unreadContactMessages.length %></div><div class="stat-sub">Customer contact messages</div></a>
    <a class="stat stat-amb" href="/admin/wholesale"><div class="stat-top"><div class="stat-icon si-a"><i class="fa-solid fa-id-card"></i></div></div><div class="stat-lbl">Pending Wholesale</div><div class="stat-val"><%= dashboardAlerts.pendingWholesaleApplications.length %></div><div class="stat-sub">Trader applications waiting</div></a>
  </div>
</div>

<div class="dg">
  <div class="panel">
    <div class="panel-head"><h2>Recent Orders</h2><span class="panel-lk" onclick="location.href='/admin/orders'">View all &rarr;</span></div>
    <% if (recentOrders && recentOrders.length) { %>
      <div class="tbl-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody>
        <% recentOrders.forEach((order) => { %>
          <tr style="cursor:pointer;" onclick="location.href='/admin/orders/<%= order._id %>'">
            <td><span class="t-mono">#<%= order._id.toString().slice(-6).toUpperCase() %></span></td>
            <td><span class="t-name"><%= [order.customer?.firstName, order.customer?.lastName].filter(Boolean).join(" ") || "Customer" %></span><span class="t-sub"><%= order.customer?.email || "No email" %></span></td>
            <td><span class="t-amt">&pound;<%= Number(order.total || 0).toFixed(2) %></span></td>
            <td><span class="pill p-<%= order.paymentStatus || 'pending' %>"><%= order.paymentStatus || "pending" %></span></td>
            <td class="t-sub"><%= new Date(order.createdAt).toLocaleString("en-GB") %></td>
          </tr>
        <% }) %>
      </tbody></table></div>
    <% } else { %>
      <div class="admin-empty-state"><p>No orders found yet.</p></div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Quick Actions</h2></div>
    <div class="qa">
      <a class="qa-item" href="/admin/orders"><div class="qa-ic qi-b"><i class="fa-solid fa-receipt"></i></div><div class="qa-txt"><strong>Manage Orders</strong><span>Fulfil and update orders</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
      <a class="qa-item" href="/admin/carts"><div class="qa-ic qi-g"><i class="fa-solid fa-cart-shopping"></i></div><div class="qa-txt"><strong>View Carts</strong><span>Active &amp; abandoned carts</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
      <a class="qa-item" href="/admin/products"><div class="qa-ic qi-r"><i class="fa-solid fa-pen-to-square"></i></div><div class="qa-txt"><strong>Edit Catalogue</strong><span>Manage products</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
      <a class="qa-item" href="/admin/wholesale"><div class="qa-ic qi-p"><i class="fa-solid fa-id-card"></i></div><div class="qa-txt"><strong>Review Traders</strong><span>Wholesale applications</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
      <a class="qa-item" href="/admin/users"><div class="qa-ic qi-b"><i class="fa-solid fa-user-shield"></i></div><div class="qa-txt"><strong>Manage Users</strong><span>Admins &amp; traders</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
      <a class="qa-item" href="/shop" target="_blank"><div class="qa-ic qi-a"><i class="fa-solid fa-eye"></i></div><div class="qa-txt"><strong>Preview Shop</strong><span>Open the live store</span></div><i class="fa-solid fa-chevron-right qa-arr"></i></a>
    </div>
  </div>
</div>

<div class="dg2">
  <div class="panel">
    <div class="panel-head"><h2>Abandoned / Unfinished Carts</h2><span class="panel-lk" onclick="location.href='/admin/carts'">View all &rarr;</span></div>
    <div class="al-list">
      <% if (abandonedCarts && abandonedCarts.length) { %>
        <% abandonedCarts.forEach((cart) => {
          const cartTotal = cart.items.reduce((sum, item) => sum + ((item.priceAtTime || 0) * (item.quantity || 0)), 0);
        %>
          <a class="msg-item2" href="/admin/carts">
            <div style="flex:1;min-width:0;">
              <div class="msg-name"><%= cart.user ? "User Cart" : "Guest Cart" %></div>
              <div class="msg-prev" style="max-width:none;"><%= cart.items.length %> item<%= cart.items.length === 1 ? "" : "s" %> &middot; last active <%= new Date(cart.updatedAt).toLocaleString("en-GB") %></div>
            </div>
            <span class="t-amt">&pound;<%= Number(cartTotal || 0).toFixed(2) %></span>
          </a>
        <% }) %>
      <% } else { %>
        <p style="padding:12px;color:var(--mu);">No abandoned carts found.</p>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Recent Products</h2><span class="panel-lk" onclick="location.href='/admin/products'">View all &rarr;</span></div>
    <div class="al-list">
      <% if (recentProducts && recentProducts.length) { %>
        <% recentProducts.forEach((product) => { %>
          <a class="msg-item2" href="/admin/products/edit/<%= product._id %>">
            <% if (product.images && product.images.length) { %><img class="al-img" src="<%= product.images[0] %>" alt="" /><% } %>
            <div style="flex:1;min-width:0;"><div class="msg-name"><%= product.name %></div></div>
            <span class="t-amt">&pound;<%= Number(product.discountPrice || product.price || 0).toFixed(2) %></span>
          </a>
        <% }) %>
      <% } else { %>
        <p style="padding:12px;color:var(--mu);">No products found yet.</p>
      <% } %>
    </div>
  </div>
</div>
