<%- include("../partials/admin-flash") %>

<div class="ph">
  <div>
    <div class="ph-eye">System</div>
    <h1>Login Monitoring</h1>
    <p>Accounts with failed attempts, locks, suspicious IPs, or blocked IPs.</p>
  </div>
</div>

<div class="sec">
  <div class="tbl-wrap">
    <table>
      <thead><tr><th>Email</th><th>Attempts</th><th>Locked Until</th><th>Suspicious IPs</th><th>Blocked IPs</th></tr></thead>
      <tbody>
        <% if (users.length) { %>
          <% users.forEach((account) => { %>
            <tr>
              <td class="t-name"><%= account.email %></td>
              <td><%= account.loginAttempts || 0 %></td>
              <td class="t-sub"><%= account.lockUntil ? new Date(account.lockUntil).toLocaleString("en-GB") : "Not locked" %></td>
              <td class="t-sub"><%= (account.suspiciousIPs || []).join(", ") || "None" %></td>
              <td class="t-sub"><%= (account.blockedIPs || []).join(", ") || "None" %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" style="color:var(--mu);">No suspicious login activity found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
