<section class="admin-orders-page">
  <div class="admin-page-header">
    <div>
      <span class="eyebrow">B2C ORDERS</span>
      <h1>Customer Orders</h1>
      <p>View and manage new B2C orders placed from checkout.</p>
    </div>

    <a href="/admin/orders/export/csv" class="admin-mini-btn">Export CSV</a>
  </div>

  <% if (!orders || orders.length === 0) { %>
    <div class="admin-empty-state">
      <h2>No orders yet</h2>
      <p>Orders placed from checkout will appear here.</p>
    </div>
  <% } else { %>
    <div class="admin-orders-table-wrap">
      <table class="admin-orders-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Total</th>
            <th>Manage</th>
            <th>Royal Mail</th>
            <th>Date</th>
          </tr>
        </thead>

        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td>
                <strong>#<%= order._id.toString().slice(-6).toUpperCase() %></strong>
                <small><%= order._id %></small>
                <a href="/admin/orders/<%= order._id %>" class="admin-mini-link" style="margin-top: 8px;">View Order</a>
              </td>

              <td>
                <strong>
                  <%= order.customer?.firstName || "" %>
                  <%= order.customer?.lastName || "" %>
                </strong>
                <small><%= order.customer?.email || "No email" %></small>
                <small><%= order.customer?.phone || "" %></small>
              </td>

              <td>
                <% order.items.forEach(item => { %>
                  <div class="admin-order-item">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.name %>">
                    <% } %>

                    <span>
                      <strong><%= item.name %></strong>
                      <small>Qty: <%= item.quantity %> × £<%= item.price.toFixed(2) %></small>
                    </span>
                  </div>
                <% }) %>
              </td>

              <td>
                <strong>£<%= order.total.toFixed(2) %></strong>
              </td>

              <td>
                <form class="admin-order-status-form" action="/admin/orders/<%= order._id %>/status" method="POST">
                  <label>
                    Payment
                    <select name="paymentStatus">
                      <option value="pending" <%= order.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
                      <option value="paid" <%= order.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
                      <option value="failed" <%= order.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
                    </select>
                  </label>

                  <label>
                    Order
                    <select name="orderStatus">
                      <option value="new" <%= order.orderStatus === "new" ? "selected" : "" %>>New</option>
                      <option value="processing" <%= order.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
                      <option value="packed" <%= order.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
                      <option value="shipped" <%= order.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
                      <option value="completed" <%= order.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
                      <option value="cancelled" <%= order.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
                    </select>
                  </label>

                  <button type="submit">Update</button>
                </form>
              </td>

              <td>
                <% if (order.royalMail && order.royalMail.syncStatus === "sent") { %>
                  <span class="status-pill order-completed">Sent</span>
                  <small>ID: <%= order.royalMail.orderIdentifier || "N/A" %></small>
                  <small>Label: create in Click & Drop</small>

                  <% if (order.royalMail.trackingNumber) { %>
                    <small>Tracking: <%= order.royalMail.trackingNumber %></small>
                  <% } %>

                <% } else if (order.royalMail && order.royalMail.syncStatus === "failed") { %>
                  <span class="status-pill payment-failed">Failed</span>
                  <small><%= order.royalMail.syncError || "Royal Mail sync failed" %></small>

                  <form action="/admin/orders/<%= order._id %>/send-royal-mail" method="POST" style="margin-top: 8px;">
                    <button type="submit" class="admin-mini-btn">Send to Royal Mail</button>
                  </form>

                <% } else { %>
                  <span class="status-pill payment-pending">Not sent</span>

                  <% if (order.royalMail && order.royalMail.syncError) { %>
                    <small><%= order.royalMail.syncError %></small>
                  <% } %>

                  <form action="/admin/orders/<%= order._id %>/send-royal-mail" method="POST" style="margin-top: 8px;">
                    <button type="submit" class="admin-mini-btn">Send to Royal Mail</button>
                  </form>
                <% } %>
              </td>

              <td>
                <%= new Date(order.createdAt).toLocaleDateString("en-GB") %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>