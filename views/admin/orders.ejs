<%
  function money(value) {
    return "£" + Number(value || 0).toFixed(2);
  }

  function orderShortId(order) {
    return order._id.toString().slice(-6).toUpperCase();
  }

  function buildQuery(extra = {}) {
    const params = new URLSearchParams();

    Object.entries(query || {}).forEach(([key, value]) => {
      if (value !== undefined && value !== null && String(value).trim() !== "" && key !== "page") {
        params.set(key, value);
      }
    });

    Object.entries(extra).forEach(([key, value]) => {
      if (value === "" || value === null || value === undefined) {
        params.delete(key);
      } else {
        params.set(key, value);
      }
    });

    return params.toString();
  }
%>

<section class="admin-page admin-orders-page admin-orders-v2">
  <div class="admin-page-head">
    <div>
      <span>B2C Orders</span>
      <h1>Customer Orders</h1>
      <p>Search, filter, and manage checkout orders, fulfilment, payment status, and Royal Mail sync.</p>
    </div>

    <div class="admin-head-actions">
      <a href="/admin/orders/export/csv" class="admin-secondary">
        <i class="fa-solid fa-file-export"></i>
        Export CSV
      </a>
    </div>
  </div>

  <div class="admin-stat-grid">
    <a class="admin-stat-card" href="/admin/orders">
      <i class="fa-solid fa-receipt"></i>
      <span>Total Orders</span>
      <strong><%= stats.total %></strong>
    </a>

    <a class="admin-stat-card" href="/admin/orders?paymentStatus=paid">
      <i class="fa-solid fa-circle-check"></i>
      <span>Paid</span>
      <strong><%= stats.paid %></strong>
    </a>

    <a class="admin-stat-card" href="/admin/orders?orderStatus=processing">
      <i class="fa-solid fa-box-open"></i>
      <span>Active Orders</span>
      <strong><%= stats.active %></strong>
    </a>

    <a class="admin-stat-card" href="/admin/orders?royalMailStatus=failed">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span>Royal Mail Failed</span>
      <strong><%= stats.royalMailFailed %></strong>
    </a>
  </div>

  <form class="admin-panel admin-orders-filter-form" action="/admin/orders" method="GET">
    <div class="admin-orders-filter-grid">
      <label class="is-wide">
        Search
        <input name="search" value="<%= query.search || '' %>" placeholder="Email, phone, name, order ID, SumUp reference">
      </label>

      <label>
        Payment
        <select name="paymentStatus">
          <option value="">All Payments</option>
          <option value="pending" <%= query.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
          <option value="paid" <%= query.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
          <option value="failed" <%= query.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
        </select>
      </label>

      <label>
        Order Status
        <select name="orderStatus">
          <option value="">All Orders</option>
          <option value="new" <%= query.orderStatus === "new" ? "selected" : "" %>>New</option>
          <option value="processing" <%= query.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
          <option value="packed" <%= query.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
          <option value="shipped" <%= query.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
          <option value="completed" <%= query.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
          <option value="cancelled" <%= query.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
        </select>
      </label>

      <label>
        Fulfilment
        <select name="fulfilmentMethod">
          <option value="">All Methods</option>
          <option value="delivery" <%= query.fulfilmentMethod === "delivery" ? "selected" : "" %>>Delivery</option>
          <option value="click_collect" <%= query.fulfilmentMethod === "click_collect" ? "selected" : "" %>>Click & Collect</option>
        </select>
      </label>

      <label>
        Royal Mail
        <select name="royalMailStatus">
          <option value="">All Royal Mail</option>
          <option value="not_sent" <%= query.royalMailStatus === "not_sent" ? "selected" : "" %>>Not Sent</option>
          <option value="sent" <%= query.royalMailStatus === "sent" ? "selected" : "" %>>Sent</option>
          <option value="failed" <%= query.royalMailStatus === "failed" ? "selected" : "" %>>Failed</option>
        </select>
      </label>

      <label>
        Sort
        <select name="sort">
          <option value="newest" <%= !query.sort || query.sort === "newest" ? "selected" : "" %>>Newest</option>
          <option value="oldest" <%= query.sort === "oldest" ? "selected" : "" %>>Oldest</option>
          <option value="total-high" <%= query.sort === "total-high" ? "selected" : "" %>>Total High</option>
          <option value="total-low" <%= query.sort === "total-low" ? "selected" : "" %>>Total Low</option>
        </select>
      </label>
    </div>

    <div class="admin-orders-filter-actions">
      <button type="submit">Apply Filters</button>
      <a href="/admin/orders">Clear</a>
    </div>
  </form>

  <% if (!orders || orders.length === 0) { %>
    <div class="admin-empty-state">
      <h2>No Orders Found</h2>
      <p>No orders match your current filters.</p>
    </div>
  <% } else { %>
    <div class="admin-orders-list-v2">
      <% orders.forEach(order => { %>
        <% const isClickCollect = order.fulfilment?.method === "click_collect"; %>

        <article class="admin-order-card-v2">
          <div class="admin-order-card-main">
            <div class="admin-order-card-head">
              <div>
                <span>Order #<%= orderShortId(order) %></span>
                <h2><%= [order.customer?.firstName, order.customer?.lastName].filter(Boolean).join(" ") || "Customer" %></h2>
                <p><%= order.customer?.email || "No email" %> · <%= order.customer?.phone || "No phone" %></p>
              </div>

              <div class="admin-order-card-total">
                <strong><%= money(order.total) %></strong>
                <span><%= new Date(order.createdAt).toLocaleString("en-GB") %></span>
              </div>
            </div>

            <div class="admin-order-card-badges">
              <span class="status-pill payment-<%= order.paymentStatus %>"><%= order.paymentStatus || "pending" %></span>
              <span class="status-pill order-<%= order.orderStatus %>"><%= order.orderStatus || "new" %></span>
              <span class="status-pill <%= isClickCollect ? 'payment-pending' : 'order-completed' %>">
                <%= isClickCollect ? "Click & Collect" : "Delivery" %>
              </span>
              <span class="status-pill <%= order.royalMail?.syncStatus === 'failed' ? 'payment-failed' : order.royalMail?.syncStatus === 'sent' ? 'order-completed' : 'payment-pending' %>">
                Royal Mail: <%= order.royalMail?.syncStatus || "not_sent" %>
              </span>
              <% if (order.discount?.code) { %>
                <span class="status-pill order-completed">Discount: <%= order.discount.code %></span>
              <% } %>
            </div>

            <div class="admin-order-items-mini">
              <% (order.items || []).slice(0, 3).forEach(item => { %>
                <div>
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="<%= item.name %>">
                  <% } %>
                  <span>
                    <strong><%= item.name %></strong>
                    <small>Qty: <%= item.quantity %> × <%= money(item.price) %></small>
                  </span>
                </div>
              <% }) %>

              <% if ((order.items || []).length > 3) { %>
                <small>+ <%= order.items.length - 3 %> more item(s)</small>
              <% } %>
            </div>
          </div>

          <div class="admin-order-card-side">
            <a class="admin-primary" href="/admin/orders/<%= order._id %>">View Details</a>

            <form class="admin-order-status-form compact" action="/admin/orders/<%= order._id %>/status" method="POST">
              <label>
                Payment
                <select name="paymentStatus">
                  <option value="pending" <%= order.paymentStatus === "pending" ? "selected" : "" %>>Pending</option>
                  <option value="paid" <%= order.paymentStatus === "paid" ? "selected" : "" %>>Paid</option>
                  <option value="failed" <%= order.paymentStatus === "failed" ? "selected" : "" %>>Failed</option>
                </select>
              </label>

              <label>
                Order
                <select name="orderStatus">
                  <option value="new" <%= order.orderStatus === "new" ? "selected" : "" %>>New</option>
                  <option value="processing" <%= order.orderStatus === "processing" ? "selected" : "" %>>Processing</option>
                  <option value="packed" <%= order.orderStatus === "packed" ? "selected" : "" %>>Packed</option>
                  <option value="shipped" <%= order.orderStatus === "shipped" ? "selected" : "" %>>Shipped</option>
                  <option value="completed" <%= order.orderStatus === "completed" ? "selected" : "" %>>Completed</option>
                  <option value="cancelled" <%= order.orderStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
                </select>
              </label>

              <button type="submit">Update</button>
            </form>

            <% if (!isClickCollect && order.royalMail?.syncStatus !== "sent") { %>
              <form action="/admin/orders/<%= order._id %>/send-royal-mail" method="POST">
                <button class="admin-secondary" type="submit">Send Royal Mail</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="admin-pagination">
      <% if (pagination.hasPrev) { %>
        <a href="/admin/orders?<%= buildQuery({ page: pagination.page - 1 }) %>">Previous</a>
      <% } %>

      <span>Page <%= pagination.page %> of <%= pagination.totalPages %> · <%= pagination.totalOrders %> result(s)</span>

      <% if (pagination.hasNext) { %>
        <a href="/admin/orders?<%= buildQuery({ page: pagination.page + 1 }) %>">Next</a>
      <% } %>
    </div>
  <% } %>
</section>
