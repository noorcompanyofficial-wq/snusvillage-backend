<section class="admin-page">
  <div class="admin-page-head">
    <div>
      <span>Users & Traders</span>
      <h1>Access Management</h1>
      <p>Review customer accounts, age verification status, trader access, and approved trader login records.</p>
    </div>
  </div>

  <div class="admin-dashboard-grid">
    <section class="admin-panel">
      <div class="admin-panel__head">
        <h2>Customers</h2>
        <span><%= users.length %> Account<%= users.length === 1 ? "" : "s" %></span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Verified</th>
              <th>Age</th>
              <th>Trader</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% if (users.length) { %>
              <% users.forEach((account) => { %>
                <tr>
                  <td>
                    <strong><%= [account.firstName, account.lastName].filter(Boolean).join(" ") || "User" %></strong>
                  </td>
                  <td><%= account.email %></td>
                  <td><%= account.role || "user" %></td>
                  <td>
                    <span class="status-pill <%= account.isVerified ? 'order-completed' : 'payment-pending' %>">
                      <%= account.isVerified ? "Yes" : "No" %>
                    </span>
                  </td>
                  <td>
                    <span class="status-pill <%= account.isAgeVerified ? 'order-completed' : 'payment-failed' %>">
                      <%= account.isAgeVerified ? "Verified" : "Not Verified" %>
                    </span>
                  </td>
                  <td><%= account.traderStatus || "none" %></td>
                  <td>
                    <a class="admin-table-action" href="/admin/users/<%= account._id %>">View</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="7">No users found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__head">
        <h2>Trader Logins</h2>
        <span><%= traders.length %> Trader<%= traders.length === 1 ? "" : "s" %></span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Business</th>
              <th>Email</th>
              <th>Status</th>
              <th>Last Login</th>
            </tr>
          </thead>

          <tbody>
            <% if (traders.length) { %>
              <% traders.forEach((trader) => { %>
                <tr>
                  <td><%= trader.businessName %></td>
                  <td><%= trader.email %></td>
                  <td>
                    <span class="status-pill <%= trader.status === 'approved' ? 'order-completed' : 'payment-pending' %>">
                      <%= trader.status %>
                    </span>
                  </td>
                  <td><%= trader.lastLoginAt ? trader.lastLoginAt.toLocaleString() : "Never" %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4">No trader logins found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</section>
