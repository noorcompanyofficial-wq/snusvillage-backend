<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snus Village</title>
    <meta
      name="description"
      content="Premium nicotine pouch and snus specialist with London stores, trusted brands, and fast UK delivery."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/logo/snus-village-lion-shield.png" />
    <link rel="stylesheet" href="/css/landing.css" />
  </head>
  <body>
    <div class="landing-age-modal" id="landingAgeModal">
      <div class="landing-age-box">
        <h2>Age Verification</h2>
        <p>You Must Be 18+ To Enter This Website.</p>
        <div class="landing-age-buttons">
          <button type="button" id="landingEnterSite">I Am Over 18</button>
          <button type="button" id="landingExitSite">I Am Under 18</button>
        </div>
      </div>
    </div>

    <%- include("../partials/header") %>

    <div class="page-shell">

      <main id="home">




        
        

        <section class="sv-simple-carousel-hero">
          <div class="sv-hero-inner">

            <div class="sv-carousel-wrap">
              <div class="sv-carousel">
                <div class="sv-slides">

                  <div class="sv-slide sv-slide-one">
                    <div class="sv-slide-brand">
                      <small>Featured Collection</small>
                      <h2>White Fox</h2>
                      <a href="/shop?brand=White%20Fox">Shop White Fox</a>
                    </div>
                  </div>

                  <div class="sv-slide sv-slide-two">
                    <div class="sv-slide-brand">
                      <small>Best Sellers</small>
                      <h2>Premium Brands</h2>
                      <a href="/shop">Browse Brands</a>
                    </div>
                  </div>

                  <div class="sv-slide sv-slide-three">
                    <div class="sv-slide-brand">
                      <small>London Retail</small>
                      <h2>Visit Our Stores</h2>
                      <a href="#shops">Find Branches</a>
                    </div>
                  </div>

                </div>

                <div class="sv-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>

          </div>
        </section>

        

        <section class="sv-brand-strip" aria-label="Available brands">
          <div class="sv-brand-strip__track">

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>
          </div>
        </section>

<section class="section sv-collections-redesign" id="collections">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark">Collections</span>
                <h2>Shop By Strength, Flavour, And Brand</h2>
                <p>Move Quickly From Your Preferred Flavour To The Strength, Brand, And Product Type That Fits Your Preference.</p>
              </div>
              <a class="ghost-btn" href="/shop">Open Shop</a>
            </div>

            <div class="sv-collection-grid-pro">
              <article class="sv-collection-card-pro sv-collection-card-pro--large" style="--bg-image:url('/images/social/s-1.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">01</span>
                  <h3>Mint Favourites</h3>
                  <p>Clean, Cool, And Reliable Flavour Profiles From Leading Nicotine Pouch Brands.</p>
                  <a class="sv-collection-link" href="/shop">Shop Mint</a>
                </div>
              </article>

              <article class="sv-collection-card-pro" style="--bg-image:url('/images/social/s-6.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">02</span>
                  <h3>Strong Selections</h3>
                  <p>Higher Strength Products For Adult Customers Who Know Exactly What They Want.</p>
                  <a class="sv-collection-link" href="/shop">Shop Strong</a>
                </div>
              </article>

              <article class="sv-collection-card-pro" style="--bg-image:url('/images/social/s-10.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">03</span>
                  <h3>Fruity Flavours</h3>
                  <p>Berry, Citrus, Cola, Tropical, And Sweet Profiles For A Brighter Choice.</p>
                  <a class="sv-collection-link" href="/shop">Shop Flavours</a>
                </div>
              </article>

              <article class="sv-collection-card-pro sv-collection-card-pro--dark">
                <div class="sv-collection-card-pro__glow"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">04</span>
                  <h3>Vape Range</h3>
                  <p>Explore Vape Products, New Arrivals, And Fast-Moving Stock From Snus Village.</p>
                  <a class="sv-collection-link" href="/shop">Shop Vape</a>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="section sv-bestsellers-redesign" id="bestsellers">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="eyebrow dark">Best Sellers</span>
                <h2>Customer Favourites</h2>
                <p>A Focused Selection Of The Products And Brands That Move Fastest In Store And Online.</p>
              </div>
              <a class="ghost-btn" href="/shop">View All Products</a>
            </div>

            <div class="product-grid sv-product-grid-pro">
              <article class="product-card sv-product-card-pro">
                <div class="product-card__media"><img src="/images/shop/wf-1.png" alt="White Fox product" /></div>
                <div class="product-card__top"><span class="product-card__tag">White Fox</span><span class="product-card__tag">Strong</span></div>
                <h3>White Fox Range</h3>
                <p>Popular Mint-Led Cans With A Clean Profile And Strong Customer Demand.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="sv-product-card-btn" href="/shop">View Range</a></div>
              </article>

              <article class="product-card sv-product-card-pro">
                <div class="product-card__media"><img src="/images/shop/pablo-1.png" alt="Pablo product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Pablo</span><span class="product-card__tag">Extreme</span></div>
                <h3>Pablo Range</h3>
                <p>High Strength Cans With Bold Flavours For Experienced Adult Users.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="sv-product-card-btn" href="/shop">View Range</a></div>
              </article>

              <article class="product-card sv-product-card-pro">
                <div class="product-card__media"><img src="/images/shop/velo-1.webp" alt="Velo product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Velo</span><span class="product-card__tag">Smooth</span></div>
                <h3>Velo Range</h3>
                <p>Everyday Pouches With Familiar Flavours And Balanced Strength Options.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="sv-product-card-btn" href="/shop">View Range</a></div>
              </article>

              <article class="product-card sv-product-card-pro">
                <div class="product-card__media"><img src="/images/shop/loop-1.webp" alt="Loop product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Loop</span><span class="product-card__tag">Flavour</span></div>
                <h3>Loop Range</h3>
                <p>Modern Pouch Flavours With Clean Packaging And Reliable Popularity.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span></span><span></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="sv-product-card-btn" href="/shop">View Range</a></div>
              </article>
            </div>
          </div>
        </section>

        <section class="section sv-locations-redesign" id="shops">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark">Location</span>
                <h2>Find Snus Village In London</h2>
                <p>Visit One Of Our London Locations Or Contact The Team Before You Travel For Stock Questions.</p>
              </div>
              <a class="ghost-btn" href="/contact">Contact Us</a>
            </div>

            <div class="sv-location-grid">
              <article class="sv-location-card">
                <iframe class="sv-location-map" loading="lazy" src="https://www.google.com/maps?q=Camden+Town+London&output=embed" title="Camden Town"></iframe>
                <div class="sv-location-body">
                  <span>London Branch</span>
                  <h3>Camden Town</h3>
                  <p>Central North London Access With A Strong Range Of Best-Selling Products.</p>
                  <a href="/contact">Ask About Stock</a>
                </div>
              </article>

              <article class="sv-location-card">
                <iframe class="sv-location-map" loading="lazy" src="https://www.google.com/maps?q=Oxford+Street+London&output=embed" title="Oxford Street"></iframe>
                <div class="sv-location-body">
                  <span>London Branch</span>
                  <h3>Oxford Street</h3>
                  <p>Easy Access For Shoppers Near One Of London’s Busiest Retail Destinations.</p>
                  <a href="/contact">Ask About Stock</a>
                </div>
              </article>

              <article class="sv-location-card">
                <iframe class="sv-location-map" loading="lazy" src="https://www.google.com/maps?q=Edgware+Road+London&output=embed" title="Edgware Road"></iframe>
                <div class="sv-location-body">
                  <span>London Branch</span>
                  <h3>Edgware Road</h3>
                  <p>Convenient West London Area For Quick Visits And Product Enquiries.</p>
                  <a href="/contact">Ask About Stock</a>
                </div>
              </article>
            </div>

            <article class="sv-distro-card">
              <div class="sv-distro-copy">
                <span class="sv-distro-kicker">Distribution Hub</span>
                <h3>SVG Distro</h3>
                <p class="sv-distro-address">Snus Village Charles House, Southall</p>
                <p>
                  Our Southall Location Supports Stock Availability, Trade Enquiries, Local Distribution, And Product Support For Adult Customers And Approved Traders.
                </p>

                <div class="sv-distro-badges">
                  <span>Stock Support</span>
                  <span>Trade Enquiries</span>
                  <span>Southall</span>
                  <span>18+ Only</span>
                </div>

                <a href="/contact" class="sv-ab-btn sv-ab-btn--primary">Contact For Details</a>
              </div>

              <div class="sv-distro-carousel" id="svgDistroCarousel">

                <div class="sv-distro-track">
                  <img src="/images/header/h-1.jpeg" alt="SVG Distro Southall Location Image 1" class="is-active" />
                  <img src="/images/header/h-2.jpeg" alt="SVG Distro Southall Location Image 2" />
                  <img src="/images/delivery/delivery.jpg" alt="SVG Distro Southall Location Image 3" />
                </div>

                <div class="sv-distro-controls">
                  <button type="button" class="sv-distro-prev" aria-label="Previous Location Image">‹</button>
                  <button type="button" class="sv-distro-next" aria-label="Next Location Image">›</button>
                </div>

                <div class="sv-distro-dots">
                  <button type="button" class="is-active" aria-label="Show Location Image 1"></button>
                  <button type="button" aria-label="Show Location Image 2"></button>
                  <button type="button" aria-label="Show Location Image 3"></button>
                </div>
              </div>
            </article>
          </div>
        </section>

        <%
          const svSocial = homepageContent?.social || {};
          const svSocialSlides = svSocial.slides && svSocial.slides.length
            ? svSocial.slides
            : [
                {
                  videoSrc: "/videos/social/social-1.mp4",
                  posterSrc: "/images/header/h-1.jpeg",
                  title: "New Stock Arrival",
                  subtitle: "Latest Product Highlights From Snus Village",
                },
                {
                  videoSrc: "/videos/social/social-2.mp4",
                  posterSrc: "/images/header/h-2.jpeg",
                  title: "In-Store Content",
                  subtitle: "Store Moments, Promotions, And Customer Favourites",
                },
                {
                  videoSrc: "/videos/social/social-3.mp4",
                  posterSrc: "/images/delivery/delivery.jpg",
                  title: "London Updates",
                  subtitle: "See What Is Happening Across Our Locations",
                },
              ];
        %>

        <section class="section sv-social-showcase" id="social-showcase">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark"><%= svSocial.eyebrow || "Social Media" %></span>
                <h2><%= svSocial.heading || "See Snus Village In Action" %></h2>
                <p>
                  <%= svSocial.description || "Follow Our Latest Product Drops, In-Store Moments, Promotions, And London Updates Through Our Social Content." %>
                </p>
              </div>

              <a class="ghost-btn" href="<%= svSocial.instagramUrl || 'https://www.instagram.com/snusvillage.uk/' %>" target="_blank" rel="noopener noreferrer">
                Follow Instagram
              </a>
            </div>

            <div class="sv-social-iphone-grid">
              <div class="sv-social-copy-card">
                <span class="pill">Snus Village UK</span>
                <h3><%= svSocial.cardTitle || "Follow Our Socials" %></h3>
                <p>
                  <%= svSocial.cardText || "Discover New Stock, Best Sellers, Promotions, Branch Updates, And Behind-The-Scenes Clips From Snus Village." %>
                </p>

                <div class="sv-social-points">
                  <div class="sv-social-point">
                    <strong>New Stock</strong>
                    <span>See Fresh Arrivals And Best-Selling Products.</span>
                  </div>

                  <div class="sv-social-point">
                    <strong>Store Updates</strong>
                    <span>Follow What Is Happening Across Our London Locations.</span>
                  </div>

                  <div class="sv-social-point">
                    <strong>Promotions</strong>
                    <span>Spot Limited Offers, Events, And Featured Drops.</span>
                  </div>
                </div>

                <div class="sv-social-links">
                  <a href="<%= svSocial.instagramUrl || 'https://www.instagram.com/snusvillage.uk/' %>" target="_blank" rel="noopener noreferrer" class="sv-ab-btn sv-ab-btn--primary">
                    Open Instagram
                  </a>

                  <a href="/contact" class="sv-ab-btn sv-ab-btn--ghost">
                    Contact Us
                  </a>
                </div>
              </div>

              <div class="sv-phone-wrap">
                <div class="sv-phone">
                  <div class="sv-phone__notch"></div>

                  <div class="sv-phone__screen">
                    <div class="sv-ig-top">
                      <div class="sv-ig-profile">
                        <div class="sv-ig-avatar">
                          <img src="/images/logo/snus-village-lion-shield.png" alt="Snus Village" />
                        </div>

                        <div>
                          <strong>snusvillage.uk</strong>
                          <span>Snus Village</span>
                        </div>
                      </div>

                      <div class="sv-ig-live">REELS</div>
                    </div>

                    <div class="sv-ig-stories">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>

                    <div class="sv-social-reel" id="svSocialReel">
                      <% svSocialSlides.slice(0, 3).forEach((slide, index) => { %>
                        <div class="sv-social-slide <%= index === 0 ? 'is-active' : '' %>">
                          <video
                            src="<%= slide.videoSrc %>"
                            muted
                            <%= index === 0 ? 'autoplay' : '' %>
                            loop
                            playsinline
                            poster="<%= slide.posterSrc || '/images/header/h-1.jpeg' %>"
                          ></video>
                          <div class="sv-social-caption">
                            <strong><%= slide.title || 'Snus Village Update' %></strong>
                            <span><%= slide.subtitle || 'Latest Content From Snus Village' %></span>
                          </div>
                        </div>
                      <% }) %>
                    </div>

                    <div class="sv-social-controls">
                      <button type="button" class="sv-social-arrow sv-social-prev" aria-label="Previous Social Slide">‹</button>

                      <div class="sv-social-dots">
                        <button type="button" class="is-active" aria-label="Go To Slide 1"></button>
                        <button type="button" aria-label="Go To Slide 2"></button>
                        <button type="button" aria-label="Go To Slide 3"></button>
                      </div>

                      <button type="button" class="sv-social-arrow sv-social-next" aria-label="Next Social Slide">›</button>
                    </div>

                    <div class="sv-ig-bottom">
                      <span></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section sv-trust-redesign" id="info">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark">Why Snus Village</span>
                <h2>Built For Reliable Adult Shopping</h2>
                <p>Clear Service, Authentic Stock, London Retail Support, And A Safer Checkout Flow For Adult Customers.</p>
              </div>
              <a class="ghost-btn" href="/contact">Get Support</a>
            </div>

            <div class="sv-trust-grid">
              <article class="sv-trust-card sv-trust-card--dark">
                <span class="sv-trust-icon">18+</span>
                <h3>Adults Only</h3>
                <p>Age-Restricted Products For Adult Customers Only, With Clear 18+ Messaging Across The Website.</p>
              </article>

              <article class="sv-trust-card">
                <span class="sv-trust-icon">✓</span>
                <h3>Authentic Brands</h3>
                <p>Focused On Trusted Snus, Vape, And Nicotine Pouch Brands Customers Ask For In Store.</p>
              </article>

              <article class="sv-trust-card">
                <span class="sv-trust-icon">UK</span>
                <h3>Fast UK Delivery</h3>
                <p>Online Orders Are Built Around A Simple Basket, Checkout, And Manual Fulfilment Workflow.</p>
              </article>

              <article class="sv-trust-card">
                <span class="sv-trust-icon">LDN</span>
                <h3>London Retail Support</h3>
                <p>Customers Can Contact The Team For Store, Stock, Delivery, Or Product Availability Questions.</p>
              </article>

              <article class="sv-trust-card">
                <span class="sv-trust-icon">B2B</span>
                <h3>Wholesale Access</h3>
                <p>Approved Traders Can Apply For Dedicated Wholesale Access And A Separate Trader Login.</p>
              </article>

              <article class="sv-trust-card sv-trust-card--accent">
                <span class="sv-trust-icon">🔒</span>
                <h3>Secure Checkout</h3>
                <p>Checkout Includes Age Confirmation, Order Confirmation, Admin Order Review, And Status Updates.</p>
              </article>
            </div>
          </div>
        </section>
      </main>

      <footer class="sv-natural-footer" id="footer">
        <div class="container">
          <div class="sv-natural-footer__top">
            <div class="sv-natural-footer__brand">
              <div class="brand">
                <img class="brand__logo" src="/images/logo/snus-village-lion-shield.png" alt="Snus Village" />
                <span class="brand__text">
                  <strong>Snus Village</strong>
                  <span>London's Premium Snus Store</span>
                </span>
              </div>

              <p>
                Premium Nicotine Pouch, Snus, And Vape Specialist With Trusted Brands, London Locations, Wholesale Support, And Fast UK Delivery.
              </p>


            </div>

            <div class="sv-natural-footer__links">
              <h4>Shop</h4>
              <a href="/shop">All Products</a>
              <a href="#bestsellers">Best Sellers</a>
              <a href="#collections">Collections</a>
              <a href="/wholesale">Wholesale</a>
            </div>

            <div class="sv-natural-footer__links">
              <h4>Locations</h4>
              <a href="#shops">Camden Town</a>
              <a href="#shops">Oxford Street</a>
              <a href="#shops">Edgware Road</a>
              <a href="#shops">SVG Distro</a>
            </div>

            <div class="sv-natural-footer__links">
              <h4>Contact</h4>
              <a href="/shop?flavour=mint">Flavours</a>
            <a href="/#reviews">Reviews</a>
              <a href="mailto:info@snusvillage.co.uk">info@snusvillage.co.uk</a>
              <a href="tel:+447777222771">+44 7777 222771</a>
              <a href="<%= svSocial.instagramUrl || 'https://www.instagram.com/snusvillage.uk/' %>">Instagram</a>
            </div>
          </div>

          <div class="sv-natural-footer__warning">
            Products On This Website Are Age Restricted And Intended Only For Customers Aged 18 Or Over.
          </div>

          <div class="sv-natural-footer__bottom">
            <span>© 2026 Snus Village. All Rights Reserved.</span>
            <span>Premium Brands • London Locations • Fast UK Delivery</span>
          </div>
        </div>
      </footer>

    <script src="/js/landing.js"></script>
  </body>
</html>
