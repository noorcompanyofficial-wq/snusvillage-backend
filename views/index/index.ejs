    <script>
      (function () {
        var ageModal = document.getElementById("ageModal");
        var enterBtn = document.getElementById("enterSite");
        var exitBtn  = document.getElementById("exitSite");
        var ageDob   = document.getElementById("ageDob");
        var ageError = document.getElementById("ageError");
        var AGE_KEY  = "sv_age_verified";
        var AGE_TTL  = 24 * 60 * 60 * 1000;
        var promoPopup = document.getElementById("promoPopup");
        var promoPopupClose = document.getElementById("promoPopupClose");
        var promoPopupCode = document.getElementById("promoPopupCode");
        var PROMO_SEEN_KEY = "sv_promo_seen";

        function isAgeVerified() {
          try {
            var raw = localStorage.getItem(AGE_KEY);
            if (!raw) return false;
            var obj = JSON.parse(raw);
            return obj.verified === true && Date.now() < obj.expires;
          } catch(e) { return false; }
        }

        function setAgeVerified() {
          localStorage.setItem(AGE_KEY, JSON.stringify({ verified: true, expires: Date.now() + AGE_TTL }));
        }

        function clearAgeVerified() { localStorage.removeItem(AGE_KEY); }

        function isAdultFromDob(value) {
          if (!value) return false;
          var dob = new Date(value + "T00:00:00");
          if (Number.isNaN(dob.getTime())) return false;
          var today = new Date();
          var age = today.getFullYear() - dob.getFullYear();
          var md = today.getMonth() - dob.getMonth();
          if (md < 0 || (md === 0 && today.getDate() < dob.getDate())) age -= 1;
          return age >= 18;
        }

        function hasValidDob(value) {
          return value && !Number.isNaN(new Date(value + "T00:00:00").getTime());
        }

        function hideAgeGate() {
          if (!ageModal) return;
          ageModal.classList.remove("is-visible");
          ageModal.setAttribute("aria-hidden", "true");
          document.body.classList.remove("age-modal-open");
        }

        function showAgeGate() {
          if (!ageModal) return;
          ageModal.classList.add("is-visible");
          ageModal.setAttribute("aria-hidden", "false");
          document.body.classList.add("age-modal-open");
        }

        /* Allow ?age=reset to force gate (testing) */
        if (new URLSearchParams(window.location.search).get("age") === "reset") clearAgeVerified();

        if (isAgeVerified()) { hideAgeGate(); schedulePromoPopup(); } else { showAgeGate(); }

        if (enterBtn) enterBtn.addEventListener("click", function () {
          var dob = (ageDob && ageDob.value) || "";
          if (!hasValidDob(dob)) {
            if (ageError) ageError.textContent = "Please enter a valid date of birth.";
            if (ageDob) ageDob.focus();
            return;
          }
          if (!isAdultFromDob(dob)) {
            if (ageError) ageError.textContent = "You must be 18 or over. Redirecting…";
            clearAgeVerified();
            setTimeout(function() { window.location.href = "https://www.google.com"; }, 1800);
            return;
          }
          setAgeVerified();
          hideAgeGate();
          schedulePromoPopup();
        });

        if (exitBtn) exitBtn.addEventListener("click", function () {
          clearAgeVerified();
          window.location.href = "https://www.google.com";
        });

        if (ageDob) ageDob.addEventListener("input", function () {
          if (ageError) ageError.textContent = "";
        });

        /* ── Welcome Discount Popup — shows N seconds after age verification ── */
        function schedulePromoPopup() {
          if (!promoPopup) return;

          var verifiedAt;
          try {
            var ageObj = JSON.parse(localStorage.getItem(AGE_KEY));
            verifiedAt = ageObj.expires - AGE_TTL;
          } catch (e) {
            return;
          }
          if (!verifiedAt) return;

          try {
            var seen = JSON.parse(localStorage.getItem(PROMO_SEEN_KEY));
            if (seen && Date.now() < seen.expires) return;
          } catch (e) {
            /* no valid seen record, continue */
          }

          var delaySeconds = Number(promoPopup.dataset.delaySeconds || 20);
          var remaining = Math.max(0, verifiedAt + delaySeconds * 1000 - Date.now());
          setTimeout(showPromoPopup, remaining);
        }

        function showPromoPopup() {
          if (!promoPopup || (ageModal && ageModal.classList.contains("is-visible"))) return;

          promoPopup.hidden = false;
          requestAnimationFrame(function () { promoPopup.classList.add("is-visible"); });
          promoPopup.setAttribute("aria-hidden", "false");

          var expires = Date.now() + AGE_TTL;
          try {
            expires = JSON.parse(localStorage.getItem(AGE_KEY)).expires || expires;
          } catch (e) {
            /* keep default */
          }
          localStorage.setItem(PROMO_SEEN_KEY, JSON.stringify({ seen: true, expires: expires }));
        }

        function hidePromoPopup() {
          if (!promoPopup) return;
          promoPopup.classList.remove("is-visible");
          promoPopup.setAttribute("aria-hidden", "true");
          setTimeout(function () { promoPopup.hidden = true; }, 350);
        }

        if (promoPopupClose) promoPopupClose.addEventListener("click", hidePromoPopup);

        if (promoPopupCode) promoPopupCode.addEventListener("click", function () {
          var codeSpan = this.querySelector("span");
          var codeText = codeSpan ? codeSpan.textContent.trim() : "";
          if (!codeText || !navigator.clipboard || !navigator.clipboard.writeText) return;

          var self = this;
          navigator.clipboard.writeText(codeText).then(function () {
            self.classList.add("is-copied");
            setTimeout(function () { self.classList.remove("is-copied"); }, 2000);
          }).catch(function () {});
        });
      })();
    </script>

    <script>
      (function () {
        var DURATION = 5000;
        var slidesWrap = document.getElementById('heroCarousel');
        if (!slidesWrap) return;
        var slides = Array.from(slidesWrap.querySelectorAll('.v4-hero__slide'));
        var thumbs = Array.from(document.querySelectorAll('.v4-hero__thumb'));
        var numEl  = document.getElementById('heroCounterNum');
        var prevBtn = document.getElementById('heroPrevBtn');
        var nextBtn = document.getElementById('heroNextBtn');
        var heroEl = document.querySelector('.v4-hero');
        if (slides.length < 2) return;

        var current = 0;
        var timer = null;

        function resetFill(thumb) {
          var f = thumb.querySelector('.v4-hero__thumb-fill');
          if (!f) return;
          f.style.transition = 'none';
          f.style.width = '0%';
        }
        function startFill(thumb) {
          var f = thumb.querySelector('.v4-hero__thumb-fill');
          if (!f) return;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              f.style.transition = 'width ' + DURATION + 'ms linear';
              f.style.width = '100%';
            });
          });
        }

        function goTo(index) {
          slides[current].classList.remove('is-active');
          if (thumbs[current]) {
            thumbs[current].classList.remove('is-active');
            resetFill(thumbs[current]);
          }
          current = ((index % slides.length) + slides.length) % slides.length;
          slides[current].classList.add('is-active');
          if (thumbs[current]) {
            thumbs[current].classList.add('is-active');
            startFill(thumbs[current]);
          }
          if (numEl) numEl.textContent = current + 1;
        }

        function startAuto() {
          clearInterval(timer);
          timer = setInterval(function () { goTo(current + 1); }, DURATION);
        }

        thumbs.forEach(function (thumb, i) {
          thumb.addEventListener('click', function () { goTo(i); startAuto(); });
        });
        if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); startAuto(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); startAuto(); });

        if (heroEl) {
          heroEl.addEventListener('mouseenter', function () { clearInterval(timer); });
          heroEl.addEventListener('mouseleave', startAuto);
        }

        if (thumbs[0]) startFill(thumbs[0]);
        startAuto();
      })();
    </script>

  </body>
