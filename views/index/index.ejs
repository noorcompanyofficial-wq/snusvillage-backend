<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snus Village | Premium Nicotine Pouches UK</title>
    <meta
      name="description"
      content="Shop premium nicotine pouches in the UK from Snus Village London with UK delivery and age-verified service for adult customers."
    />
    <link rel="canonical" href="https://www.snusvillage.com/" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Snus Village",
        "url": "https://www.snusvillage.com",
        "description": "UK smokeless nicotine retailer offering premium nicotine pouches and smoke-free alternatives for adult customers.",
        "areaServed": ["United Kingdom", "London"],
        "sameAs": [
          "https://www.instagram.com/snusvillage.uk/",
          "https://www.youtube.com/@SnusVillage"
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "89 Edgware Road",
          "addressLocality": "London",
          "postalCode": "W2 2HX",
          "addressCountry": "GB"
        }
      }
    </script>
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" href="/images/logo/snus-village-logo.webp" />
    <link rel="stylesheet" href="/css/age-gate.css" />
    <link rel="stylesheet" href="/css/landing.css" />
    <link
      rel="preload"
      href="/css/footer.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/css/footer.css" /></noscript>
  </head>
  <body class="age-modal-open">

    <%- include("../partials/header") %>

    <div class="page-shell">

      <main id="home">




        
        

        <%
          const svHeroSlides = homepageContent?.hero?.slides?.length
            ? homepageContent.hero.slides
            : [
                {
                  kicker: "Premium Nicotine Pouches",
                  title: "White Fox",
                  buttonText: "Shop Nicotine Pouches",
                  buttonLink: "/shop?brand=White%20Fox",
                  imageSrc: "/images/header/h-1.jpeg",
                },
                {
                  kicker: "Trusted Nicotine Pouch Brands",
                  title: "Best Sellers",
                  buttonText: "Browse Brands",
                  buttonLink: "/shop",
                  imageSrc: "/images/header/h-2.webp",
                },
                {
                  kicker: "Snus Village London",
                  title: "Visit Our Stores",
                  buttonText: "Find Branches",
                  buttonLink: "#shops",
                  imageSrc: "/images/delivery/delivery.webp",
                },
              ];
        %>

        <section class="sv-simple-carousel-hero">
          <div class="sv-hero-inner">
            <div class="sv-carousel-wrap">
              <div class="sv-carousel">
                <div class="sv-slides">
                  <% svHeroSlides.slice(0, 3).forEach((slide, index) => { %>
                    <div class="sv-slide">
                      <img
                        class="sv-slide__image"
                        src="<%= optimiseImageUrl(slide.imageSrc || '/images/header/h-1.jpeg', { width: 1600, quality: 'auto:best' }) %>"
                        alt="<%= ['Snus Village premium nicotine pouches UK', 'Smokeless nicotine products at Snus Village', 'Nicotine pouch store in London'][index] || 'Snus Village nicotine pouch retailer UK' %>"
                        loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                        decoding="async"
                        fetchpriority="<%= index === 0 ? 'high' : 'auto' %>"
                      >
                      <div class="sv-slide-brand">
                        <small><%= slide.kicker || "Snus Village" %></small>
                        <h2><%= slide.title || "Premium Brands" %></h2>
                        <a href="<%= slide.buttonLink || '/shop' %>"><%= slide.buttonText || "Shop Now" %></a>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <div class="sv-dots">
                  <% svHeroSlides.slice(0, 3).forEach(() => { %>
                    <span></span>
                  <% }) %>
                </div>
              </div>
            </div>

          </div>
        </section>

        <section class="sv-brand-strip" aria-label="Available brands">
          <div class="sv-brand-strip__track">

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>

            <span>White Fox</span>
            <span>Siberia</span>
            <span>Cuba</span>
            <span>Pablo</span>
            <span>Velo</span>
            <span>Killa</span>
            <span>Garant</span>
            <span>Iceberg</span>
            <span>Fumi</span>
            <span>Zyn</span>
          </div>
        </section>

<%
          const svCollections = homepageContent?.collections || {};
          const svCollectionCards = svCollections.cards && svCollections.cards.length
            ? svCollections.cards
            : [
                {
                  number: "01",
                  title: "Mint Favourites",
                  text: "Clean, Cool, And Reliable Flavour Profiles From Leading Nicotine Pouch Brands.",
                  linkText: "Shop Mint",
                  linkUrl: "/shop?flavour=mint",
                  imageSrc: "/images/social/s-1.jpeg",
                  darkCard: false,
                },
                {
                  number: "02",
                  title: "Strong Selections",
                  text: "Higher Strength Products For Adult Customers Who Know Exactly What They Want.",
                  linkText: "Shop Strong",
                  linkUrl: "/shop?strength=STRONG",
                  imageSrc: "/images/social/s-6.jpeg",
                  darkCard: false,
                },
                {
                  number: "03",
                  title: "Fruity Flavours",
                  text: "Berry, Citrus, Cola, Tropical, And Sweet Profiles For A Brighter Choice.",
                  linkText: "Shop Flavours",
                  linkUrl: "/shop",
                  imageSrc: "/images/social/s-10.jpeg",
                  darkCard: false,
                },
                {
                  number: "04",
                  title: "Tobacco-Free Pouches",
                  text: "Explore Tobacco-Free Nicotine Pouches And Modern Nicotine Alternatives For Adult Customers.",
                  linkText: "Shop Pouches",
                  linkUrl: "/shop?category=Nicotine%20Pouches",
                  imageSrc: "/images/social/s-4.jpeg",
                  darkCard: false,
                },
              ];
        %>

        <section class="section sv-collections-redesign" id="collections">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark"><%= svCollections.eyebrow || "Collections" %></span>
                <h2><%= svCollections.heading || "Shop By Strength, Flavour, And Brand" %></h2>
                <p><%= svCollections.description || "Move Quickly From Your Preferred Flavour To The Strength, Brand, And Product Type That Fits Your Preference." %></p>
              </div>
              <a class="ghost-btn" href="<%= svCollections.buttonLink || '/shop' %>"><%= svCollections.buttonText || "Open Shop" %></a>
            </div>

            <div class="sv-collection-grid-pro">
              <%
                const unavailableCategoryPath = "/collections/" + "va" + "pes";
                const visibleCollectionCards = svCollectionCards
                  .filter((card) => !String(card.linkUrl || "").includes(unavailableCategoryPath))
                  .slice(0, 4);
              %>
              <% visibleCollectionCards.forEach((card, index) => { %>
                <article
                  class="sv-collection-card-pro <%= index === 0 ? 'sv-collection-card-pro--large' : '' %> <%= card.darkCard ? 'sv-collection-card-pro--dark' : '' %>"
                  <% if (!card.darkCard) { %>
                    style="--bg-image:url('<%= optimiseImageUrl(card.imageSrc || '/images/social/s-1.jpeg', { width: 1200 }) %>');"
                  <% } %>
                >
                  <% if (card.darkCard) { %>
                    <div class="sv-collection-card-pro__glow"></div>
                  <% } else { %>
                    <div class="sv-collection-card-pro__shade"></div>
                  <% } %>

                  <div class="sv-collection-card-pro__content">
                    <span class="sv-collection-number"><%= card.number || ('0' + (index + 1)) %></span>
                    <h3><%= card.title || 'Collection' %></h3>
                    <p><%= card.text || '' %></p>
                    <a class="sv-collection-link" href="<%= card.linkUrl || '/shop' %>"><%= card.linkText || 'Open' %></a>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        </section>

        <section class="section sv-bestsellers-redesign" id="bestsellers">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="eyebrow dark">Best Sellers</span>
                <h2>Customer Favourites</h2>
                <p>A focused selection of popular products customers keep coming back for.</p>
              </div>
              <a class="ghost-btn" href="/shop">View All Products</a>
            </div>

            <% if (bestSellerProducts && bestSellerProducts.length) { %>
              <div class="product-grid sv-product-grid-pro">
                <% bestSellerProducts.forEach((p) => { %>
                  <% const finalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price; %>

                  <article class="product-card sv-product-card-pro">
                    <% if (p.showSaleBadge && p.discountPrice && p.discountPrice > 0) { %>
                      <span class="sv-product-sale-badge">Sale</span>
                    <% } %>

                    <div class="product-card__media">
                      <% if (p.images && p.images.length) { %>
                        <img src="<%= optimiseImageUrl(p.images[0], { width: 560 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async" />
                      <% } else { %>
                        <span>No Image</span>
                      <% } %>
                    </div>

                    <div class="product-card__top">
                      <span class="product-card__tag"><%= p.brand || "Snus Village" %></span>
                      <span class="product-card__tag"><%= p.strength || "Strength" %></span>
                    </div>

                    <h3><%= p.name %></h3>

                    <p>
                      <%= p.description ? p.description.substring(0, 92) : "Premium Product From Snus Village." %><%= p.description && p.description.length > 92 ? "..." : "" %>
                    </p>

                    <div class="strength">
                      <span class="<%= ['LOW','MEDIUM','STRONG','X-STRONG','EXTREME'].indexOf(p.strength) >= 0 ? 'is-on' : '' %>"></span>
                      <span class="<%= ['MEDIUM','STRONG','X-STRONG','EXTREME'].includes(p.strength) ? 'is-on' : '' %>"></span>
                      <span class="<%= ['STRONG','X-STRONG','EXTREME'].includes(p.strength) ? 'is-on' : '' %>"></span>
                      <span class="<%= ['X-STRONG','EXTREME'].includes(p.strength) ? 'is-on' : '' %>"></span>
                      <span class="<%= p.strength === 'EXTREME' ? 'is-on' : '' %>"></span>
                    </div>

                    <div class="product-card__price">
                      <strong>
                        <% if (p.discountPrice && p.discountPrice > 0) { %>
                          <small>£<%= Number(p.price || 0).toFixed(2) %></small>
                        <% } %>
                        £<%= Number(finalPrice || 0).toFixed(2) %>
                      </strong>
                      <a class="sv-product-card-btn" href="/products/<%= p.slug || p._id %>">View Product</a>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="sv-dynamic-empty">
                <h3>No best sellers selected yet</h3>
                <p>Our best-selling products will appear here soon.</p>
                <a href="/shop">View Shop</a>
              </div>
            <% } %>
          </div>
        </section>

        <% if (featuredProducts && featuredProducts.length) { %>
          <section class="section sv-featured-products-redesign" id="featured-products">
            <div class="container">
              <div class="section-head">
                <div>
                  <span class="eyebrow dark">Featured Products</span>
                  <h2>Featured From Admin</h2>
                  <p>Products selected from the admin panel for extra homepage visibility.</p>
                </div>
                <a class="ghost-btn" href="/shop">Shop Featured</a>
              </div>

              <div class="product-grid sv-product-grid-pro">
                <% featuredProducts.forEach((p) => { %>
                  <% const finalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price; %>

                  <article class="product-card sv-product-card-pro">
                    <% if (p.showSaleBadge && p.discountPrice && p.discountPrice > 0) { %>
                      <span class="sv-product-sale-badge">Sale</span>
                    <% } %>

                    <div class="product-card__media">
                      <% if (p.images && p.images.length) { %>
                        <img src="<%= optimiseImageUrl(p.images[0], { width: 560 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async" />
                      <% } else { %>
                        <span>No Image</span>
                      <% } %>
                    </div>

                    <div class="product-card__top">
                      <span class="product-card__tag"><%= p.brand || "Snus Village" %></span>
                      <span class="product-card__tag"><%= p.strength || "Strength" %></span>
                    </div>

                    <h3><%= p.name %></h3>

                    <p>
                      <%= p.description ? p.description.substring(0, 92) : "Premium Product From Snus Village." %><%= p.description && p.description.length > 92 ? "..." : "" %>
                    </p>

                    <div class="product-card__price">
                      <strong>
                        <% if (p.discountPrice && p.discountPrice > 0) { %>
                          <small>£<%= Number(p.price || 0).toFixed(2) %></small>
                        <% } %>
                        £<%= Number(finalPrice || 0).toFixed(2) %>
                      </strong>
                      <a class="sv-product-card-btn" href="/products/<%= p.slug || p._id %>">View Product</a>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          </section>
        <% } %>

        <%
          const svLocations = homepageContent?.locations || {};
          const svLocationCards = svLocations.cards && svLocations.cards.length
            ? svLocations.cards
            : [
                {
                  label: "London Branch",
                  title: "Camden Town",
                  description: "Central North London Access With A Strong Range Of Best-Selling Products.",
                  mapUrl: "https://www.google.com/maps?q=Camden+Town+London&output=embed",
                  mapTitle: "Camden Town",
                  buttonText: "Ask About Stock",
                  buttonLink: "/contact",
                },
                {
                  label: "London Branch",
                  title: "Oxford Street",
                  description: "Easy Access For Shoppers Near One Of London’s Busiest Retail Destinations.",
                  mapUrl: "https://www.google.com/maps?q=Oxford+Street+London&output=embed",
                  mapTitle: "Oxford Street",
                  buttonText: "Ask About Stock",
                  buttonLink: "/contact",
                },
                {
                  label: "London Branch",
                  title: "Edgware Road",
                  description: "Convenient West London Area For Quick Visits And Product Enquiries.",
                  mapUrl: "https://www.google.com/maps?q=Edgware+Road+London&output=embed",
                  mapTitle: "Edgware Road",
                  buttonText: "Ask About Stock",
                  buttonLink: "/contact",
                },
              ];
        %>

        <section class="section sv-locations-redesign" id="shops">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark"><%= svLocations.eyebrow || "Location" %></span>
                <h2><%= svLocations.heading || "Find Snus Village In London" %></h2>
                <p><%= svLocations.description || "Visit One Of Our London Locations Or Contact The Team Before You Travel For Stock Questions." %></p>
              </div>
              <a class="ghost-btn" href="<%= svLocations.buttonLink || '/contact' %>"><%= svLocations.buttonText || "Contact Us" %></a>
            </div>

            <div class="sv-location-grid">
              <% svLocationCards.slice(0, 3).forEach((location) => { %>
                <article class="sv-location-card">
                  <iframe
                    class="sv-location-map"
                    loading="lazy"
                    src="<%= location.mapUrl || 'https://www.google.com/maps?q=London&output=embed' %>"
                    title="<%= location.mapTitle || location.title || 'Snus Village Location' %>"
                  ></iframe>

                  <div class="sv-location-body">
                    <span><%= location.label || "London Branch" %></span>
                    <h3><%= location.title || "Snus Village" %></h3>
                    <p><%= location.description || "" %></p>
                    <a href="<%= location.buttonLink || '/contact' %>"><%= location.buttonText || "Ask About Stock" %></a>
                  </div>
                </article>
              <% }) %>
            </div>

            <%
              const svDistro = homepageContent?.distro || {};
              const svDistroImages = svDistro.images && svDistro.images.length
                ? svDistro.images
                : [
                    { imageSrc: "/images/header/h-1.jpeg", alt: "Snus Village premium nicotine pouches UK" },
                    { imageSrc: "/images/header/h-2.webp", alt: "Tobacco-free nicotine pouches for adult customers" },
                    { imageSrc: "/images/delivery/delivery.webp", alt: "Smoke-free alternatives from Snus Village London" },
                  ];
              const svDistroBadges = svDistro.badges && svDistro.badges.length
                ? svDistro.badges
                : ["Stock Support", "Trade Enquiries", "Southall", "18+ Only"];
            %>

            <article class="sv-distro-card">
              <div class="sv-distro-copy">
                <span class="sv-distro-kicker"><%= svDistro.kicker || "Distribution Hub" %></span>
                <h3><%= svDistro.title || "SVG Distro" %></h3>
                <p class="sv-distro-address"><%= svDistro.address || "Snus Village Charles House, Southall" %></p>
                <p>
                  <%= svDistro.description || "Our Southall Location Supports Stock Availability, Trade Enquiries, Local Distribution, And Product Support For Adult Customers And Approved Traders." %>
                </p>

                <div class="sv-distro-badges">
                  <% svDistroBadges.forEach((badge) => { %>
                    <span><%= badge %></span>
                  <% }) %>
                </div>

                <a href="<%= svDistro.buttonLink || '/contact' %>" class="sv-ab-btn sv-ab-btn--primary">
                  <%= svDistro.buttonText || "Contact For Details" %>
                </a>
              </div>

              <div class="sv-distro-carousel" id="svgDistroCarousel">
                <div class="sv-distro-track">
                  <% svDistroImages.slice(0, 3).forEach((image, index) => { %>
                    <img
                      src="<%= optimiseImageUrl(image.imageSrc || '/images/header/h-1.jpeg', { width: 640 }) %>"
                      alt="<%= image.alt || 'SVG Distro Location Image' %>"
                      class="<%= index === 0 ? 'is-active' : '' %>"
                      loading="lazy"
                      decoding="async"
                    />
                  <% }) %>
                </div>

                <div class="sv-distro-controls">
                  <button type="button" class="sv-distro-prev" aria-label="Previous Location Image">‹</button>
                  <button type="button" class="sv-distro-next" aria-label="Next Location Image">›</button>
                </div>

                <div class="sv-distro-dots">
                  <% svDistroImages.slice(0, 3).forEach((image, index) => { %>
                    <button type="button" class="<%= index === 0 ? 'is-active' : '' %>" aria-label="Show Location Image <%= index + 1 %>"></button>
                  <% }) %>
                </div>
              </div>
            </article>
          </div>
        </section>

        <%
          const svSocial = homepageContent?.social || {};
          const svSocialSlides = svSocial.slides && svSocial.slides.length
            ? svSocial.slides
            : [
                {
                  videoSrc: "/videos/social/social-1.mp4",
                  posterSrc: "/images/header/h-1.jpeg",
                  title: "New Stock Arrival",
                  subtitle: "Latest Product Highlights From Snus Village",
                },
                {
                  videoSrc: "/videos/social/social-2.mp4",
                  posterSrc: "/images/header/h-2.webp",
                  title: "In-Store Content",
                  subtitle: "Store Moments, Promotions, And Customer Favourites",
                },
                {
                  videoSrc: "/videos/social/social-3.mp4",
                  posterSrc: "/images/delivery/delivery.webp",
                  title: "London Updates",
                  subtitle: "See What Is Happening Across Our Locations",
                },
              ];
        %>

        <section class="section sv-social-showcase" id="social-showcase">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark"><%= svSocial.eyebrow || "Social Media" %></span>
                <h2><%= svSocial.heading || "See Snus Village In Action" %></h2>
                <p>
                  <%= svSocial.description || "Follow Our Latest Product Drops, In-Store Moments, Promotions, And London Updates Through Our Social Content." %>
                </p>
              </div>

              <a class="ghost-btn" href="<%= svSocial.instagramUrl || 'https://www.instagram.com/snusvillage.uk/' %>" target="_blank" rel="noopener noreferrer">
                Follow Instagram
              </a>
            </div>

            <div class="sv-social-iphone-grid">
              <div class="sv-social-copy-card">
                <span class="pill">Snus Village UK</span>
                <h3><%= svSocial.cardTitle || "Follow Our Socials" %></h3>
                <p>
                  <%= svSocial.cardText || "Discover New Stock, Best Sellers, Promotions, Branch Updates, And Behind-The-Scenes Clips From Snus Village." %>
                </p>

                <div class="sv-social-points">
                  <div class="sv-social-point">
                    <strong>New Stock</strong>
                    <span>See Fresh Arrivals And Best-Selling Products.</span>
                  </div>

                  <div class="sv-social-point">
                    <strong>Store Updates</strong>
                    <span>Follow What Is Happening Across Our London Locations.</span>
                  </div>

                  <div class="sv-social-point">
                    <strong>Promotions</strong>
                    <span>Spot Limited Offers, Events, And Featured Drops.</span>
                  </div>
                </div>

                <div class="sv-social-links">
                  <a href="<%= svSocial.instagramUrl || 'https://www.instagram.com/snusvillage.uk/' %>" target="_blank" rel="noopener noreferrer" class="sv-ab-btn sv-ab-btn--primary">
                    Open Instagram
                  </a>

                  <a href="/contact" class="sv-ab-btn sv-ab-btn--ghost">
                    Contact Us
                  </a>
                </div>
              </div>

              <div class="sv-phone-wrap">
                <div class="sv-phone">
                  <div class="sv-phone__notch"></div>

                  <div class="sv-phone__screen">
                    <div class="sv-ig-top">
                      <div class="sv-ig-profile">
                        <div class="sv-ig-avatar">
                          <img src="/images/logo/snus-village-logo.webp" alt="Snus Village" />
                        </div>

                        <div>
                          <strong>snusvillage.uk</strong>
                          <span>Snus Village</span>
                        </div>
                      </div>

                      <div class="sv-ig-live">REELS</div>
                    </div>

                    <div class="sv-ig-stories">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>

                    <div class="sv-social-reel" id="svSocialReel">
                      <% svSocialSlides.slice(0, 3).forEach((slide, index) => { %>
                        <div class="sv-social-slide <%= index === 0 ? 'is-active' : '' %>">
                          <video
                            src="<%= slide.videoSrc %>"
                            muted
                            <%= index === 0 ? 'autoplay' : '' %>
                            loop
                            playsinline
                            poster="<%= optimiseImageUrl(slide.posterSrc || '/images/header/h-1.jpeg', { width: 900 }) %>"
                          ></video>
                          <div class="sv-social-caption">
                            <strong><%= slide.title || 'Snus Village Update' %></strong>
                            <span><%= slide.subtitle || 'Latest Content From Snus Village' %></span>
                          </div>
                        </div>
                      <% }) %>
