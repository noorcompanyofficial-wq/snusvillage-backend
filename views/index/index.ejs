    <script>
      (function () {
        var ageModal = document.getElementById("ageModal");
        var enterBtn = document.getElementById("enterSite");
        var exitBtn  = document.getElementById("exitSite");
        var ageDob   = document.getElementById("ageDob");
        var ageError = document.getElementById("ageError");

        if (!ageModal) {
          document.body.classList.remove("age-modal-open");
          document.documentElement.style.overflow = "";
          document.body.style.overflow = "";
          return;
        }

        function isAdultFromDob(value) {
          if (!value) return false;
          var dob = new Date(value + "T00:00:00");
          if (Number.isNaN(dob.getTime())) return false;
          var today = new Date();
          var age = today.getFullYear() - dob.getFullYear();
          var monthDiff = today.getMonth() - dob.getMonth();
          if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) age -= 1;
          return age >= 18;
        }

        function hasValidDob(value) {
          if (!value) return false;
          var dob = new Date(value + "T00:00:00");
          return !Number.isNaN(dob.getTime());
        }

        function redirectUnderageVisitor() {
          if (ageError) {
            ageError.textContent = "You must be 18 or over to enter this website. You will now be redirected.";
            ageError.hidden = false;
          }
          sessionStorage.removeItem("ageVerified");
          window.setTimeout(function () { window.location.href = "https://www.google.com"; }, 1800);
        }

        function unlockPageScroll() {
          document.body.classList.remove("age-modal-open");
          document.documentElement.style.overflow = "";
          document.body.style.overflow = "";
          document.body.style.position = "";
          document.body.style.height = "";
          document.body.style.touchAction = "";
        }

        function lockPageScroll() {
          document.body.classList.add("age-modal-open");
          document.documentElement.style.overflow = "hidden";
          document.body.style.overflow = "hidden";
          document.body.style.touchAction = "none";
        }

        function hideAgeGate() {
          ageModal.classList.remove("is-visible");
          ageModal.setAttribute("aria-hidden", "true");
          unlockPageScroll();
        }

        function showAgeGate() {
          ageModal.classList.add("is-visible");
          ageModal.setAttribute("aria-hidden", "false");
          lockPageScroll();
        }

        if (sessionStorage.getItem("ageVerified") === "true") {
          hideAgeGate();
        } else {
          showAgeGate();
        }

        if (enterBtn) enterBtn.addEventListener("click", function () {
          var dobValue = (ageDob && ageDob.value) || "";
          if (!hasValidDob(dobValue)) {
            if (ageError) { ageError.textContent = "Please enter a valid date of birth showing you are 18 or over."; ageError.hidden = false; }
            if (ageDob) ageDob.focus();
            return;
          }
          if (!isAdultFromDob(dobValue)) { redirectUnderageVisitor(); return; }
          sessionStorage.setItem("ageVerified", "true");
          hideAgeGate();
        });

        if (exitBtn) exitBtn.addEventListener("click", function () {
          sessionStorage.removeItem("ageVerified");
          window.location.href = "https://www.google.com";
        });

        if (ageDob) ageDob.addEventListener("input", function () {
          if (ageError) { ageError.textContent = ""; ageError.hidden = true; }
        });
      })();
    </script>

    <script>
      (function () {
        var carousel    = document.getElementById('heroCarousel');
        if (!carousel) return;
        var slides   = Array.from(carousel.querySelectorAll('.v4-carousel__slide'));
        var dots     = Array.from(carousel.querySelectorAll('.v4-carousel__dot'));
        var counter  = document.getElementById('carouselCounter');
        var progress = document.getElementById('carouselProgress');
        if (slides.length < 2) return;

        var current  = 0;
        var timer    = null;
        var DURATION = 4200; /* ms between slides */
        var total    = slides.length;

        /* ── Counter ── */
        function updateCounter(n) {
          if (!counter) return;
          var pad = function(x) { return String(x).padStart(2, '0'); };
          counter.textContent = pad(n + 1) + ' / ' + pad(total);
        }

        /* ── Progress bar ── */
        function startProgress() {
          if (!progress) return;
          progress.style.transition = 'none';
          progress.style.width = '0%';
          progress.offsetHeight; /* force reflow */
          progress.style.transition = 'width ' + DURATION + 'ms linear';
          progress.style.width = '100%';
        }
        function stopProgress() {
          if (!progress) return;
          progress.style.transition = 'none';
          progress.style.width = '0%';
        }

        /* ── Slide change ── */
        function goTo(n) {
          var next = (n + total) % total;
          var dir  = (next > current || (current === total - 1 && next === 0)) ? 1 : -1;
          carousel.style.setProperty('--slide-dir', dir);

          /* outgoing */
          slides[current].classList.remove('is-active');
          slides[current].classList.add('is-leaving');
          if (dots[current]) dots[current].classList.remove('is-active');
          var leaving = slides[current];
          setTimeout(function() { leaving.classList.remove('is-leaving'); }, 550);

          /* incoming */
          current = next;
          slides[current].classList.add('is-active');
          if (dots[current]) dots[current].classList.add('is-active');
          updateCounter(current);
          startProgress();
        }

        /* ── Auto-advance ── */
        function start() { timer = setInterval(function() { goTo(current + 1); }, DURATION); }
        function stop()  { clearInterval(timer); stopProgress(); }

        /* ── Dot clicks ── */
        dots.forEach(function(dot, i) {
          dot.addEventListener('click', function() { stop(); goTo(i); start(); });
        });

        /* ── 3D image tilt on hover ── */
        carousel.addEventListener('mousemove', function(e) {
          var slide = slides[current];
          if (!slide) return;
          var img = slide.querySelector('.v4-carousel__img img');
          if (!img) return;
          img.classList.add('is-tilting');
          var rect = carousel.getBoundingClientRect();
          var xPct = (e.clientX - rect.left) / rect.width - 0.5;
          var yPct = (e.clientY - rect.top)  / rect.height - 0.5;
          img.style.transform = 'perspective(700px) rotateY(' + (xPct * 14) + 'deg) rotateX(' + (-yPct * 10) + 'deg) scale(1.04)';
        });

        carousel.addEventListener('mouseleave', function() {
          var img = carousel.querySelector('.v4-carousel__slide.is-active .v4-carousel__img img');
          if (img) { img.classList.remove('is-tilting'); img.style.transform = ''; }
        });

        /* ── Pause on hover ── */
        carousel.addEventListener('mouseenter', stop);
        carousel.addEventListener('mouseleave', function() { start(); startProgress(); });

        /* ── Init ── */
        updateCounter(0);
        start();
        startProgress();
      })();
    </script>

  </body>
