<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snus Village</title>
    <meta
      name="description"
      content="Premium nicotine pouch and snus specialist with London stores, trusted brands, and fast UK delivery."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/logo/snusvillage-logo.png" />
    <link rel="stylesheet" href="/css/landing.css" />
  </head>
  <body>
    <div class="landing-age-modal" id="landingAgeModal">
      <div class="landing-age-box">
        <h2>Age Verification</h2>
        <p>You Must Be 18+ To Enter This Website.</p>
        <div class="landing-age-buttons">
          <button type="button" id="landingEnterSite">I Am Over 18</button>
          <button type="button" id="landingExitSite">I Am Under 18</button>
        </div>
      </div>
    </div>

    <div class="page-shell">
      <div class="topbar">
        <div class="container topbar__inner">
          <div class="topbar__pill">Premium Brands - Authentic Stock - Fast UK Delivery</div>
          <div class="topbar__pill">Camden Town - Oxford Street - Edgware Road - 18+ Only</div>
        </div>
      </div>

      <header class="nav">
        <div class="container nav__inner">
          <a class="brand" href="/" aria-label="Snus Village home">
            <img class="brand__logo" src="/images/logo/snusvillage-logo.png" alt="Snus Village" />
            <span class="brand__text">
              <strong>Snus Village</strong>
              <span>London's Premium Snus Store</span>
            </span>
          </a>

          <button class="icon-btn mobile-toggle" id="mobileToggle" aria-label="Toggle navigation">Menu</button>

          <nav class="nav__links" id="navLinks">
            <a href="/shop">All Products</a>
            <a href="/wholesale">Wholesale</a>
            <a href="/about">About Us</a>
            <a href="/contact">Contact Us</a>
          </nav>

          <div class="nav__actions">
            <% if (user) { %>
              <a class="ghost-btn nav-auth" href="/auth/dashboard">Account</a>
              <a class="ghost-btn nav-auth nav-auth--quiet" href="/auth/logout">Logout</a>
            <% } else { %>
              <a class="ghost-btn nav-auth nav-auth--quiet" href="/auth/register">Register</a>
              <a class="btn nav-auth" href="/auth/login">Login</a>
            <% } %>
          </div>
        </div>
      </header>

      <main id="home">
        <section class="sv-ab-hero" id="svAbHero">
          <div class="container sv-ab-hero__inner">
            <div class="sv-ab-hero__copy">
              <span class="sv-ab-hero__eyebrow">Snus Village London</span>

              <h1>
                London’S Premium
                <span>Snus & Vape Store</span>
              </h1>

              <p>
                Authentic Nicotine Pouch And Vape Brands For Adult Customers, With London Retail Support And Fast UK Delivery.
              </p>

              <div class="sv-ab-hero__actions">
                <a href="/shop" class="sv-ab-btn sv-ab-btn--primary">Shop Collection</a>
                <a href="/about" class="sv-ab-btn sv-ab-btn--ghost">Our Story</a>
              </div>

              <div class="sv-ab-hero__badges">
                <div>
                  <strong>18+</strong>
                  <span>Adults Only</span>
                </div>
                <div>
                  <strong>4</strong>
                  <span>London Locations</span>
                </div>
                <div>
                  <strong>UK</strong>
                  <span>Fast Delivery</span>
                </div>
              </div>
            </div>

            <div class="sv-ab-hero__visual" aria-label="Snus Village featured products">
              <div class="sv-ab-orbit sv-ab-orbit--one"></div>
              <div class="sv-ab-orbit sv-ab-orbit--two"></div>

              <article class="sv-ab-product-card sv-ab-product-card--main">
                <img src="/images/header/h-1.jpeg" alt="Snus Village premium product display" />
                <div>
                  <span>Featured Range</span>
                  <strong>Premium Snus, Vape, And Nicotine Pouch Brands.</strong>
                </div>
              </article>

              <article class="sv-ab-product-card sv-ab-product-card--small sv-ab-float-one">
                <img src="/images/shop/wf-1.png" alt="White Fox product" />
                <div>
                  <span>Best Sellers</span>
                  <strong>White Fox</strong>
                </div>
              </article>

              <article class="sv-ab-product-card sv-ab-product-card--small sv-ab-float-two">
                <img src="/images/shop/pablo-1.png" alt="Pablo product" />
                <div>
                  <span>Strong Range</span>
                  <strong>Pablo</strong>
                </div>
              </article>

              <div class="sv-ab-feature-card">
                <span>✦</span>
                <strong>Trusted London Retailer</strong>
                <p>Authentic Adult-Only Products, Real Shop Support, And Fast UK Delivery.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section sv-collections-redesign" id="collections">
          <div class="container">
            <div class="section-head sv-section-head-pro">
              <div>
                <span class="eyebrow dark">Collections</span>
                <h2>Shop By Strength, Flavour, And Brand</h2>
                <p>Move Quickly From Your Preferred Flavour To The Strength, Brand, And Product Type That Fits Your Preference.</p>
              </div>
              <a class="ghost-btn" href="/shop">Open Shop</a>
            </div>

            <div class="sv-collection-grid-pro">
              <article class="sv-collection-card-pro sv-collection-card-pro--large" style="--bg-image:url('/images/social/s-1.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">01</span>
                  <h3>Mint Favourites</h3>
                  <p>Clean, Cool, And Reliable Flavour Profiles From Leading Nicotine Pouch Brands.</p>
                  <a class="sv-collection-link" href="/shop">Shop Mint</a>
                </div>
              </article>

              <article class="sv-collection-card-pro" style="--bg-image:url('/images/social/s-6.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">02</span>
                  <h3>Strong Selections</h3>
                  <p>Higher Strength Products For Adult Customers Who Know Exactly What They Want.</p>
                  <a class="sv-collection-link" href="/shop">Shop Strong</a>
                </div>
              </article>

              <article class="sv-collection-card-pro" style="--bg-image:url('/images/social/s-10.jpeg');">
                <div class="sv-collection-card-pro__shade"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">03</span>
                  <h3>Fruity Flavours</h3>
                  <p>Berry, Citrus, Cola, Tropical, And Sweet Profiles For A Brighter Choice.</p>
                  <a class="sv-collection-link" href="/shop">Shop Flavours</a>
                </div>
              </article>

              <article class="sv-collection-card-pro sv-collection-card-pro--dark">
                <div class="sv-collection-card-pro__glow"></div>
                <div class="sv-collection-card-pro__content">
                  <span class="sv-collection-number">04</span>
                  <h3>Vape Range</h3>
                  <p>Explore Vape Products, New Arrivals, And Fast-Moving Stock From Snus Village.</p>
                  <a class="sv-collection-link" href="/shop">Shop Vape</a>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="section" id="bestsellers">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="eyebrow dark">Best Sellers</span>
                <h2>Customer Favourites</h2>
                <p>A Focused Selection Of The Products And Brands That Move Fastest In Store And Online.</p>
              </div>
              <a class="ghost-btn" href="/shop">View All Products</a>
            </div>

            <div class="product-grid">
              <article class="product-card">
                <div class="product-card__media"><img src="/images/shop/wf-1.png" alt="White Fox product" /></div>
                <div class="product-card__top"><span class="product-card__tag">White Fox</span><span class="product-card__tag">Strong</span></div>
                <h3>White Fox Range</h3>
                <p>Popular Mint-Led Cans With A Clean Profile And Strong Customer Demand.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="ghost-btn" href="/shop">View</a></div>
              </article>

              <article class="product-card">
                <div class="product-card__media"><img src="/images/shop/pablo-1.png" alt="Pablo product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Pablo</span><span class="product-card__tag">Extreme</span></div>
                <h3>Pablo Range</h3>
                <p>High Strength Cans With Bold Flavours For Experienced Adult Users.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="ghost-btn" href="/shop">View</a></div>
              </article>

              <article class="product-card">
                <div class="product-card__media"><img src="/images/shop/velo-1.webp" alt="Velo product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Velo</span><span class="product-card__tag">Smooth</span></div>
                <h3>Velo Range</h3>
                <p>Everyday Pouches With Familiar Flavours And Balanced Strength Options.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span class="is-on"></span><span></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="ghost-btn" href="/shop">View</a></div>
              </article>

              <article class="product-card">
                <div class="product-card__media"><img src="/images/shop/loop-1.webp" alt="Loop product" /></div>
                <div class="product-card__top"><span class="product-card__tag">Loop</span><span class="product-card__tag">Flavour</span></div>
                <h3>Loop Range</h3>
                <p>Modern Pouch Flavours With Clean Packaging And Reliable Popularity.</p>
                <div class="strength"><span class="is-on"></span><span class="is-on"></span><span></span><span></span><span></span></div>
                <div class="product-card__price"><strong>From The Shop</strong><a class="ghost-btn" href="/shop">View</a></div>
              </article>
            </div>
          </div>
        </section>

        <section class="section" id="shops">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="eyebrow dark">Location</span>
                <h2>Find Snus Village In London</h2>
                <p>Visit One Of Our London Areas Or Contact The Team Before You Travel For Stock Questions.</p>
              </div>
              <a class="ghost-btn" href="/contact">Contact Us</a>
            </div>

            <div class="shops-grid">
              <article class="shop-card">
                <iframe class="shop-card__map" loading="lazy" src="https://www.google.com/maps?q=Camden+Town+London&output=embed" title="Camden Town"></iframe>
                <div class="shop-card__body">
                  <div class="shop-card__meta"><h3>Camden Town</h3><strong>London</strong></div>
                  <p>Central North London Access With A Strong Range Of Best-Selling Products.</p>
                  <a class="ghost-btn" href="/contact">Ask About Stock</a>
                </div>
              </article>

              <article class="shop-card">
                <iframe class="shop-card__map" loading="lazy" src="https://www.google.com/maps?q=Oxford+Street+London&output=embed" title="Oxford Street"></iframe>
                <div class="shop-card__body">
                  <div class="shop-card__meta"><h3>Oxford Street</h3><strong>London</strong></div>
                  <p>Easy Access For Shoppers Near One Of London's Busiest Retail Destinations.</p>
                  <a class="ghost-btn" href="/contact">Ask About Stock</a>
                </div>
              </article>

              <article class="shop-card">
                <iframe class="shop-card__map" loading="lazy" src="https://www.google.com/maps?q=Edgware+Road+London&output=embed" title="Edgware Road"></iframe>
                <div class="shop-card__body">
                  <div class="shop-card__meta"><h3>Edgware Road</h3><strong>London</strong></div>
                  <p>Convenient West London Area For Quick Visits And Product Enquiries.</p>
                  <a class="ghost-btn" href="/contact">Ask About Stock</a>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="section" id="info">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="eyebrow dark">Information</span>
                <h2>Simple, Reliable Service</h2>
                <p>Clear Routes For Retail Customers, Wholesale Traders, And Anyone Who Needs Help Choosing A Product.</p>
              </div>
            </div>

            <div class="info-grid">
              <div class="info-card">
                <span class="pill">Retail</span>
                <h3>Shop Online</h3>
                <p>Browse Products, View Details, And Build Your Basket Through The Main Shop.</p>
              </div>
              <div class="info-card">
                <span class="pill">Wholesale</span>
                <h3>Trader Review</h3>
                <p>Wholesale Access Is Restricted To Approved Traders With A Separate Trader Login.</p>
              </div>
              <div class="info-card">
                <span class="pill">Support</span>
                <h3>Contact The Team</h3>
                <p>Use The Contact Page For Store, Stock, Delivery, Or Wholesale Questions.</p>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer" id="footer">
        <div class="container">
          <div class="footer__panel">
            <div class="footer__grid">
              <div>
                <div class="brand">
                  <img class="brand__logo" src="/images/logo/snusvillage-logo.png" alt="Snus Village" />
                  <span class="brand__text">
                    <strong>Snus Village</strong>
                    <span>London's Premium Snus Store</span>
                  </span>
                </div>
                <p style="margin-top:16px; max-width:42ch;">Premium Nicotine Pouch And Snus Specialist With Trusted Brands, London Stores, And Fast UK Delivery.</p>
              </div>

              <div>
                <h4>Shop</h4>
                <ul>
                  <li><a href="/shop">All Products</a></li>
                  <li><a href="#bestsellers">Best Sellers</a></li>
                  <li><a href="/wholesale">Wholesale</a></li>
                  <li><a href="/about">About</a></li>
                </ul>
              </div>

              <div>
                <h4>Stores</h4>
                <ul>
                  <li><a href="#shops">Camden Town</a></li>
                  <li><a href="#shops">Oxford Street</a></li>
                  <li><a href="#shops">Edgware Road</a></li>
                  <li><a href="/contact">Store Enquiries</a></li>
                </ul>
              </div>

              <div>
                <h4>Contact</h4>
                <ul>
                  <li><a href="mailto:info@snusvillage.co.uk">Info@Snusvillage.Co.UK</a></li>
                  <li><a href="tel:+447777222771">+44 7777 222771</a></li>
                  <li><a href="https://www.instagram.com/snusvillage.uk/">Instagram</a></li>
                  <li><a href="/contact">Contact Form</a></li>
                </ul>
              </div>
            </div>

            <div class="footer__bottom">
              <span>© 2026 Snus Village.</span>
              <span>Adults Only. Products Are Restricted To Customers Aged 18+.</span>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script src="/js/landing.js"></script>
  </body>
</html>
