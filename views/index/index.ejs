<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <%- include("../partials/google-tag") %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snus Village | Premium Nicotine Pouches UK</title>
    <meta
      name="description"
      content="Shop premium nicotine pouches in the UK from Snus Village London with UK delivery and age-verified service for adult customers."
    />
    <link rel="canonical" href="https://www.snusvillage.com/" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Snus Village",
        "url": "https://www.snusvillage.com",
        "description": "UK smokeless nicotine retailer offering premium nicotine pouches and smoke-free alternatives for adult customers.",
        "areaServed": ["United Kingdom", "London"],
        "sameAs": [
          "https://www.instagram.com/snusvillage.uk/",
          "https://www.youtube.com/@SnusVillage"
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "89 Edgware Road",
          "addressLocality": "London",
          "postalCode": "W2 2HX",
          "addressCountry": "GB"
        }
      }
    </script>

    <!-- Fonts: Montserrat (headings/labels) -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- FontAwesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <link rel="icon" href="/images/logo/snus-village-logo.webp" />

    <!-- Core CSS: age-gate, landing (keeps header/nav/footer/mega-menu styles), v4 sections -->
    <link rel="stylesheet" href="/css/age-gate.css?v=v4-split-20260717" />
    <link rel="stylesheet" href="/css/promo-popup.css?v=v4-20260725" />
    <link rel="stylesheet" href="/css/landing.css?v=megamenu-fix-20260713" />
    <link rel="stylesheet" href="/css/landing-v4.css?v=v4-hero-admin-bg-20260726" />

    <!-- Footer preloaded -->
    <link
      rel="preload"
      href="/css/footer.css?v=footer-blue-red-20260728"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/css/footer.css?v=footer-blue-red-20260728" /></noscript>
    <link rel="stylesheet" href="/css/browser-fixes.css?v=safari-20260611" />
  </head>

  <body class="age-modal-open">

    <!-- Age gate -->
    <div class="age-gate is-visible" id="ageModal" role="dialog" aria-modal="true" aria-labelledby="ageModalTitle" aria-hidden="false">
      <div class="age-gate__brand" aria-hidden="true">
        <div class="age-gate__brand-top">
          <img src="/images/logo/snus-village-logo.webp" alt="Snus Village" class="age-gate__logo" />
          <div class="age-gate__brand-name">Snus Village</div>
          <p class="age-gate__brand-sub">Premium nicotine pouches for adult customers across London and the UK.</p>
        </div>
        <div class="age-gate__trust">
          <div class="age-gate__trust-item"><i class="fa-solid fa-shield-halved"></i> Age-restricted products only</div>
          <div class="age-gate__trust-item"><i class="fa-solid fa-truck-fast"></i> Fast UK delivery</div>
          <div class="age-gate__trust-item"><i class="fa-solid fa-store"></i> London retail locations</div>
        </div>
      </div>
      <div class="age-gate__form">
        <div class="age-gate__badge">18+ Only</div>
        <h1 class="age-gate__heading" id="ageModalTitle">Confirm<br>your <em>age.</em></h1>
        <p class="age-gate__desc">Snus Village sells age-restricted nicotine products. You must be 18 or over to browse and purchase. Formal age verification is required at checkout.</p>
        <label class="age-gate__dob-label" for="ageDob">
          <span>Date of birth</span>
          <input id="ageDob" class="age-gate__dob-input" type="date" autocomplete="bday" required />
        </label>
        <p class="age-gate__error" id="ageError" aria-live="polite"></p>
        <div class="age-gate__actions">
          <button id="enterSite" class="age-gate__enter" type="button">Enter Site <i class="fa-solid fa-arrow-right"></i></button>
          <button id="exitSite" class="age-gate__exit" type="button">I am under 18 — exit</button>
        </div>
        <p class="age-gate__note">Your age is verified once every 24 hours. We do not store your date of birth.</p>
      </div>
    </div>

    <%
      // Only ever show a code that actually works at checkout — driven by
      // whichever real DiscountCode an admin has flagged as the welcome
      // discount on the Discounts page, not free-text settings fields.
      const welcomeBadge = welcomeDiscount
        ? (welcomeDiscount.type === "percentage" ? `${Number(welcomeDiscount.value || 0).toFixed(0)}% Off` : `£${Number(welcomeDiscount.value || 0).toFixed(2)} Off`)
        : "";
    %>
    <% if (storeSettings && storeSettings.promoPopupEnabled !== false && welcomeDiscount) { %>
      <div
        class="promo-popup"
        id="promoPopup"
        data-delay-seconds="<%= Number(storeSettings.promoPopupDelaySeconds != null ? storeSettings.promoPopupDelaySeconds : 20) %>"
        role="dialog"
        aria-labelledby="promoPopupHeading"
        aria-hidden="true"
        hidden
      >
        <button class="promo-popup__close" id="promoPopupClose" type="button" aria-label="Close">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <div class="promo-popup__badge"><%= welcomeBadge %></div>
        <h2 class="promo-popup__heading" id="promoPopupHeading"><%= storeSettings.promoPopupHeading || "Welcome to Snus Village!" %></h2>
        <p class="promo-popup__body"><%= storeSettings.promoPopupBody || "Enjoy 10% off your first order, on us." %></p>
        <button class="promo-popup__code" id="promoPopupCode" type="button" title="Click to copy">
          <span><%= welcomeDiscount.code %></span>
          <i class="fa-regular fa-copy" aria-hidden="true"></i>
        </button>
        <a class="promo-popup__cta" href="<%= storeSettings.promoPopupButtonLink || '/shop' %>">
          <%= storeSettings.promoPopupButtonText || "Shop Now" %>
        </a>
      </div>
    <% } %>

    <%- include("../partials/header") %>

    <main id="home">

      <%
        /* ── V4 data setup ── */

        /* Hero carousel: admin-curated slides (product + background photo), falling
           back to best sellers / featured products when none have been set up yet */
        const heroDbSlides = (homepageContent?.hero?.slides || [])
          .filter((s) => s.product && s.bgImageSrc)
          .map((s) => Object.assign({}, s.product, { heroBgImage: s.bgImageSrc }));

        const v4CarouselProds = heroDbSlides.length
          ? heroDbSlides
          : (bestSellerProducts && bestSellerProducts.length
              ? bestSellerProducts
              : (featuredProducts && featuredProducts.length ? featuredProducts : [])
            ).slice(0, 5);

        /* Strength → CSS suffix */
        const v4sc = (s) => {
          const n = ((s || '').toLowerCase()).replace(/[\s\-]/g, '');
          if (n === 'low')    return 'low';
          if (n === 'medium') return 'medium';
          if (n === 'strong') return 'strong';
          if (n === 'xstrong') return 'xstrong';
          return 'extreme';
        };

        /* Collections */
        const svCollections    = homepageContent?.collections || {};
        const svCollectionCards = svCollections.cards && svCollections.cards.length
          ? svCollections.cards
          : [
              { number:"01", title:"Mint & Ice Flavours",   text:"Clean, cool and reliable. The most popular flavour category across all brands.", linkText:"Shop Mint",    linkUrl:"/shop?flavour=mint",             imageSrc:"/images/social/s-1.jpeg"  },
              { number:"02", title:"Strong Selections",     text:"",                                                                                linkText:"Shop Strong", linkUrl:"/shop?strength=STRONG",          imageSrc:"/images/social/s-6.jpeg"  },
              { number:"03", title:"Fruity Flavours",       text:"",                                                                                linkText:"Shop Fruit",  linkUrl:"/shop",                          imageSrc:"/images/social/s-10.jpeg" },
              { number:"04", title:"Tobacco-Free Pouches",  text:"",                                                                                linkText:"Shop Pouches",linkUrl:"/shop?category=Nicotine%20Pouches",imageSrc:"/images/social/s-4.jpeg" },
            ];

        /* Remove vapes from collection cards */
        const unavailableCollPath = "/collections/" + "va" + "pes";
        const v4CollCards = svCollectionCards
          .filter(c => !String(c.linkUrl || '').includes(unavailableCollPath))
          .slice(0, 4);
        const v4CollColors = ['v4-coll-c1','v4-coll-c2','v4-coll-c3','v4-coll-c4'];

        /* Locations */
        const svLocations     = homepageContent?.locations || {};
        const svLocationCards = svLocations.cards && svLocations.cards.length
          ? svLocations.cards
          : [
              { label:"London Branch", title:"Camden Town",   description:"Central North London access with a strong range of best-selling products.",  mapUrl:"https://www.google.com/maps?q=Camden+Town+London&output=embed",        mapTitle:"Camden Town",   buttonText:"Ask About Stock", buttonLink:"/contact" },
              { label:"London Branch", title:"Oxford Street",  description:"Easy access for shoppers near one of London's busiest retail destinations.", mapUrl:"https://www.google.com/maps?q=Oxford+Street+London&output=embed",       mapTitle:"Oxford Street", buttonText:"Ask About Stock", buttonLink:"/contact" },
              { label:"London Branch", title:"Edgware Road",   description:"Convenient West London area for quick visits and product enquiries.",        mapUrl:"https://www.google.com/maps?q=89+Edgware+Road+London&output=embed",    mapTitle:"Edgware Road",  buttonText:"Ask About Stock", buttonLink:"/contact" },
            ];

        /* Distro */
        const svDistro       = homepageContent?.distro || {};
        const svDistroBadges = svDistro.badges && svDistro.badges.length
          ? svDistro.badges
          : ["Stock Support","Trade Enquiries","Southall","18+ Only"];

        /* Social */
        const svSocial      = homepageContent?.social || {};
        const svSocialSlides = svSocial.slides && svSocial.slides.length
          ? svSocial.slides
          : [
              { videoSrc:"/videos/social/social-1.mp4", posterSrc:"/images/header/h-1.jpeg",       title:"New Stock Arrival",   subtitle:"Latest Product Highlights From Snus Village" },
              { videoSrc:"/videos/social/social-2.mp4", posterSrc:"/images/header/h-2.webp",       title:"In-Store Content",    subtitle:"Store Moments, Promotions, And Customer Favourites" },
              { videoSrc:"/videos/social/social-3.mp4", posterSrc:"/images/delivery/delivery.webp", title:"London Updates",      subtitle:"See What Is Happening Across Our Locations" },
            ];
      %>

      <!-- ========================
           HERO — centered slideshow (light theme)
           ======================== -->
      <section class="v4-hero">

        <!-- Trust strip -->
        <div class="v4-hero__trust-strip">
          <div class="v4-hero__trust-item"><i class="fa-solid fa-shield-halved"></i> Age Verified</div>
          <div class="v4-hero__trust-item"><i class="fa-solid fa-truck-fast"></i> UK Delivery from &pound;1.99</div>
          <div class="v4-hero__trust-item"><i class="fa-solid fa-map-pin"></i> 3 London Stores</div>
          <div class="v4-hero__trust-item"><i class="fa-solid fa-certificate"></i> 100% Authentic</div>
        </div>

        <!-- Slides -->
        <div class="v4-hero__slides" id="heroCarousel">
          <% if (v4CarouselProds.length) { %>
            <% v4CarouselProds.forEach((p, idx) => {
              const cImg = p.images && p.images.length ? p.images[0] : null;
              const cSc  = v4sc(p.strength);
              const cFinalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
              const cEyebrow = p.isBestSeller ? "Best Seller At Snus Village" : (p.isFeatured ? "Featured This Week" : "Customer Favourite");
              const cLine2 = p.flavour || p.name;
              const cDesc = p.description
                ? (p.description.length > 150 ? p.description.slice(0, 150).trim() + "…" : p.description)
                : "Trusted by adult customers across London and the UK, with fast delivery and age-verified checkout on every order.";
            %>
              <div class="v4-hero__slide <%= idx === 0 ? 'is-active' : '' %>" data-idx="<%= idx %>">
                <% if (p.heroBgImage) { %>
                  <div class="v4-hero__bg" style="background-image:url('<%= optimiseImageUrl(p.heroBgImage, { width: 1600 }) %>')"></div>
                  <div class="v4-hero__bg-overlay"></div>
                <% } %>
                <div class="v4-hero__ring v4-hero__ring--1"></div>
                <div class="v4-hero__ring v4-hero__ring--2"></div>

                <div class="v4-hero__top">
                  <div class="v4-hero__eyebrow"><%= cEyebrow %></div>
                  <div class="v4-hero__headline"><%= p.brand || 'Snus Village' %><span><%= cLine2 %></span></div>
                </div>

                <div class="v4-hero__image-wrap">
                  <% if (p.strength) { %>
                    <span class="v4-hero__img-badge v4-badge--<%= cSc %>"><%= p.strength %><% if (p.nicotine) { %> &middot; <%= p.nicotine %>mg<% } %></span>
                  <% } %>
                  <a href="/products/<%= p.slug || p._id %>" aria-label="View <%= p.name %>">
                    <% if (cImg) { %>
                      <img class="v4-hero__img" src="<%= optimiseImageUrl(cImg, { width: 600 }) %>" alt="<%= p.name %>" loading="<%= idx === 0 ? 'eager' : 'lazy' %>" decoding="async" />
                    <% } else { %>
                      <div class="v4-hero__img v4-hero__no-img"><i class="fa-solid fa-box-open"></i></div>
                    <% } %>
                  </a>
                  <span class="v4-hero__price-tag">&pound;<%= Number(cFinalPrice || 0).toFixed(2) %> &middot; <%= p.pouchesPerCan || 20 %> Pouches</span>
                </div>

                <div class="v4-hero__bottom">
                  <div class="v4-hero__desc"><%= cDesc %></div>
                  <div class="v4-hero__btns">
                    <a href="/products/<%= p.slug || p._id %>" class="v4-btn-red">Shop Now <i class="fa-solid fa-arrow-right"></i></a>
                    <a href="/shop?brand=<%= encodeURIComponent(p.brand || '') %>" class="v4-hero__btn-ghost">View All <%= p.brand || 'Products' %></a>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="v4-hero__slide is-active">
              <div class="v4-hero__top">
                <div class="v4-hero__eyebrow">Snus Village</div>
                <div class="v4-hero__headline">Products<span>Coming Soon</span></div>
              </div>
              <div class="v4-hero__image-wrap">
                <a href="/shop"><div class="v4-hero__img v4-hero__no-img"><i class="fa-solid fa-box-open"></i></div></a>
              </div>
              <div class="v4-hero__bottom">
                <div class="v4-hero__btns">
                  <a href="/shop" class="v4-btn-red">Browse Shop <i class="fa-solid fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Bottom thumbnail bar -->
        <% if (v4CarouselProds.length > 1) { %>
          <div class="v4-hero__bar">
            <% v4CarouselProds.forEach((p, idx) => {
              const tImg = p.images && p.images.length ? p.images[0] : null;
              const tFinalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
            %>
              <div class="v4-hero__thumb <%= idx === 0 ? 'is-active' : '' %>" data-target="<%= idx %>">
                <div class="v4-hero__thumb-fill"></div>
                <% if (tImg) { %>
                  <img class="v4-hero__thumb-img" src="<%= optimiseImageUrl(tImg, { width: 100 }) %>" alt="" />
                <% } %>
                <div>
                  <div class="v4-hero__thumb-brand"><%= p.brand || 'Snus Village' %></div>
                  <div class="v4-hero__thumb-name"><%= p.flavour || p.name %></div>
                  <div class="v4-hero__thumb-price">&pound;<%= Number(tFinalPrice || 0).toFixed(2) %></div>
                </div>
              </div>
            <% }) %>
            <div class="v4-hero__bar-controls">
              <button class="v4-hero__arrow" id="heroPrevBtn" type="button" aria-label="Previous slide"><i class="fa-solid fa-chevron-left"></i></button>
              <div class="v4-hero__counter"><em id="heroCounterNum">1</em>/<%= v4CarouselProds.length %></div>
              <button class="v4-hero__arrow" id="heroNextBtn" type="button" aria-label="Next slide"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
          </div>
        <% } %>
      </section>

      <!-- ========================
           ANNOUNCEMENT STRIP
           ======================== -->
      <div class="v4-strip" aria-hidden="true">
        <div class="v4-strip__track">
          <div class="v4-strip__item"><i class="fa-solid fa-shield-halved"></i> Age-Verified Checkout</div>
          <div class="v4-strip__item"><i class="fa-solid fa-truck-fast"></i> UK Delivery from &pound;1.99</div>
          <div class="v4-strip__item"><i class="fa-solid fa-map-pin"></i> Camden &middot; Oxford Street &middot; Edgware Road</div>
          <div class="v4-strip__item"><i class="fa-solid fa-certificate"></i> 100% Authentic Stock</div>
          <div class="v4-strip__item"><i class="fa-solid fa-box-open"></i> 100+ Products In Stock</div>
          <!-- duplicated for seamless loop -->
          <div class="v4-strip__item"><i class="fa-solid fa-shield-halved"></i> Age-Verified Checkout</div>
          <div class="v4-strip__item"><i class="fa-solid fa-truck-fast"></i> UK Delivery from &pound;1.99</div>
          <div class="v4-strip__item"><i class="fa-solid fa-map-pin"></i> Camden &middot; Oxford Street &middot; Edgware Road</div>
          <div class="v4-strip__item"><i class="fa-solid fa-certificate"></i> 100% Authentic Stock</div>
          <div class="v4-strip__item"><i class="fa-solid fa-box-open"></i> 100+ Products In Stock</div>
        </div>
      </div>

      <!-- ========================
           BEST SELLERS
           ======================== -->
      <section class="v4-products" id="bestsellers">
        <div class="v4-wrap">
          <div class="v4-section-head">
            <div>
              <div class="v4-eyebrow">Customer Favourites</div>
              <h2>Best Sellers</h2>
            </div>
            <a href="/shop" class="v4-section-link">View all products</a>
          </div>

          <% if (bestSellerProducts && bestSellerProducts.length) { %>
            <div class="v4-products-grid">
              <% bestSellerProducts.forEach((p) => { %>
                <%
                  const bsFinalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
                  const bsSc = v4sc(p.strength);
                %>
                <a class="v4-product-card" href="/products/<%= p.slug || p._id %>">
                  <div class="v4-product-card__img">
                    <span class="v4-badge v4-badge--<%= bsSc %>"><%= p.strength || 'Medium' %></span>
                    <% if (p.discountPrice && p.discountPrice > 0) { %>
                      <span class="v4-sale-badge">Sale</span>
                    <% } %>
                    <% if (p.images && p.images.length) { %>
                      <img src="<%= optimiseImageUrl(p.images[0], { width: 400 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async" />
                    <% } else { %>
                      <span class="v4-product-card__img-none">No Image</span>
                    <% } %>
                    <div class="v4-sbar v4-sbar--<%= bsSc %>"></div>
                  </div>
                  <div class="v4-product-card__body">
                    <div class="v4-product-card__brand"><%= p.brand || 'Snus Village' %></div>
                    <div class="v4-product-card__name"><%= p.name %></div>
                    <div class="v4-product-card__foot">
                      <div class="v4-product-card__price">
                        <% if (p.discountPrice && p.discountPrice > 0) { %>
                          <span class="v4-product-card__price-old">&pound;<%= Number(p.price || 0).toFixed(2) %></span>
                        <% } %>
                        &pound;<%= Number(bsFinalPrice || 0).toFixed(2) %>
                      </div>
                      <span class="v4-product-card__btn">View</span>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="v4-products-grid">
              <div class="v4-empty-products">
                <p>Best sellers coming soon. <a href="/shop">Browse the full shop</a>.</p>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ========================
           RED CTA BAND
           ======================== -->
      <div class="v4-cta-band">
        <div class="v4-wrap">
          <div class="v4-cta-band__inner">
            <div>
              <h2>Shop Over 100 Premium Nicotine Pouches</h2>
              <p>Browse trusted brands, filter by strength or flavour, and order with age-verified checkout.</p>
            </div>
            <a href="/shop" class="v4-btn-white">Browse All Products <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </div>

      <!-- ========================
           BRAND SHOWCASE
           ======================== -->
      <section class="v4-brands">
        <div class="v4-wrap">
          <div class="v4-section-head v4-brands-section-head">
            <div>
              <div class="v4-eyebrow">Available Brands</div>
              <h2>Shop By Brand</h2>
            </div>
          </div>
        </div>
        <div class="v4-wrap">
          <div class="v4-brands-row">
            <a href="/shop?brand=WHITE%20FOX" class="v4-brand-card">
              <div class="v4-brand-card__name">White Fox</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=PABLO" class="v4-brand-card">
              <div class="v4-brand-card__name">Pablo</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=SIBERIA" class="v4-brand-card">
              <div class="v4-brand-card__name">Siberia</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=ICEBERG" class="v4-brand-card">
              <div class="v4-brand-card__name">Iceberg</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=KILLA" class="v4-brand-card">
              <div class="v4-brand-card__name">Killa</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=VELO" class="v4-brand-card">
              <div class="v4-brand-card__name">Velo</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=ZYN" class="v4-brand-card">
              <div class="v4-brand-card__name">Zyn</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop" class="v4-brand-card v4-brand-card--dark">
              <div class="v4-brand-card__name">All Brands</div>
              <div class="v4-brand-card__sub">View All &rarr;</div>
            </a>
          </div>
        </div>
      </section>

      <!-- ========================
           COLLECTIONS
           ======================== -->
      <section class="v4-collections" id="collections">
        <div class="v4-wrap">
          <div class="v4-section-head">
            <div>
              <div class="v4-eyebrow"><%= svCollections.eyebrow || 'Shop By Category' %></div>
              <h2><%= svCollections.heading || 'Find Your Perfect Pouch' %></h2>
            </div>
            <a href="<%= svCollections.buttonLink || '/shop' %>" class="v4-section-link"><%= svCollections.buttonText || 'Open Shop' %></a>
          </div>
        </div>
        <div class="v4-wrap">
