<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/google-tag") %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snus Village | Premium Nicotine Pouches UK</title>
    <meta
      name="description"
      content="Shop premium nicotine pouches in the UK from Snus Village London with UK delivery and age-verified service for adult customers."
    />
    <link rel="canonical" href="https://www.snusvillage.com/" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Snus Village",
        "url": "https://www.snusvillage.com",
        "description": "UK smokeless nicotine retailer offering premium nicotine pouches and smoke-free alternatives for adult customers.",
        "areaServed": ["United Kingdom", "London"],
        "sameAs": [
          "https://www.instagram.com/snusvillage.uk/",
          "https://www.youtube.com/@SnusVillage"
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "89 Edgware Road",
          "addressLocality": "London",
          "postalCode": "W2 2HX",
          "addressCountry": "GB"
        }
      }
    </script>

    <!-- Fonts: Montserrat (headings/labels) -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- FontAwesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <link rel="icon" href="/images/logo/snus-village-logo.webp" />

    <!-- Core CSS: age-gate, landing (keeps header/nav/footer/mega-menu styles), v4 sections -->
    <link rel="stylesheet" href="/css/age-gate.css" />
    <link rel="stylesheet" href="/css/landing.css?v=megamenu-fix-20260713" />
    <link rel="stylesheet" href="/css/landing-v4.css?v=v4-carousel-animated-20260717" />

    <!-- Footer preloaded -->
    <link
      rel="preload"
      href="/css/footer.css?v=footer-gradient-20260717"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/css/footer.css?v=footer-gradient-20260717" /></noscript>
    <link rel="stylesheet" href="/css/browser-fixes.css?v=safari-20260611" />
  </head>

  <body class="age-modal-open">

    <!-- Age verification modal (unchanged) -->
    <div class="age-modal is-visible" id="ageModal" aria-hidden="false">
      <div class="age-box" role="dialog" aria-modal="true" aria-labelledby="ageModalTitle">
        <img class="age-logo" src="/images/logo/snus-village-logo.webp" alt="Snus Village" />
        <span class="age-pill">18+ age restricted store</span>
        <h2 id="ageModalTitle">Confirm your age</h2>
        <p>Snus Village sells age-restricted nicotine products. Enter your date of birth to continue. Formal age verification may still be required at checkout.</p>
        <label class="age-dob-field" for="ageDob">
          Date of birth
          <input id="ageDob" type="date" autocomplete="bday" required />
        </label>
        <p class="age-error" id="ageError" hidden>Please enter a valid date of birth showing you are 18 or over.</p>
        <div class="age-points">
          <span><i class="fa-solid fa-lock" aria-hidden="true"></i> Adults 18+ only</span>
          <span><i class="fa-solid fa-id-card" aria-hidden="true"></i> Checkout age verification</span>
        </div>
        <div class="age-buttons">
          <button id="enterSite" type="button">Enter Site</button>
          <button id="exitSite" type="button">I am under 18</button>
        </div>
      </div>
    </div>

    <%- include("../partials/header") %>

    <main id="home">

      <%
        /* ── V4 data setup ── */

        /* Hero carousel: up to 5 best sellers, fallback to featured */
        const v4CarouselProds = (bestSellerProducts && bestSellerProducts.length
          ? bestSellerProducts
          : (featuredProducts && featuredProducts.length ? featuredProducts : [])
        ).slice(0, 5);

        /* Strength → CSS suffix */
        const v4sc = (s) => {
          const n = ((s || '').toLowerCase()).replace(/[\s\-]/g, '');
          if (n === 'low')    return 'low';
          if (n === 'medium') return 'medium';
          if (n === 'strong') return 'strong';
          if (n === 'xstrong') return 'xstrong';
          return 'extreme';
        };

        /* Collections */
        const svCollections    = homepageContent?.collections || {};
        const svCollectionCards = svCollections.cards && svCollections.cards.length
          ? svCollections.cards
          : [
              { number:"01", title:"Mint & Ice Flavours",   text:"Clean, cool and reliable. The most popular flavour category across all brands.", linkText:"Shop Mint",    linkUrl:"/shop?flavour=mint",             imageSrc:"/images/social/s-1.jpeg"  },
              { number:"02", title:"Strong Selections",     text:"",                                                                                linkText:"Shop Strong", linkUrl:"/shop?strength=STRONG",          imageSrc:"/images/social/s-6.jpeg"  },
              { number:"03", title:"Fruity Flavours",       text:"",                                                                                linkText:"Shop Fruit",  linkUrl:"/shop",                          imageSrc:"/images/social/s-10.jpeg" },
              { number:"04", title:"Tobacco-Free Pouches",  text:"",                                                                                linkText:"Shop Pouches",linkUrl:"/shop?category=Nicotine%20Pouches",imageSrc:"/images/social/s-4.jpeg" },
            ];

        /* Remove vapes from collection cards */
        const unavailableCollPath = "/collections/" + "va" + "pes";
        const v4CollCards = svCollectionCards
          .filter(c => !String(c.linkUrl || '').includes(unavailableCollPath))
          .slice(0, 4);
        const v4CollColors = ['v4-coll-c1','v4-coll-c2','v4-coll-c3','v4-coll-c4'];

        /* Locations */
        const svLocations     = homepageContent?.locations || {};
        const svLocationCards = svLocations.cards && svLocations.cards.length
          ? svLocations.cards
          : [
              { label:"London Branch", title:"Camden Town",   description:"Central North London access with a strong range of best-selling products.",  mapUrl:"https://www.google.com/maps?q=Camden+Town+London&output=embed",        mapTitle:"Camden Town",   buttonText:"Ask About Stock", buttonLink:"/contact" },
              { label:"London Branch", title:"Oxford Street",  description:"Easy access for shoppers near one of London's busiest retail destinations.", mapUrl:"https://www.google.com/maps?q=Oxford+Street+London&output=embed",       mapTitle:"Oxford Street", buttonText:"Ask About Stock", buttonLink:"/contact" },
              { label:"London Branch", title:"Edgware Road",   description:"Convenient West London area for quick visits and product enquiries.",        mapUrl:"https://www.google.com/maps?q=89+Edgware+Road+London&output=embed",    mapTitle:"Edgware Road",  buttonText:"Ask About Stock", buttonLink:"/contact" },
            ];

        /* Distro */
        const svDistro       = homepageContent?.distro || {};
        const svDistroBadges = svDistro.badges && svDistro.badges.length
          ? svDistro.badges
          : ["Stock Support","Trade Enquiries","Southall","18+ Only"];

        /* Social */
        const svSocial      = homepageContent?.social || {};
        const svSocialSlides = svSocial.slides && svSocial.slides.length
          ? svSocial.slides
          : [
              { videoSrc:"/videos/social/social-1.mp4", posterSrc:"/images/header/h-1.jpeg",       title:"New Stock Arrival",   subtitle:"Latest Product Highlights From Snus Village" },
              { videoSrc:"/videos/social/social-2.mp4", posterSrc:"/images/header/h-2.webp",       title:"In-Store Content",    subtitle:"Store Moments, Promotions, And Customer Favourites" },
              { videoSrc:"/videos/social/social-3.mp4", posterSrc:"/images/delivery/delivery.webp", title:"London Updates",      subtitle:"See What Is Happening Across Our Locations" },
            ];
      %>

      <!-- ========================
           HERO — split two-column
           ======================== -->
      <section class="v4-hero">

        <!-- Left copy -->
        <div class="v4-hero__copy">
          <span class="v4-hero__tag">London's Nicotine Pouch Specialist</span>
          <h1>Premium<br>Nicotine<br><span>Pouches</span><br>UK-Wide</h1>
          <p class="v4-hero__lead">100+ products from the world's most trusted brands. Age-verified checkout, three London stores and fast UK delivery from &pound;1.99.</p>
          <div class="v4-hero__btns">
            <a href="<%= (homepageContent?.hero?.slides?.[0]?.buttonLink) || '/shop' %>" class="v4-btn-red">
              <%= (homepageContent?.hero?.slides?.[0]?.buttonText) || 'Shop Now' %> <i class="fa-solid fa-arrow-right"></i>
            </a>
            <a href="#shops" class="v4-btn-navy">Find a Store</a>
          </div>
          <div class="v4-hero__trust">
            <div class="v4-hero__trust-item"><i class="fa-solid fa-shield-halved"></i> Age Verified</div>
            <div class="v4-hero__trust-item"><i class="fa-solid fa-truck-fast"></i> Delivery &pound;1.99+</div>
            <div class="v4-hero__trust-item"><i class="fa-solid fa-map-pin"></i> 3 London Stores</div>
            <div class="v4-hero__trust-item"><i class="fa-solid fa-certificate"></i> Authentic Stock</div>
          </div>
        </div>

        <!-- Right product panel — animated carousel -->
        <div class="v4-hero__products">
          <div class="v4-carousel" id="heroCarousel">
            <div class="v4-carousel__counter" id="carouselCounter"></div>
            <% if (v4CarouselProds.length) { %>
              <% v4CarouselProds.forEach((p, idx) => { %>
                <%
                  const cImg = p.images && p.images.length ? p.images[0] : null;
                  const cSc  = v4sc(p.strength);
                %>
                <div class="v4-carousel__slide <%= idx === 0 ? 'is-active' : '' %>" data-idx="<%= idx %>">
                  <% if (p.strength) { %>
                    <div class="v4-carousel__strength-badge v4-badge--<%= cSc %>"><%= p.strength %></div>
                  <% } %>
                  <div class="v4-carousel__img">
                    <% if (cImg) { %>
                      <img
                        src="<%= optimiseImageUrl(cImg, { width: 500 }) %>"
                        alt="<%= p.name %>"
                        loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
                        decoding="async"
                      />
                    <% } else { %>
                      <div class="v4-carousel__no-img"><i class="fa-solid fa-box-open"></i></div>
                    <% } %>
                  </div>
                  <a href="/products/<%= p.slug || p._id %>" class="v4-carousel__info">
                    <div class="v4-carousel__brand"><%= p.brand || 'Snus Village' %></div>
                    <div class="v4-carousel__name"><%= p.name %></div>
                    <% if (p.flavour) { %>
                      <div class="v4-carousel__flavour"><%= p.flavour %></div>
                    <% } %>
                    <div class="v4-carousel__cta">View Product <i class="fa-solid fa-arrow-right"></i></div>
                  </a>
                </div>
              <% }) %>
            <% } else { %>
              <div class="v4-carousel__slide is-active v4-carousel__empty">
                <div class="v4-carousel__img"><i class="fa-solid fa-box-open"></i></div>
                <div class="v4-carousel__info">
                  <div class="v4-carousel__brand">Snus Village</div>
                  <div class="v4-carousel__name">Products Coming Soon</div>
                </div>
              </div>
            <% } %>
            <% if (v4CarouselProds.length > 1) { %>
              <div class="v4-carousel__dots">
                <% v4CarouselProds.forEach((p, idx) => { %>
                  <button class="v4-carousel__dot <%= idx === 0 ? 'is-active' : '' %>" aria-label="Slide <%= idx + 1 %>"></button>
                <% }) %>
              </div>
            <% } %>
            <div class="v4-carousel__progress" id="carouselProgressWrap">
              <div class="v4-carousel__progress-fill" id="carouselProgress"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================
           ANNOUNCEMENT STRIP
           ======================== -->
      <div class="v4-strip" aria-hidden="true">
        <div class="v4-strip__track">
          <div class="v4-strip__item"><i class="fa-solid fa-shield-halved"></i> Age-Verified Checkout</div>
          <div class="v4-strip__item"><i class="fa-solid fa-truck-fast"></i> UK Delivery from &pound;1.99</div>
          <div class="v4-strip__item"><i class="fa-solid fa-map-pin"></i> Camden &middot; Oxford Street &middot; Edgware Road</div>
          <div class="v4-strip__item"><i class="fa-solid fa-certificate"></i> 100% Authentic Stock</div>
          <div class="v4-strip__item"><i class="fa-solid fa-box-open"></i> 100+ Products In Stock</div>
          <!-- duplicated for seamless loop -->
          <div class="v4-strip__item"><i class="fa-solid fa-shield-halved"></i> Age-Verified Checkout</div>
          <div class="v4-strip__item"><i class="fa-solid fa-truck-fast"></i> UK Delivery from &pound;1.99</div>
          <div class="v4-strip__item"><i class="fa-solid fa-map-pin"></i> Camden &middot; Oxford Street &middot; Edgware Road</div>
          <div class="v4-strip__item"><i class="fa-solid fa-certificate"></i> 100% Authentic Stock</div>
          <div class="v4-strip__item"><i class="fa-solid fa-box-open"></i> 100+ Products In Stock</div>
        </div>
      </div>

      <!-- ========================
           BEST SELLERS
           ======================== -->
      <section class="v4-products" id="bestsellers">
        <div class="v4-wrap">
          <div class="v4-section-head">
            <div>
              <div class="v4-eyebrow">Customer Favourites</div>
              <h2>Best Sellers</h2>
            </div>
            <a href="/shop" class="v4-section-link">View all products</a>
          </div>

          <% if (bestSellerProducts && bestSellerProducts.length) { %>
            <div class="v4-products-grid">
              <% bestSellerProducts.forEach((p) => { %>
                <%
                  const bsFinalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
                  const bsSc = v4sc(p.strength);
                %>
                <a class="v4-product-card" href="/products/<%= p.slug || p._id %>">
                  <div class="v4-product-card__img">
                    <span class="v4-badge v4-badge--<%= bsSc %>"><%= p.strength || 'Medium' %></span>
                    <% if (p.discountPrice && p.discountPrice > 0) { %>
                      <span class="v4-sale-badge">Sale</span>
                    <% } %>
                    <% if (p.images && p.images.length) { %>
                      <img src="<%= optimiseImageUrl(p.images[0], { width: 400 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async" />
                    <% } else { %>
                      <span class="v4-product-card__img-none">No Image</span>
                    <% } %>
                    <div class="v4-sbar v4-sbar--<%= bsSc %>"></div>
                  </div>
                  <div class="v4-product-card__body">
                    <div class="v4-product-card__brand"><%= p.brand || 'Snus Village' %></div>
                    <div class="v4-product-card__name"><%= p.name %></div>
                    <div class="v4-product-card__foot">
                      <div class="v4-product-card__price">
                        <% if (p.discountPrice && p.discountPrice > 0) { %>
                          <span class="v4-product-card__price-old">&pound;<%= Number(p.price || 0).toFixed(2) %></span>
                        <% } %>
                        &pound;<%= Number(bsFinalPrice || 0).toFixed(2) %>
                      </div>
                      <span class="v4-product-card__btn">View</span>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="v4-products-grid">
              <div class="v4-empty-products">
                <p>Best sellers coming soon. <a href="/shop">Browse the full shop</a>.</p>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ========================
           RED CTA BAND
           ======================== -->
      <div class="v4-cta-band">
        <div class="v4-wrap">
          <div class="v4-cta-band__inner">
            <div>
              <h2>Shop Over 100 Premium Nicotine Pouches</h2>
              <p>Browse trusted brands, filter by strength or flavour, and order with age-verified checkout.</p>
            </div>
            <a href="/shop" class="v4-btn-white">Browse All Products <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </div>

      <!-- ========================
           BRAND SHOWCASE
           ======================== -->
      <section class="v4-brands">
        <div class="v4-wrap">
          <div class="v4-section-head v4-brands-section-head">
            <div>
              <div class="v4-eyebrow">Available Brands</div>
              <h2>Shop By Brand</h2>
            </div>
          </div>
        </div>
        <div class="v4-wrap">
          <div class="v4-brands-row">
            <a href="/shop?brand=WHITE%20FOX" class="v4-brand-card">
              <div class="v4-brand-card__name">White Fox</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=PABLO" class="v4-brand-card">
              <div class="v4-brand-card__name">Pablo</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=SIBERIA" class="v4-brand-card">
              <div class="v4-brand-card__name">Siberia</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=ICEBERG" class="v4-brand-card">
              <div class="v4-brand-card__name">Iceberg</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=KILLA" class="v4-brand-card">
              <div class="v4-brand-card__name">Killa</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=VELO" class="v4-brand-card">
              <div class="v4-brand-card__name">Velo</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop?brand=ZYN" class="v4-brand-card">
              <div class="v4-brand-card__name">Zyn</div>
              <div class="v4-brand-card__sub">View Range &rarr;</div>
            </a>
            <a href="/shop" class="v4-brand-card v4-brand-card--dark">
              <div class="v4-brand-card__name">All Brands</div>
              <div class="v4-brand-card__sub">View All &rarr;</div>
            </a>
          </div>
        </div>
      </section>

      <!-- ========================
           COLLECTIONS
           ======================== -->
      <section class="v4-collections" id="collections">
        <div class="v4-wrap">
          <div class="v4-section-head">
            <div>
              <div class="v4-eyebrow"><%= svCollections.eyebrow || 'Shop By Category' %></div>
              <h2><%= svCollections.heading || 'Find Your Perfect Pouch' %></h2>
            </div>
            <a href="<%= svCollections.buttonLink || '/shop' %>" class="v4-section-link"><%= svCollections.buttonText || 'Open Shop' %></a>
          </div>
        </div>
        <div class="v4-wrap">
          <div class="v4-coll-grid">
            <% v4CollCards.forEach((card, idx) => { %>
              <%
                const isMainCard = idx === 0;
                const collColorClass = v4CollColors[idx] || 'v4-coll-c1';
                const collImgStyle = card.imageSrc
                  ? `background-image:url('${optimiseImageUrl(card.imageSrc, { width: 1200 })}');`
                  : '';
              %>
              <article class="v4-coll-card <%= isMainCard ? 'v4-coll-card--main' : '' %> <%= collColorClass %>">
                <div class="v4-coll-card__bg" style="<%= collImgStyle %>"></div>
                <div class="v4-coll-card__overlay"></div>
                <div class="v4-coll-card__body">
                  <div class="v4-coll-card__num"><%= card.number || ('0' + (idx + 1)) %> &rarr;</div>
                  <h3><%= card.title || 'Collection' %></h3>
                  <% if (card.text) { %>
                    <p><%= card.text %></p>
                  <% } %>
                  <a href="<%= card.linkUrl || '/shop' %>" class="v4-coll-link"><%= card.linkText || 'Shop Now' %></a>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>

      <!-- ========================
           LOCATIONS + DISTRO
           ======================== -->
      <section class="v4-locations" id="shops">
        <div class="v4-wrap">
          <div class="v4-section-head">
            <div>
              <div class="v4-eyebrow"><%= svLocations.eyebrow || 'London Stores' %></div>
              <h2><%= svLocations.heading || 'Find Snus Village Near You' %></h2>
            </div>
            <a href="<%= svLocations.buttonLink || '/contact' %>" class="v4-section-link"><%= svLocations.buttonText || 'Contact Us' %></a>
          </div>

          <div class="v4-loc-grid">
            <% svLocationCards.slice(0, 3).forEach((loc) => { %>
              <div class="v4-loc-card">
                <iframe
                  class="v4-loc-card__map"
                  loading="lazy"
                  src="<%= loc.mapUrl || 'https://www.google.com/maps?q=London&output=embed' %>"
                  title="<%= loc.mapTitle || loc.title || 'Snus Village' %>"
                ></iframe>
                <div class="v4-loc-card__body">
                  <div class="v4-loc-card__label"><%= loc.label || 'London Branch' %></div>
                  <h3><%= loc.title || 'Snus Village' %></h3>
                  <p><%= loc.description || '' %></p>
                  <a href="<%= loc.buttonLink || '/contact' %>" class="v4-loc-card__link"><%= loc.buttonText || 'Ask About Stock' %></a>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Distro panel -->
          <div class="v4-distro">
            <div class="v4-distro__copy">
              <div class="v4-distro__eyebrow"><%= svDistro.kicker || 'Distribution Hub' %></div>
              <h3><%= svDistro.title || 'SVG Distro' %></h3>
              <div class="v4-distro__addr"><%= svDistro.address || 'Snus Village Charles House, Southall' %></div>
              <p><%= svDistro.description || 'Our Southall hub supports stock availability, trade enquiries, local distribution and product support for adult customers and approved traders.' %></p>
              <div class="v4-distro__badges">
                <% svDistroBadges.forEach((badge) => { %>
                  <span class="v4-distro__badge"><%= badge %></span>
                <% }) %>
              </div>
              <a href="<%= svDistro.buttonLink || '/contact' %>" class="v4-btn-red" style="width:fit-content;">
                <%= svDistro.buttonText || 'Contact For Details' %> <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
            <div class="v4-distro__visual">
              <div class="v4-distro__visual-inner">
                <div class="v4-distro__visual-title">SVG<br>Distro</div>
                <div class="v4-distro__visual-sub">Southall &middot; London</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================
           SOCIAL SHOWCASE
           ======================== -->
      <section class="v4-social" id="social-showcase">
        <div class="v4-wrap v4-social__inner">

          <!-- Left copy -->
          <div class="v4-social__copy">
            <div class="v4-eyebrow"><%= svSocial.eyebrow || 'Social Media' %></div>
            <h2>See Snus Village <span><%= svSocial.heading ? '' : 'In Action' %></span><%= svSocial.heading || '' %></h2>
            <p><%= svSocial.description || 'Discover new stock, best sellers, promotions, branch updates and behind-the-scenes clips from Snus Village.' %></p>
            <div class="v4-social__points">
              <div class="v4-social__point">
                <div class="v4-social__point-icon"><i class="fa-solid fa-box-open"></i></div>
                <div>
                  <strong>New Stock</strong>
                  <span>See fresh arrivals and best-selling products as they land in store.</span>
                </div>
              </div>
              <div class="v4-social__point">
                <div class="v4-social__point-icon"><i class="fa-solid fa-map-pin"></i></div>
                <div>
