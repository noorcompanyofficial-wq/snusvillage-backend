<section class="shop-page">
  <div class="shop-hero">
    <div class="shop-hero__content">
      <span class="shop-eyebrow">All Products</span>
      <h1>Shop Premium Snus & Nicotine Pouches</h1>
      <p>
        Browse trusted nicotine pouch brands, strengths, flavours and fast-moving stock from Snus Village.
      </p>

      <div class="shop-hero__badges">
        <span>18+ Only</span>
        <span>Authentic Stock</span>
        <span>Fast UK Delivery</span>
        <span>London Retail Support</span>
      </div>
    </div>
  </div>

  <div class="shop-toolbar">
    <form class="shop-search-form" action="/shop" method="GET">
      <div class="shop-search-box">
        <label for="shopSearch">Search Products</label>
        <input
          id="shopSearch"
          type="text"
          name="search"
          value="<%= query?.search || '' %>"
          placeholder="Search Brand, Flavour Or Product..."
        >
      </div>

      <div class="shop-filter-box">
        <label for="shopStrength">Strength</label>
        <select id="shopStrength" name="strength">
          <option value="">All Strengths</option>
          <option value="LOW" <%= query?.strength === "LOW" ? "selected" : "" %>>Low</option>
          <option value="MEDIUM" <%= query?.strength === "MEDIUM" ? "selected" : "" %>>Medium</option>
          <option value="STRONG" <%= query?.strength === "STRONG" ? "selected" : "" %>>Strong</option>
          <option value="X-STRONG" <%= query?.strength === "X-STRONG" ? "selected" : "" %>>X-Strong</option>
          <option value="EXTREME" <%= query?.strength === "EXTREME" ? "selected" : "" %>>Extreme</option>
        </select>
      </div>

      <div class="shop-filter-box">
        <label for="shopBrand">Brand</label>
        <input
          id="shopBrand"
          type="text"
          name="brand"
          value="<%= query?.brand || '' %>"
          placeholder="White Fox, Pablo..."
        >
      </div>

      <div class="shop-filter-box">
        <label for="shopFlavour">Flavour</label>
        <input
          id="shopFlavour"
          type="text"
          name="flavour"
          value="<%= query?.flavour || '' %>"
          placeholder="Mint, Pineapple, Berry..."
        >
      </div>

      <div class="shop-filter-actions">
        <button type="submit">Filter</button>
        <a href="/shop">Reset</a>
      </div>
    </form>
  </div>

  <% if (!products || products.length === 0) { %>
    <div class="empty-shop">
      <span>0 Products</span>
      <h2>No Products Available Yet</h2>
      <p>Add Products From The Admin Dashboard To Show Them Here.</p>
      <a href="/contact">Contact Us</a>
    </div>
  <% } else { %>
    <div class="shop-results-head">
      <div>
        <span class="shop-eyebrow">Available Now</span>
        <h2>Product Collection</h2>
      </div>

      <p>
        <%= totalProducts || products.length %> Product<%= (totalProducts || products.length) === 1 ? "" : "s" %>
        Across <%= brandSections.length %> Brand<%= brandSections.length === 1 ? "" : "s" %>
      </p>
    </div>

    <div class="shop-brand-layout">
      <% brandSections.forEach(section => { %>
        <section class="shop-brand-section" id="brand-<%= section.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
          <div class="shop-brand-head">
            <div>
              <span class="shop-brand-kicker">Brand Range</span>
              <h3><%= section.brand %></h3>
            </div>

            <span class="shop-brand-count">
              <%= section.count %> Product<%= section.count === 1 ? "" : "s" %>
            </span>
          </div>

          <div class="shop-brand-carousel-wrap">
            <button type="button" class="shop-brand-arrow shop-brand-arrow--prev" aria-label="Scroll <%= section.brand %> Left">‹</button>

            <div class="shop-brand-products" data-brand-carousel>
              <% section.products.forEach(p => { %>
              <% const finalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price; %>

              <article class="shop-product-card">
                <div class="shop-product-badges">
                  <% if (p.showSaleBadge && p.discountPrice && p.discountPrice > 0) { %>
                    <span class="shop-product-badge sale">Sale</span>
                  <% } %>
                  <% if (p.isBestSeller) { %>
                    <span class="shop-product-badge best">Best Seller</span>
                  <% } %>
                  <% if (p.isFeatured) { %>
                    <span class="shop-product-badge featured">Featured</span>
                  <% } %>
                </div>

                <a href="/products/<%= p._id %>" class="shop-product-image">
                  <% if (p.images && p.images.length > 0) { %>
                    <img src="<%= optimiseImageUrl(p.images[0], { width: 420 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async">
                  <% } else { %>
                    <span>No Image</span>
                  <% } %>
                </a>

                <div class="shop-product-body">
                  <div class="shop-product-top">
                    <span class="strength-badge"><%= p.strength || "Normal" %></span>
                    <span class="<%= p.stock > 0 ? 'shop-stock in' : 'shop-stock out' %>">
                      <%= p.stock > 0 ? "In Stock" : "Out Of Stock" %>
                    </span>
                  </div>

                  <h2>
                    <a href="/products/<%= p._id %>"><%= p.name %></a>
                  </h2>

                  <p>
                    <%= p.description ? p.description.substring(0, 96) : "Premium Product From Snus Village." %><%= p.description && p.description.length > 96 ? "..." : "" %>
                  </p>

                  <div class="shop-product-meta">
                    <span><%= p.brand || "Brand N/A" %></span>
                    <span><%= p.nicotine ? p.nicotine + "mg" : "Nicotine N/A" %></span>
                  </div>

                  <div class="shop-product-bottom">
                    <div class="shop-price-wrap">
                      <% if (p.discountPrice && p.discountPrice > 0) { %>
                        <small>£<%= p.price.toFixed(2) %></small>
                      <% } %>
                      <strong>£<%= finalPrice.toFixed(2) %></strong>
                    </div>

                    <% if (p.stock > 0) { %>
                      <form action="/cart/add/<%= p._id %>" method="POST">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit">Add To Cart</button>
                      </form>
                    <% } else { %>
                      <a class="shop-view-btn" href="/products/<%= p._id %>">View Product</a>
                    <% } %>
                  </div>
                </div>
              </article>
              <% }) %>
            </div>

            <button type="button" class="shop-brand-arrow shop-brand-arrow--next" aria-label="Scroll <%= section.brand %> Right">›</button>
          </div>
</section>


      <% }) %>
    </div>
  <% } %>

  <section class="seo-support-copy">
    <h2>Shop Nicotine Pouches At Snus Village</h2>
    <p>
      Snus Village helps adult customers browse trusted nicotine pouch brands,
      flavours and strength levels in one place. The shop is organised
      so customers can search by product name, brand, flavour or strength before adding
      items to the basket.
    </p>
    <p>
      Every order is built around age-restricted checkout, clear product information,
      secure payment and UK delivery or collection options where available. Popular
      ranges include strong nicotine pouches, mint flavours, fruit flavours and
      well-known brands selected for adult customers looking for reliable stock.
    </p>
  </section>
</section>
