<section class="shop-page">
  <div class="shop-hero">
    <span class="eyebrow">SHOP</span>
    <h1>Shop Collection</h1>
    <p>Browse premium snus products by brand, strength, and flavour.</p>

    <div class="shop-filter-row">
      <button type="button">All</button>
      <button type="button">Brands</button>
      <button type="button">Strength</button>
      <button type="button">Flavours</button>
    </div>
  </div>

  <% if (!products || products.length === 0) { %>
    <div class="empty-shop">
      <h2>No products available yet</h2>
      <p>Add products from the admin dashboard to show them here.</p>
    </div>
  <% } else { %>
    <div class="shop-grid">
      <% products.forEach(p => { %>
        <article class="shop-product-card">
          <a href="/products/<%= p._id %>" class="shop-product-image">
            <% if (p.images && p.images.length > 0) { %>
              <img src="<%= p.images[0] %>" alt="<%= p.name %>">
            <% } else { %>
              <span>No image</span>
            <% } %>
          </a>

          <div class="shop-product-body">
            <div class="shop-product-top">
              <span class="strength-badge"><%= p.strength || "NORMAL" %></span>
              <span class="<%= p.stock > 0 ? 'shop-stock in' : 'shop-stock out' %>">
                <%= p.stock > 0 ? "In Stock" : "Out" %>
              </span>
            </div>

            <h2>
              <a href="/products/<%= p._id %>"><%= p.name %></a>
            </h2>

            <p>
              <%= p.description ? p.description.substring(0, 90) : "Premium product from Snus Village." %><%= p.description && p.description.length > 90 ? "..." : "" %>
            </p>

            <div class="shop-product-meta">
              <span><%= p.brand || "Brand N/A" %></span>
              <span><%= p.nicotine ? p.nicotine + "mg" : "Nicotine N/A" %></span>
            </div>

            <div class="shop-product-bottom">
              <strong>£<%= p.price.toFixed(2) %></strong>

              <% if (p.stock > 0) { %>
                <form action="/cart/add/<%= p._id %>" method="POST">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit">Add</button>
                </form>
              <% } else { %>
                <a href="/products/<%= p._id %>">View</a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>