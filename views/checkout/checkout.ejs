<!-- ── Breadcrumb bar ── -->
<div class="ck4-crumb">
  <div class="ck4-wrap">
    <nav class="ck4-crumb__nav" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>Checkout</span>
    </nav>
  </div>
</div>

<div
  class="checkout-page"
  data-subtotal="<%= subtotal.toFixed(2) %>"
  data-shipping="<%= shipping.toFixed(2) %>"
  data-discount="<%= discountAmount.toFixed(2) %>"
  data-total="<%= total.toFixed(2) %>"
  data-free-shipping-threshold="<%= typeof freeShippingThreshold !== "undefined" ? freeShippingThreshold : 10 %>"
  data-standard-shipping-fee="<%= typeof standardShippingFee !== "undefined" ? standardShippingFee : 1.99 %>"
  data-next-day-shipping-fee="<%= typeof nextDayShippingFee !== "undefined" ? nextDayShippingFee : 4.99 %>"
  data-next-day-cutoff="<%= typeof nextDayDeliveryCutoff !== "undefined" ? nextDayDeliveryCutoff : "4:30pm" %>"
>
  <section class="checkout-form-panel">
    <div class="ck4-eyebrow">Secure Checkout</div>
    <h1>Complete your <em>order.</em></h1>

    <form action="/checkout/place-order" method="POST" id="checkoutForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="ck4-section-label"><span>01</span>Contact</div>
      <input type="email" name="email" placeholder="Email" required>

      <div class="checkout-row">
        <input type="text" name="firstName" placeholder="First Name" required>
        <input type="text" name="lastName" placeholder="Last Name" required>
      </div>

      <input type="text" name="phone" placeholder="Phone" required>

      <div class="ck4-section-label"><span>02</span>Fulfilment</div>

      <div class="checkout-fulfilment-options">
        <label class="checkout-fulfilment-card is-active" data-fulfilment-card="delivery">
          <input type="radio" name="fulfilmentMethod" value="delivery" checked>
          <span>
            <strong>Delivery</strong>
            <small>Pay online and have your order delivered.</small>
          </span>
        </label>

        <label class="checkout-fulfilment-card" data-fulfilment-card="click_collect">
          <input type="radio" name="fulfilmentMethod" value="click_collect">
          <span>
            <strong>Click & Collect</strong>
            <small>Pay online and collect from Edgware Road only.</small>
          </span>
        </label>
      </div>

      <div class="checkout-collect-notice" id="clickCollectNotice" hidden>
        <strong>Collection Address</strong>
        <span><%= checkoutSettings?.clickCollectAddress || "SNUS VILLAGE, EDGWARE ROAD, TYBURNIA, London, W2 2HX" %></span>
        <small>Your order will not be sent to Royal Mail. Bring your order confirmation and valid ID when collecting.</small>
      </div>

      <div id="deliveryFields">
        <div class="ck4-section-label"><span>03</span>Delivery</div>

        <div class="checkout-delivery-service-options" id="deliveryServiceOptions">
          <label class="checkout-delivery-service-card is-active" data-delivery-service-card="standard">
            <input type="radio" name="deliveryService" value="standard" checked>
            <span>
              <strong>Standard Delivery</strong>
              <small>
                <% if (subtotal >= (typeof freeShippingThreshold !== "undefined" ? freeShippingThreshold : 10)) { %>
                  Free for this order.
                <% } else { %>
                  £<%= (typeof standardShippingFee !== "undefined" ? standardShippingFee : 1.99).toFixed(2) %>, or free over £<%= (typeof freeShippingThreshold !== "undefined" ? freeShippingThreshold : 10).toFixed(2) %>.
                <% } %>
              </small>
            </span>
          </label>

          <label class="checkout-delivery-service-card" data-delivery-service-card="next_day">
            <input type="radio" name="deliveryService" value="next_day">
            <span>
              <strong>Royal Mail Next Day</strong>
              <small>£<%= (typeof nextDayShippingFee !== "undefined" ? nextDayShippingFee : 4.99).toFixed(2) %>. Order before <%= typeof nextDayDeliveryCutoff !== "undefined" ? nextDayDeliveryCutoff : "4:30pm" %>.</small>
            </span>
          </label>
        </div>

        <select name="country" required>
          <option value="United Kingdom">United Kingdom</option>
        </select>

        <input type="text" name="address" placeholder="Address" required>

        <div class="checkout-row">
          <input type="text" name="city" placeholder="City" required>
          <input type="text" name="postcode" placeholder="Postcode" required>
        </div>
      </div>

      <div class="ck4-section-label"><span>04</span>Payment</div>
      <div class="checkout-sumup-notice">
        <strong>Secure SumUp Payment</strong>
        <span><%= checkoutSettings?.checkoutNotice || "You Will Be Redirected To SumUp To Complete Your Card Payment Securely." %></span>
      </div>

      <div
        class="checkout-express"
        id="checkoutExpress"
        data-sumup-public-key="<%= sumupPublicKey || "" %>"
        data-google-pay-merchant-id="<%= googlePayMerchantId || "" %>"
        hidden
      >
        <div class="checkout-express__label">Express checkout</div>
        <div id="expressCheckoutContainer"></div>
        <div class="checkout-wallet-error" id="checkoutWalletError" role="alert" aria-live="polite"></div>
        <div class="checkout-payment-separator"><span>Or pay securely by card</span></div>
      </div>

      <div class="payment-methods checkout-payment-methods" aria-label="Accepted payment methods">
        <span>Accepted via SumUp</span>
        <strong>Visa</strong>
        <strong>Mastercard</strong>
        <strong>Debit/Credit Cards</strong>
      </div>

      <label class="checkout-age-confirm">
        <input type="checkbox" name="ageConfirm" value="yes" required>
        <span>I confirm I am 18 or over.</span>
      </label>

      <button type="submit" class="pay-now-btn">
        Pay Securely With SumUp
      </button>
    </form>
  </section>

  <aside class="checkout-summary-panel">
    <div class="ck4-summary-label">Order Summary</div>

    <% cart.items.forEach(item => { %>
      <% if (item.product) { %>
        <div class="checkout-item">
          <div class="checkout-item-image">
            <% if (item.product.images && item.product.images.length > 0) { %>
              <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
            <% } %>
          </div>

          <div>
            <h3><%= item.product.name %></h3>
            <p><%= item.product.description || item.product.brand || "Snus Village product" %></p>
            <span>Qty: <%= item.quantity %></span>
          </div>

          <strong>
            £<%= ((item.priceAtTime || item.product.price || 0) * item.quantity).toFixed(2) %>
          </strong>
        </div>
      <% } %>
    <% }) %>

    <div class="checkout-discount-box">
      <% if (appliedDiscountCode) { %>
        <div class="checkout-applied-discount">
          <div>
            <span>Discount Applied</span>
            <strong><%= appliedDiscountCode %></strong>
          </div>

          <form action="/checkout/remove-discount" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit">Remove</button>
          </form>
        </div>
      <% } else { %>
        <form action="/checkout/apply-discount" method="POST" class="discount-row">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="discountCode" placeholder="Discount Code">
          <button type="submit">Apply</button>
        </form>
      <% } %>
    </div>

    <div class="checkout-total-row">
      <span>Subtotal</span>
      <strong>£<%= subtotal.toFixed(2) %></strong>
    </div>

    <div class="checkout-total-row">
      <span>Shipping</span>
      <strong id="checkoutShippingAmount"><%= shipping === 0 ? "Free" : "£" + shipping.toFixed(2) %></strong>
    </div>

    <% if (discountAmount && discountAmount > 0) { %>
      <div class="checkout-total-row checkout-discount-total">
        <span>Discount</span>
        <strong>-£<%= discountAmount.toFixed(2) %></strong>
      </div>
    <% } %>

    <div class="checkout-free-shipping-note" id="checkoutShippingNote">
      <% if (subtotal >= (typeof freeShippingThreshold !== "undefined" ? freeShippingThreshold : 10)) { %>
        You qualify for free delivery.
      <% } else { %>
        Spend £<%= ((typeof freeShippingThreshold !== "undefined" ? freeShippingThreshold : 10) - subtotal).toFixed(2) %> more to get free delivery.
      <% } %>
    </div>

    <div class="checkout-grand-total">
      <span>Total</span>
      <strong id="checkoutGrandTotal">£<%= total.toFixed(2) %></strong>
    </div>
  </aside>
</div>

<% if (sumupPublicKey) { %>
  <script src="https://js.sumup.com/swift-checkout/v1/sdk.js"></script>
<% } %>

<script>
  (function () {
    const checkoutPage = document.querySelector(".checkout-page");
    const deliveryFields = document.getElementById("deliveryFields");
    const deliveryServiceOptions = document.getElementById("deliveryServiceOptions");
    const collectNotice = document.getElementById("clickCollectNotice");
    const radios = document.querySelectorAll('input[name="fulfilmentMethod"]');
    const cards = document.querySelectorAll("[data-fulfilment-card]");
    const deliveryServiceRadios = document.querySelectorAll('input[name="deliveryService"]');
    const deliveryServiceCards = document.querySelectorAll("[data-delivery-service-card]");
    const deliveryInputs = deliveryFields ? deliveryFields.querySelectorAll("input, select") : [];

    const shippingAmount = document.getElementById("checkoutShippingAmount");
    const grandTotal = document.getElementById("checkoutGrandTotal");
    const shippingNote = document.getElementById("checkoutShippingNote");
    const checkoutForm = document.getElementById("checkoutForm");
    const expressArea = document.getElementById("checkoutExpress");
    const expressContainer = document.getElementById("expressCheckoutContainer");
    const walletError = document.getElementById("checkoutWalletError");
    const cardButton = checkoutForm?.querySelector(".pay-now-btn");

    const subtotal = Number(checkoutPage?.dataset.subtotal || 0);
    const discount = Number(checkoutPage?.dataset.discount || 0);
    const freeShippingThreshold = Number(checkoutPage?.dataset.freeShippingThreshold || 10);
    const standardShippingFee = Number(checkoutPage?.dataset.standardShippingFee || 1.99);
    const nextDayShippingFee = Number(checkoutPage?.dataset.nextDayShippingFee || 4.99);
    const nextDayCutoff = checkoutPage?.dataset.nextDayCutoff || "4:30pm";
    let currentTotal = Number(checkoutPage?.dataset.total || 0);
    let walletPaymentRequest = null;
    let walletButtons = null;
    let walletProcessing = false;

    function formatMoney(value) {
      return "£" + Number(value || 0).toFixed(2);
    }

    function updateShipping(selected) {
      const isCollect = selected === "click_collect";
      const selectedDeliveryService =
        document.querySelector('input[name="deliveryService"]:checked')?.value || "standard";
      const shipping = isCollect
        ? 0
        : selectedDeliveryService === "next_day"
          ? nextDayShippingFee
          : subtotal >= freeShippingThreshold
            ? 0
            : standardShippingFee;
      const total = Math.max(0, subtotal + shipping - discount);
      currentTotal = total;

      if (shippingAmount) {
        shippingAmount.textContent = shipping === 0 ? "Free" : formatMoney(shipping);
      }

      if (grandTotal) {
        grandTotal.textContent = formatMoney(total);
      }

      if (shippingNote) {
        if (isCollect) {
          shippingNote.textContent = "Click & Collect is free.";
        } else if (selectedDeliveryService === "next_day") {
          shippingNote.textContent =
            "Royal Mail Next Day costs " + formatMoney(nextDayShippingFee) + ". Order before " + nextDayCutoff + ".";
        } else if (subtotal >= freeShippingThreshold) {
          shippingNote.textContent = "You qualify for free delivery.";
        } else {
          shippingNote.textContent =
            "Spend " + formatMoney(freeShippingThreshold - subtotal) + " more to get free delivery.";
        }
      }

      refreshWalletPaymentRequest();
    }

    function createWalletPaymentRequest() {
      if (!window.SumUp?.SwiftCheckout || !expressArea?.dataset.sumupPublicKey) {
        return null;
      }

      const client = window.checkoutSwiftClient;
      const request = {
        countryCode: "GB",
        locale: "en-GB",
        total: {
          label: "Snus Village",
          amount: { currency: "GBP", value: currentTotal.toFixed(2) },
        },
      };

      if (expressArea.dataset.googlePayMerchantId) {
        request.methodData = [{
          supportedMethods: "google_pay",
          data: {
            merchantInfo: {
              merchantId: expressArea.dataset.googlePayMerchantId,
              merchantName: "Snus Village",
            },
          },
        }];
      }

      return client.paymentRequest(request);
    }

    function refreshWalletPaymentRequest() {
      if (window.checkoutSwiftClient) {
        walletPaymentRequest = createWalletPaymentRequest();
      }
    }

    function showWalletError(message) {
      if (walletError) walletError.textContent = message || "";
    }

    function setPaymentProcessing(processing) {
      walletProcessing = processing;
      if (cardButton) cardButton.disabled = processing;
      if (expressArea) expressArea.classList.toggle("is-processing", processing);
    }

    async function startWalletPayment(paymentMethodEvent) {
      if (walletProcessing || !checkoutForm || !walletPaymentRequest) return;

      showWalletError("");

      if (!checkoutForm.reportValidity()) {
        checkoutForm.querySelector(":invalid")?.focus();
        return;
      }

      setPaymentProcessing(true);
      let returnUrl = "";

      try {
        const paymentResponse = await walletPaymentRequest.show(paymentMethodEvent);
        const formData = new FormData(checkoutForm);
        formData.set("paymentFlow", "wallet");

        const response = await fetch(checkoutForm.action, {
          method: "POST",
          body: new URLSearchParams(formData),
          headers: { Accept: "application/json" },
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success || !result.checkoutId || !result.returnUrl) {
          throw new Error(result.message || "Express checkout could not be started.");
        }

        returnUrl = result.returnUrl;
        await window.checkoutSwiftClient.processCheckout(result.checkoutId, paymentResponse);
        window.location.assign(returnUrl);
      } catch (error) {
        const cancelledError = window.SumUp?.SwiftCheckout?.Errors?.PaymentRequestCancelledError;

        if (returnUrl) {
          window.location.assign(returnUrl);
          return;
        }

        if (cancelledError && error instanceof cancelledError) {
          showWalletError("Express checkout was cancelled. You have not been charged.");
        } else {
          showWalletError(error?.message || "Express checkout is unavailable. Please pay securely by card.");
        }
        setPaymentProcessing(false);
      }
    }

    async function initialiseExpressCheckout() {
      const publicKey = expressArea?.dataset.sumupPublicKey;

      if (!publicKey || !window.SumUp?.SwiftCheckout || !expressContainer) return;

      try {
        window.checkoutSwiftClient = new window.SumUp.SwiftCheckout(publicKey);
        refreshWalletPaymentRequest();

        if (!walletPaymentRequest || !(await walletPaymentRequest.canMakePayment())) return;

        let paymentMethods = await walletPaymentRequest.availablePaymentMethods();

        if (!expressArea.dataset.googlePayMerchantId) {
          paymentMethods = paymentMethods.filter((method) => method.id !== "google_pay");
        }

        if (!paymentMethods.length) return;

        walletButtons = window.checkoutSwiftClient.elements({ label: "buy" });
        walletButtons.onSubmit(startWalletPayment).mount({
          paymentMethods,
          container: expressContainer,
        });
        expressArea.hidden = false;
      } catch (error) {
        console.warn("SumUp express checkout unavailable:", error?.message || error);
      }
    }

    function updateFulfilment() {
      const selected = document.querySelector('input[name="fulfilmentMethod"]:checked')?.value || "delivery";
      const isCollect = selected === "click_collect";

      if (deliveryFields) {
        deliveryFields.hidden = isCollect;
      }

      if (collectNotice) {
        collectNotice.hidden = !isCollect;
      }

      if (deliveryServiceOptions) {
        deliveryServiceOptions.hidden = isCollect;
      }

      deliveryInputs.forEach((input) => {
        if (isCollect) {
          input.removeAttribute("required");
        } else {
          input.setAttribute("required", "required");
        }
      });

      cards.forEach((card) => {
        card.classList.toggle("is-active", card.dataset.fulfilmentCard === selected);
      });

      deliveryServiceRadios.forEach((radio) => {
        radio.disabled = isCollect;
      });

      updateShipping(selected);
    }

    radios.forEach((radio) => {
      radio.addEventListener("change", updateFulfilment);
    });

    deliveryServiceRadios.forEach((radio) => {
      radio.addEventListener("change", function () {
        deliveryServiceCards.forEach((card) => {
          card.classList.toggle("is-active", card.dataset.deliveryServiceCard === radio.value && radio.checked);
        });

        updateShipping(document.querySelector('input[name="fulfilmentMethod"]:checked')?.value || "delivery");
      });
    });

    updateFulfilment();
    initialiseExpressCheckout();
  })();
</script>
