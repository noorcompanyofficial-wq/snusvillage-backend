<div class="checkout-page">
  <section class="checkout-form-panel">
    <h1>SNUS VILLAGE</h1>

    <form action="/didit/start" method="POST" id="checkoutDiditForm"></form>

    <form action="/checkout/place-order" method="POST" id="checkoutForm">
      <h3>Contact</h3>
      <input type="email" name="email" placeholder="Email" required>

      <div class="checkout-row">
        <input type="text" name="firstName" placeholder="First Name" required>
        <input type="text" name="lastName" placeholder="Last Name" required>
      </div>

      <input type="text" name="phone" placeholder="Phone" required>

      <h3>Fulfilment</h3>

      <div class="checkout-fulfilment-options">
        <label class="checkout-fulfilment-card is-active" data-fulfilment-card="delivery">
          <input type="radio" name="fulfilmentMethod" value="delivery" checked>
          <span>
            <strong>Delivery</strong>
            <small>Pay online and have your order delivered.</small>
          </span>
        </label>

        <label class="checkout-fulfilment-card" data-fulfilment-card="click_collect">
          <input type="radio" name="fulfilmentMethod" value="click_collect">
          <span>
            <strong>Click & Collect</strong>
            <small>Pay online and collect from Edgware Road only.</small>
          </span>
        </label>
      </div>

      <div class="checkout-collect-notice" id="clickCollectNotice" hidden>
        <strong>Collection Address</strong>
        <span>SNUS VILLAGE, EDGWARE ROAD, TYBURNIA, London, W2 2HX</span>
        <small>Your order will not be sent to Royal Mail. Bring your order confirmation and valid ID when collecting.</small>
      </div>

      <div id="deliveryFields">
        <h3>Delivery</h3>

        <select name="country" required>
          <option value="United Kingdom">United Kingdom</option>
        </select>

        <input type="text" name="address" placeholder="Address" required>

        <div class="checkout-row">
          <input type="text" name="city" placeholder="City" required>
          <input type="text" name="postcode" placeholder="Postcode" required>
        </div>
      </div>

      <h3>Payment</h3>
      <div class="checkout-sumup-notice">
        <strong>Secure SumUp Payment</strong>
        <span>You Will Be Redirected To SumUp To Complete Your Card Payment Securely.</span>
      </div>

      <% if (verificationRequired) { %>
        <div class="checkout-verification-inline">
          <div>
            <strong>Age Verification Required</strong>
            <span>Please complete age verification before paying with SumUp.</span>
          </div>

          <button type="submit" form="checkoutDiditForm">
            Start Verification
          </button>
        </div>
      <% } %>

      <label class="checkout-age-confirm">
        <input type="checkbox" name="ageConfirm" value="yes" required>
        <span>I confirm I am 18+ and understand age verification may be required before receiving my order.</span>
      </label>

      <button type="submit" class="pay-now-btn" <%= verificationRequired ? "disabled" : "" %>>
        <%= verificationRequired ? "Complete Verification First" : "Pay Securely With SumUp" %>
      </button>
    </form>
  </section>

  <aside class="checkout-summary-panel">
    <% cart.items.forEach(item => { %>
      <% if (item.product) { %>
        <div class="checkout-item">
          <div class="checkout-item-image">
            <% if (item.product.images && item.product.images.length > 0) { %>
              <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
            <% } %>
          </div>

          <div>
            <h3><%= item.product.name %></h3>
            <p><%= item.product.description || item.product.brand || "Snus Village product" %></p>
            <span>Qty: <%= item.quantity %></span>
          </div>

          <strong>
            £<%= ((item.priceAtTime || item.product.price || 0) * item.quantity).toFixed(2) %>
          </strong>
        </div>
      <% } %>
    <% }) %>

    <div class="checkout-discount-box">
      <% if (appliedDiscountCode) { %>
        <div class="checkout-applied-discount">
          <div>
            <span>Discount Applied</span>
            <strong><%= appliedDiscountCode %></strong>
          </div>

          <form action="/checkout/remove-discount" method="POST">
            <button type="submit">Remove</button>
          </form>
        </div>
      <% } else { %>
        <form action="/checkout/apply-discount" method="POST" class="discount-row">
          <input type="text" name="discountCode" placeholder="Discount Code">
          <button type="submit">Apply</button>
        </form>
      <% } %>
    </div>

    <div class="checkout-total-row">
      <span>Subtotal</span>
      <strong>£<%= subtotal.toFixed(2) %></strong>
    </div>

    <div class="checkout-total-row">
      <span>Shipping</span>
      <strong><%= shipping === 0 ? "Free" : "£" + shipping.toFixed(2) %></strong>
    </div>

    <% if (discountAmount && discountAmount > 0) { %>
      <div class="checkout-total-row checkout-discount-total">
        <span>Discount</span>
        <strong>-£<%= discountAmount.toFixed(2) %></strong>
      </div>
    <% } %>

    <div class="checkout-grand-total">
      <span>Total</span>
      <strong>£<%= total.toFixed(2) %></strong>
    </div>
  </aside>
</div>

<script>
  (function () {
    const deliveryFields = document.getElementById("deliveryFields");
    const collectNotice = document.getElementById("clickCollectNotice");
    const radios = document.querySelectorAll('input[name="fulfilmentMethod"]');
    const cards = document.querySelectorAll("[data-fulfilment-card]");
    const deliveryInputs = deliveryFields ? deliveryFields.querySelectorAll("input, select") : [];

    function updateFulfilment() {
      const selected = document.querySelector('input[name="fulfilmentMethod"]:checked')?.value || "delivery";
      const isCollect = selected === "click_collect";

      if (deliveryFields) {
        deliveryFields.hidden = isCollect;
      }

      if (collectNotice) {
        collectNotice.hidden = !isCollect;
      }

      deliveryInputs.forEach((input) => {
        if (isCollect) {
          input.removeAttribute("required");
        } else {
          input.setAttribute("required", "required");
        }
      });

      cards.forEach((card) => {
        card.classList.toggle("is-active", card.dataset.fulfilmentCard === selected);
      });
    }

    radios.forEach((radio) => {
      radio.addEventListener("change", updateFulfilment);
    });

    updateFulfilment();
  })();
</script>
