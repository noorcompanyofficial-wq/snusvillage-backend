<div class="checkout-success-page">
  <div class="success-card">
    <span class="success-icon">✓</span>

    <% const isClickCollect = order.fulfilment && order.fulfilment.method === "click_collect"; %>

    <% if (paymentPending) { %>
      <h1>Payment Pending</h1>

      <p>
        Your order has been saved, but payment has not been fully confirmed yet. If payment was completed, please wait a moment or contact us with your order ID.
      </p>
    <% } else if (isClickCollect) { %>
      <h1>Collection Order Confirmed</h1>

      <p>
        Thank you for your order. Your payment has been confirmed and your order will be prepared for collection at our Edgware Road branch.
      </p>
    <% } else { %>
      <h1>Order Confirmed</h1>

      <p>
        Thank you for your order. Your payment has been confirmed and your order is now being processed for delivery.
      </p>
    <% } %>

    <div class="success-order-box">
      <span>Order ID</span>
      <strong><%= order._id %></strong>
    </div>

    <div class="success-order-box">
      <span>Total</span>
      <strong>£<%= order.total.toFixed(2) %></strong>
    </div>

    <div class="success-order-box">
      <span>Payment</span>
      <strong><%= order.paymentStatus || "pending" %></strong>
    </div>

    <% if (isClickCollect) { %>
      <div class="success-collection-box">
        <span>Click & Collect</span>
        <strong>SNUS VILLAGE, EDGWARE ROAD, TYBURNIA, London, W2 2HX</strong>
        <p>
          Please bring your order confirmation and valid ID when collecting. This order will not be sent by Royal Mail.
        </p>
      </div>
    <% } else { %>
      <div class="success-collection-box">
        <span>Delivery</span>
        <strong><%= order.delivery?.postcode || "United Kingdom" %></strong>
        <p>
          Your order will be processed for delivery. You will receive updates if further information is needed.
        </p>
      </div>
    <% } %>

    <a href="/shop">Continue Shopping</a>
  </div>
</div>
