<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/google-tag') %>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />

    <% 
      const pageTitle = typeof title !== "undefined" && title
        ? title
        : "Snus Village | Premium Nicotine Pouches UK";

      const pageDescription = typeof description !== "undefined" && description
        ? description
        : "Shop premium nicotine pouches and smoke-free alternatives from Snus Village. London retail support, age-restricted checkout and fast UK delivery.";

      const pageUrl = typeof canonical !== "undefined" && canonical
        ? canonical
        : "https://www.snusvillage.com";
    %>

    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>">
    <%
      const noindexPaths = [
        "/cart",
        "/auth/login",
        "/auth/register",
        "/auth/forgot",
        "/auth/reset",
        "/auth/reset-verify",
        "/auth/verify",
        "/auth/dashboard"
      ];

      const robotsContent = typeof robots !== "undefined" && robots
        ? robots
        : (typeof currentPath !== "undefined" && noindexPaths.includes(currentPath)
          ? "noindex, nofollow"
          : "index, follow");
    %>
    <meta name="robots" content="<%= robotsContent %>">
    <link rel="canonical" href="<%= pageUrl %>">

    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:image" content="https://www.snusvillage.com/images/logo/snusvillage-logo.png">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">

    <!-- Fontawesome cdn link -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <!-- Core CSS Files -->
    <link rel="stylesheet" href="/css/age-gate.css" />
    <link rel="stylesheet" href="/css/style.css?v=light-theme-20260702" />
    <link rel="stylesheet" href="/css/header.css?v=megamenu-fix-20260713" />
    <link rel="stylesheet" href="/css/footer.css?v=footer-gradient-20260717" />
    <link rel="stylesheet" href="/css/site-theme.css?v=blueRed-header-20260713c" />

    <% 
      const pathNow = typeof currentPath !== "undefined" ? currentPath : "";
      const isShopPage = pathNow.startsWith("/shop");
      const isProductPage = pathNow.startsWith("/products");
      const isCollectionPage = pathNow.startsWith("/collections");
      const isCartPage = pathNow.startsWith("/cart");
      const isAuthPage = pathNow.startsWith("/auth");
      const isAboutPage = pathNow.startsWith("/about");
      const isWholesalePage = pathNow.startsWith("/wholesale");
    %>

    <% if (isShopPage || isCollectionPage || isProductPage) { %>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.7/css/swiper.min.css"
      />
    <% } %>

    <% if (isShopPage || isCollectionPage) { %>
      <link rel="stylesheet" href="/css/shop.css?v=light-theme-20260702" />
      <link rel="stylesheet" href="/css/brands.css" />
      <link rel="stylesheet" href="/css/collections.css" />
      <link rel="stylesheet" href="/css/best-sellers.css" />
    <% } %>

    <% if (isProductPage || isCollectionPage) { %>
      <link rel="stylesheet" href="/css/products.css?v=product-page-light-theme-20260702" />
    <% } %>

    <% if (isProductPage) { %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&display=swap">
      <link rel="stylesheet" href="/css/products-v4.css?v=v4-scroll-fix-20260716" />
    <% } %>

    <% if (isCartPage || isShopPage || isProductPage || isCollectionPage) { %>
      <link rel="stylesheet" href="/css/cart.css?v=v4-cart-20260717" />
    <% } %>

    <% if (isCartPage) { %>
      <style>main { width: 100% !important; max-width: none !important; padding-top: 138px; }</style>
    <% } %>

    <% if (isAuthPage) { %>
      <link rel="stylesheet" href="/css/auth.css" />
    <% } %>

    <% if (isAboutPage) { %>
      <link rel="stylesheet" href="/css/about.css?v=v4-about-20260717" />
      <style>main { width: 100% !important; max-width: none !important; padding-top: 138px; }</style>
    <% } %>

    <% if (isWholesalePage) { %>
      <link rel="stylesheet" href="/css/wholesale.css" />
    <% } %>

    <link rel="stylesheet" href="/css/browser-fixes.css?v=safari-20260611" />

    <!-- Web Icon -->
    <link rel="icon" href="/images/logo/snus-village-logo.webp" />

    <!-- Web title -->
  </head>
  <body>
    <div class="age-gate" id="ageModal" role="dialog" aria-modal="true" aria-labelledby="ageModalTitle" aria-hidden="true">
      <!-- Brand panel -->
      <div class="age-gate__brand" aria-hidden="true">
        <div class="age-gate__brand-top">
          <img src="/images/logo/snus-village-logo.webp" alt="Snus Village" class="age-gate__logo" />
          <div class="age-gate__brand-name">Snus Village</div>
          <p class="age-gate__brand-sub">Premium nicotine pouches for adult customers across London and the UK.</p>
        </div>
        <div class="age-gate__trust">
          <div class="age-gate__trust-item"><i class="fa-solid fa-shield-halved"></i> Age-restricted products only</div>
          <div class="age-gate__trust-item"><i class="fa-solid fa-truck-fast"></i> Fast UK delivery</div>
          <div class="age-gate__trust-item"><i class="fa-solid fa-store"></i> London retail locations</div>
        </div>
      </div>
      <!-- Form panel -->
      <div class="age-gate__form">
        <div class="age-gate__badge">18+ Only</div>
        <h1 class="age-gate__heading" id="ageModalTitle">Confirm<br>your <em>age.</em></h1>
        <p class="age-gate__desc">Snus Village sells age-restricted nicotine products. You must be 18 or over to browse and purchase. Formal age verification is required at checkout.</p>
        <label class="age-gate__dob-label" for="ageDob">
          <span>Date of birth</span>
          <input id="ageDob" class="age-gate__dob-input" type="date" autocomplete="bday" required />
        </label>
        <p class="age-gate__error" id="ageError" aria-live="polite"></p>
        <div class="age-gate__actions">
          <button id="enterSite" class="age-gate__enter" type="button">Enter Site <i class="fa-solid fa-arrow-right"></i></button>
          <button id="exitSite" class="age-gate__exit" type="button">I am under 18 — exit</button>
        </div>
        <p class="age-gate__note">Your age is verified once every 24 hours. We do not store your date of birth.</p>
      </div>
    </div>
    <div class="cookie-banner" id="cookieBanner">
      <p>We use cookies to improve your experience.</p>

      <div class="cookie-buttons">
        <button id="acceptCookies">Accept All</button>
        <button id="rejectCookies">Reject</button>
      </div>
    </div>
    <%- include('../partials/header') %>

    <main><%- body %></main>

    <%- include('../partials/footer') %>

    <% if (typeof currentPath === "undefined" || currentPath !== "/cart") { %>
      <%- include("../partials/cart") %>
    <% } %>

    <script src="/js/main.js" defer></script>

    <% if (isShopPage || isCollectionPage) { %>
      <script src="/js/shop.js" defer></script>
    <% } %>

    <% if (isProductPage || isCollectionPage) { %>
      <script src="/js/products.js" defer></script>
    <% } %>

    <% if (isCartPage || isShopPage || isProductPage || isCollectionPage) { %>
      <script src="/js/cart.js" defer></script>
    <% } %>

    <% if (isAuthPage) { %>
      <script src="/js/auth.js" defer></script>
    <% } %>

    <% if (isAboutPage) { %>
      <script src="/js/about.js" defer></script>
      <script src="/js/social.js" defer></script>
    <% } %>

    <% if (isShopPage || isCollectionPage || isProductPage) { %>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.7/js/swiper.min.js"></script>
    <% } %>
  </body>
</html>
