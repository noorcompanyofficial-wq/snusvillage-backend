<%
  const activePrice = Number(product.discountPrice && product.discountPrice > 0 ? product.discountPrice : product.price || 0);
  const originalPrice = Number(product.price || 0);
  const hasSalePrice = product.discountPrice && product.discountPrice > 0;
  const inStock = Number(product.stock || 0) > 0;
  const productImages = product.images && product.images.length ? product.images : [];
  const hasMultipleProductImages = productImages.length > 1;
  const pouchesPerCan = Number(product.pouchesPerCan || 20);
  const pouchesPerCanLabel = pouchesPerCan > 0 ? pouchesPerCan + " per can" : "N/A";
  const freeDeliveryThreshold = Number((typeof storeSettings !== "undefined" && storeSettings?.freeDeliveryThreshold) || 10);
  const bundleQuantities = [1, 3, 5, 10].filter((qty) => qty <= Math.max(Number(product.stock || 0), 1));
  const strengthClass = (product.strength || "medium").toLowerCase().replace("-", "");
%>

<% if (typeof schema !== "undefined" && schema) { %>
  <script type="application/ld+json"><%- schema %></script>
<% } %>

<div class="pdv4">
  <!-- V4 breadcrumb bar: full-width dark navy strip -->
  <div class="pdv4-breadcrumb-bar">
    <div class="pdv4-breadcrumb-bar__inner">
      <a href="/">Home</a>
      <span class="pdv4-bc-sep">›</span>
      <a href="/shop">Shop</a>
      <% if (product.brand) { %>
        <span class="pdv4-bc-sep">›</span>
        <a href="/shop?brand=<%= encodeURIComponent(product.brand) %>"><%= product.brand %></a>
      <% } %>
      <span class="pdv4-bc-sep">›</span>
      <strong><%= product.name %></strong>
    </div>
  </div>

  <section class="pd">
    <!-- Legacy breadcrumb hidden via .pdv4 .pd-breadcrumb { display: none } -->
    <nav class="pd-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/shop">Shop</a>
      <% if (product.brand) { %>
        <span>/</span>
        <a href="/shop?brand=<%= encodeURIComponent(product.brand) %>"><%= product.brand %></a>
      <% } %>
      <span>/</span>
      <strong><%= product.name %></strong>
    </nav>

    <div class="pd-detail">
      <div class="pd-gallery">
        <div class="pd-gallery__main">
          <span class="pd-strength-badge pd-strength-badge--<%= strengthClass %>"><%= product.strength || "Medium" %></span>
          <% if (hasSalePrice) { %>
            <span class="pd-sale-badge">Sale</span>
          <% } %>

          <% if (productImages.length) { %>
            <% if (hasMultipleProductImages) { %>
              <button class="pd-gallery__nav pd-gallery__nav--prev" type="button" aria-label="Previous product image">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
              </button>
            <% } %>
            <img id="pdMainImage" src="<%= optimiseImageUrl(productImages[0], { width: 1200, quality: 'auto:best' }) %>" alt="<%= product.name %>" loading="eager" decoding="async">
            <% if (hasMultipleProductImages) { %>
              <button class="pd-gallery__nav pd-gallery__nav--next" type="button" aria-label="Next product image">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
              </button>
            <% } %>
          <% } else { %>
            <div class="pd-gallery__placeholder">No image</div>
          <% } %>

          <!-- V4 strength colour bar at bottom of gallery -->
          <div class="pdv4-sbar pdv4-sbar--<%= strengthClass %>"></div>
        </div>

        <% if (hasMultipleProductImages) { %>
          <div class="pd-gallery__thumbs" aria-label="Product images">
            <% productImages.forEach((img, i) => { %>
              <button class="pd-gallery__thumb <%= i === 0 ? 'is-active' : '' %>" type="button" data-product-image="<%= optimiseImageUrl(img, { width: 1200, quality: 'auto:best' }) %>" aria-label="Show <%= product.name %> image <%= i + 1 %>">
                <img src="<%= optimiseImageUrl(img, { width: 200 }) %>" alt="<%= product.name %> image <%= i + 1 %>" loading="lazy" decoding="async">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <aside class="pd-info" aria-label="Product purchase information">
        <a class="pd-info__brand" href="/shop?brand=<%= encodeURIComponent(product.brand || '') %>"><%= product.brand || "Snus Village" %></a>

        <h1><%= product.name %></h1>

        <p class="pd-info__description">
          <%= product.description || "Premium nicotine pouch available from Snus Village." %>
        </p>

        <div class="pd-spec-grid">
          <div class="pd-spec">
            <div class="pd-spec__label">Strength</div>
            <div class="pd-spec__value"><%= product.strength || "N/A" %></div>
          </div>
          <div class="pd-spec">
            <div class="pd-spec__label">Nicotine</div>
            <div class="pd-spec__value"><%= product.nicotine ? product.nicotine + "mg/g" : "N/A" %></div>
          </div>
          <div class="pd-spec">
            <div class="pd-spec__label">Pouches</div>
            <div class="pd-spec__value"><%= pouchesPerCanLabel %></div>
          </div>
          <div class="pd-spec">
            <div class="pd-spec__label">Flavour</div>
            <div class="pd-spec__value"><%= product.flavour || "N/A" %></div>
          </div>
        </div>

        <div class="pd-warning" role="note">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          <span>
            <strong>Nicotine Pouch Warning</strong>
            Contains nicotine. Nicotine is an addictive substance. For use by adults 18+ only.
          </span>
        </div>

        <div class="pd-buybox">
          <div class="pd-buybox__price-row">
            <span class="pd-price">£<%= activePrice.toFixed(2) %></span>
            <% if (hasSalePrice) { %>
              <span class="pd-price-old">£<%= originalPrice.toFixed(2) %></span>
            <% } %>
            <span class="pd-stock-pill <%= inStock ? 'pd-stock-pill--in' : 'pd-stock-pill--out' %>">
              <%= inStock ? "In Stock" : "Out of Stock" %>
            </span>
          </div>

          <% if (inStock) { %>
            <form action="/cart/add/<%= product._id %>" method="POST" class="pd-buybox__form" id="pdAddForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (bundleQuantities.length > 1) { %>
                <fieldset class="pd-qty-options">
                  <legend>Choose quantity</legend>
                  <div class="pd-qty-grid">
                    <% bundleQuantities.forEach((qty, index) => { %>
                      <button class="pd-qty-chip <%= index === 0 ? 'is-active' : '' %>" type="button" data-quantity="<%= qty %>">
                        <strong><%= qty %></strong>
                        <span><%= qty === 1 ? "can" : "cans" %></span>
                      </button>
                    <% }) %>
                  </div>
                </fieldset>
              <% } %>

              <label class="pd-qty-input">
                <span>Quantity</span>
                <input id="pdQuantity" type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
              </label>

              <button class="pd-add-button" type="submit">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                Add to Cart
              </button>
            </form>

            <div
              class="pd-express"
              id="pdExpressCheckout"
              data-product-id="<%= product._id %>"
              data-sumup-public-key="<%= sumupPublicKey || "" %>"
              data-google-pay-merchant-id="<%= googlePayMerchantId || "" %>"
              hidden
            >
              <div class="pd-express__title"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Buy this product now</div>
              <div id="pdExpressCheckoutContainer" class="pd-express__container"></div>
              <p class="pd-express__note">
                Express payment purchases only this product in your selected quantity.
                For multiple products, use <a href="/cart">cart express checkout</a>.
              </p>
              <p id="pdExpressCheckoutError" class="pd-express__error" role="alert" aria-live="polite" hidden></p>
            </div>
          <% } else { %>
            <button class="pd-disabled-button" disabled>Out of Stock</button>
          <% } %>

          <div class="pd-service-grid">
            <div class="pd-service">
              <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
              <div><strong>Fast UK Delivery</strong><span>From £<%= freeDeliveryThreshold.toFixed(2) %>, next day available</span></div>
            </div>
            <div class="pd-service">
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              <div><strong>Age Verified</strong><span>Checkout requires 18+ ID check</span></div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="pd-sections">
      <div class="pd-section">
        <h2>Product Details</h2>
        <ul>
          <li><strong>Brand:</strong> <%= product.brand || "Snus Village" %></li>
          <li><strong>Product type:</strong> <%= product.category || "Nicotine pouch" %></li>
          <li><strong>Flavour profile:</strong> <%= product.flavour || "See product description" %></li>
          <li><strong>Strength level:</strong> <%= product.strength || "N/A" %></li>
          <% if (product.sku) { %>
            <li><strong>SKU:</strong> <%= product.sku %></li>
          <% } %>
          <li><strong>Tobacco-free</strong> nicotine pouch</li>
        </ul>
      </div>

      <div class="pd-section">
        <h2>Delivery &amp; Returns</h2>
        <ul>
          <li>Standard UK delivery from <strong>£1.99</strong></li>
          <li>Next-day delivery available before <strong>4:30pm</strong></li>
          <li>Free shipping over <strong>£<%= freeDeliveryThreshold.toFixed(2) %></strong></li>
          <li>Age verification required on delivery</li>
        </ul>
      </div>

      <div class="pd-section">
        <h2>Responsible Use</h2>
        <ul>
          <li>For adults <strong>18+</strong> only</li>
          <li>Contains nicotine, an addictive substance</li>
          <li>Keep out of reach of children and pets</li>
          <li>Not a smoking cessation product</li>
        </ul>
      </div>
    </div>

    <% if (related && related.length) { %>
      <section class="pd-related" aria-labelledby="pdRelatedTitle">
        <div class="pd-related__head">
          <div>
            <span class="pd-related__eyebrow">You May Also Like</span>
            <h2 id="pdRelatedTitle">More From <%= product.brand || "This Brand" %></h2>
          </div>

          <a href="/shop?brand=<%= encodeURIComponent(product.brand || '') %>">View All</a>
        </div>

        <div class="pd-related__shell">
          <button class="pd-related__nav pd-related__nav--prev" type="button" aria-label="Scroll previous products">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>

          <div class="pd-related__track" id="pdRelatedTrack">
            <% related.forEach((item) => { %>
              <%
                const relatedImage = item.images && item.images.length ? item.images[0] : "";
                const relatedPrice = Number(item.discountPrice && item.discountPrice > 0 ? item.discountPrice : item.price || 0);
                const relatedStrengthClass = (item.strength || "medium").toLowerCase().replace("-", "");
              %>
              <a class="pd-related-card" href="/products/<%= item.slug || item._id %>">
                <div class="pd-related-card__media">
                  <span class="pd-strength-badge pd-strength-badge--<%= relatedStrengthClass %> pd-strength-badge--sm"><%= item.strength || "Medium" %></span>
                  <% if (relatedImage) { %>
                    <img src="<%= optimiseImageUrl(relatedImage, { width: 420, quality: 'auto:good' }) %>" alt="<%= item.name %>" loading="lazy" decoding="async">
                  <% } else { %>
                    <span>No image</span>
                  <% } %>
                  <!-- V4 strength colour bar on related card -->
                  <div class="pdv4-sbar pdv4-sbar--<%= relatedStrengthClass %>"></div>
                </div>

                <div class="pd-related-card__body">
                  <div class="pd-related-card__brand"><%= item.brand || "Snus Village" %></div>
                  <div class="pd-related-card__name"><%= item.name %></div>
                  <div class="pd-related-card__footer">
                    <div class="pd-related-card__price">£<%= relatedPrice.toFixed(2) %></div>
                    <span class="pd-related-card__view">View</span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>

          <button class="pd-related__nav pd-related__nav--next" type="button" aria-label="Scroll next products">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </section>
    <% } %>
  </section>

  <!-- V4 strength guide strip -->
  <div class="pdv4-strength-strip" aria-label="Nicotine strength guide">
    <div class="pdv4-strength-strip__item pdv4-strength-strip__item--low <%= strengthClass === 'low' ? 'pdv4-strength-strip__item--active' : '' %>">
      <div class="pdv4-strength-strip__name">Low</div>
      <div class="pdv4-strength-strip__range">Under 6mg/g</div>
    </div>
    <div class="pdv4-strength-strip__item pdv4-strength-strip__item--medium <%= strengthClass === 'medium' ? 'pdv4-strength-strip__item--active' : '' %>">
      <div class="pdv4-strength-strip__name">Medium</div>
      <div class="pdv4-strength-strip__range">6 – 12mg/g</div>
    </div>
    <div class="pdv4-strength-strip__item pdv4-strength-strip__item--strong <%= strengthClass === 'strong' ? 'pdv4-strength-strip__item--active' : '' %>">
      <div class="pdv4-strength-strip__name">Strong</div>
      <div class="pdv4-strength-strip__range">12 – 18mg/g</div>
    </div>
    <div class="pdv4-strength-strip__item pdv4-strength-strip__item--xstrong <%= strengthClass === 'xstrong' ? 'pdv4-strength-strip__item--active' : '' %>">
      <div class="pdv4-strength-strip__name">X-Strong</div>
      <div class="pdv4-strength-strip__range">18 – 30mg/g</div>
    </div>
    <div class="pdv4-strength-strip__item pdv4-strength-strip__item--extreme <%= strengthClass === 'extreme' ? 'pdv4-strength-strip__item--active' : '' %>">
      <div class="pdv4-strength-strip__name">Extreme</div>
      <div class="pdv4-strength-strip__range">30mg/g+</div>
    </div>
  </div>
</div>

<% if (sumupPublicKey && inStock) { %>
  <script src="https://js.sumup.com/swift-checkout/v1/sdk.js"></script>
<% } %>

<script>
  (function () {
    const mainImage = document.getElementById("pdMainImage");
    const thumbnailButtons = Array.from(document.querySelectorAll(".pd-gallery__thumb"));
    const galleryPrev = document.querySelector(".pd-gallery__nav--prev");
    const galleryNext = document.querySelector(".pd-gallery__nav--next");
    let activeIndex = 0;

    function showImage(index) {
      if (!mainImage || !thumbnailButtons.length) return;

      activeIndex = (index + thumbnailButtons.length) % thumbnailButtons.length;
      const selected = thumbnailButtons[activeIndex];
      const imageUrl = selected.dataset.productImage;

      if (imageUrl) {
        mainImage.src = imageUrl;
      }

      thumbnailButtons.forEach((button, buttonIndex) => {
        button.classList.toggle("is-active", buttonIndex === activeIndex);
      });
    }

    thumbnailButtons.forEach((button, index) => {
      button.addEventListener("click", () => showImage(index));
    });

    galleryPrev?.addEventListener("click", () => showImage(activeIndex - 1));
    galleryNext?.addEventListener("click", () => showImage(activeIndex + 1));

    const quantityInput = document.getElementById("pdQuantity");
    const quantityChips = Array.from(document.querySelectorAll(".pd-qty-chip"));

    function setQuantity(value) {
      if (!quantityInput) return;

      const max = Number(quantityInput.max || value);
      const quantity = Math.max(1, Math.min(Number(value || 1), max));
      quantityInput.value = quantity;

      quantityChips.forEach((chip) => {
        chip.classList.toggle("is-active", Number(chip.dataset.quantity) === quantity);
      });

      if (expressSection && !expressProcessing) {
        window.clearTimeout(expressRefreshTimer);
        expressRefreshTimer = window.setTimeout(initialiseProductExpress, 200);
      }
    }

    quantityChips.forEach((chip) => {
      chip.addEventListener("click", () => setQuantity(chip.dataset.quantity));
    });

    quantityInput?.addEventListener("input", () => setQuantity(quantityInput.value));

    const expressSection = document.getElementById("pdExpressCheckout");
    const expressContainer = document.getElementById("pdExpressCheckoutContainer");
    const expressError = document.getElementById("pdExpressCheckoutError");
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || "";
    let expressClient;
    let expressRequest;
    let expressButtons;
    let expressProcessing = false;
    let expressDeliveryService = "standard";
    let expressRefreshTimer;

    function expressMessage(message) {
      if (!expressError) return;
      expressError.textContent = message || "";
      expressError.hidden = !message;
    }

    async function expressPost(url, body) {
      const response = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          "X-CSRF-Token": csrfToken,
        },
        body: JSON.stringify(body),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.message || "Express checkout is unavailable.");
      }
      return result;
    }

    function productRequestBody(extra = {}) {
      return {
        productId: expressSection?.dataset.productId || "",
        quantity: Number(quantityInput?.value || 1),
        deliveryService: expressDeliveryService,
        ...extra,
      };
    }

    async function productQuote(extra) {
      return expressPost("/checkout/express/quote", productRequestBody(extra));
    }

    function configureProductShipping(request) {
      request.onShippingAddressChange(async (address) => {
        const countryCode =
          address?.countryCode || address?.country || address?.country_code || "GB";
        const quote = await productQuote({ countryCode });
        return { total: quote.total, shippingOptions: quote.shippingOptions };
      });
      request.onShippingOptionsChange(async (option) => {
        expressDeliveryService = option?.id || option?.shippingOption || option || "standard";
        const quote = await productQuote({ countryCode: "GB" });
        return { total: quote.total, shippingOptions: quote.shippingOptions };
      });
    }

    function walletOrderDetails(response) {
      const details = response?.details || {};
      const contact = details.contactInformation || details.contact || details.payer || {};
      const address = details.shippingAddress || details.shipping_address || {};
      const fullName = String(
        contact.name || contact.fullName || address.recipient || address.name || ""
      ).trim().split(/\s+/);
      const lines = address.addressLine || address.addressLines || address.address_line || [];
      const selected =
        details.shippingOption?.id ||
        details.shippingOption ||
        details.shippingOptions?.id ||
        details.shippingOptions?.[0]?.id ||
        expressDeliveryService;

      return {
        customer: {
          email: contact.email || details.payerEmail || "",
          phone: contact.phone || contact.phoneNumber || details.payerPhone || "",
          firstName: contact.firstName || contact.givenName || fullName.shift() || "",
          lastName: contact.lastName || contact.familyName || fullName.join(" "),
        },
        delivery: {
          address: Array.isArray(lines) ? lines.filter(Boolean).join(", ") : String(lines || ""),
          city: address.city || address.locality || address.town || "",
          postcode: address.postalCode || address.postcode || address.postal_code || "",
          countryCode: String(
            address.countryCode || address.country || address.country_code || ""
          ).toUpperCase(),
        },
        deliveryService: selected === "next-day" ? "next_day" : selected,
      };
    }

    async function submitProductWallet(event) {
      if (expressProcessing || !expressRequest) return;
      expressProcessing = true;
      expressSection.classList.add("is-processing");
      expressMessage("");
      let returnUrl = "";

      try {
        const paymentResponse = await expressRequest.show(event);
        const attemptId = window.crypto?.randomUUID
          ? window.crypto.randomUUID()
          : `wallet-${Date.now()}-${Math.random().toString(36).slice(2)}`;
        const order = await expressPost(
          "/checkout/express/create-order",
          productRequestBody({ ...walletOrderDetails(paymentResponse), attemptId })
        );
        returnUrl = order.returnUrl;
        await expressClient.processCheckout(order.checkoutId, paymentResponse);
        window.location.assign(returnUrl);
      } catch (error) {
        const cancelled =
          window.SumUp?.SwiftCheckout?.Errors?.PaymentRequestCancelledError;
        if (returnUrl) {
          window.location.assign(returnUrl);
          return;
        }
        expressMessage(
          cancelled && error instanceof cancelled
            ? "Express checkout was cancelled. You have not been charged."
            : error?.message || "Use cart express checkout or the normal checkout."
        );
        expressProcessing = false;
        expressSection.classList.remove("is-processing");
      }
    }

    async function initialiseProductExpress() {
      const publicKey = expressSection?.dataset.sumupPublicKey || "";
      if (!publicKey || !window.SumUp?.SwiftCheckout || !expressContainer) return;

      try {
        expressButtons?.unmount?.();
        expressContainer.replaceChildren();
        expressSection.hidden = true;
        const quote = await productQuote({ countryCode: "GB" });
        expressClient = new window.SumUp.SwiftCheckout(publicKey);
        const options = {
          countryCode: "GB",
          locale: "en-GB",
          total: quote.total,
          shippingOptions: quote.shippingOptions,
        };
        const googleMerchantId = expressSection.dataset.googlePayMerchantId;
        if (googleMerchantId) {
          options.methodData = [{
            supportedMethods: "google_pay",
            data: { merchantInfo: { merchantId: googleMerchantId, merchantName: "Snus Village" } },
          }];
        }
        expressRequest = expressClient.paymentRequest(options);
        configureProductShipping(expressRequest);
        if (!(await expressRequest.canMakePayment())) return;
        let methods = await expressRequest.availablePaymentMethods();
        const demoMode = [
          "#sumup:google-pay-demo-mode",
          "#sumup-widget:google-pay-demo-mode",
        ].includes(window.location.hash);
        if (demoMode && !methods.some((method) => method.id === "google_pay")) {
          methods.push({ id: "google_pay" });
        } else if (!googleMerchantId) {
          methods = methods.filter((method) => method.id !== "google_pay");
        }
        if (!methods.length) return;
        expressButtons = expressClient.elements({ label: "buy" });
        expressButtons.onSubmit(submitProductWallet).mount({
          paymentMethods: methods,
          container: expressContainer,
        });
        expressSection.hidden = false;
      } catch (error) {
        console.warn("Product express checkout unavailable:", error?.message || error);
      }
    }

    initialiseProductExpress();

    const relatedTrack = document.getElementById("pdRelatedTrack");
    const relatedPrev = document.querySelector(".pd-related__nav--prev");
    const relatedNext = document.querySelector(".pd-related__nav--next");

    function scrollRelated(direction) {
      if (!relatedTrack) return;
      relatedTrack.scrollBy({
        left: direction * Math.max(260, relatedTrack.clientWidth * 0.8),
        behavior: "smooth",
      });
    }

    relatedPrev?.addEventListener("click", () => scrollRelated(-1));
    relatedNext?.addEventListener("click", () => scrollRelated(1));
  })();
</script>
