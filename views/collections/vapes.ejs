<%
  function toTitleCase(value) {
    return String(value || "Other")
      .trim()
      .toLowerCase()
      .replace(/\b\w/g, (char) => char.toUpperCase());
  }

  const grouped = new Map();

  (products || []).forEach((product) => {
    const brandName = toTitleCase(product.brand || "Other");
    const key = brandName.toLowerCase();

    if (!grouped.has(key)) {
      grouped.set(key, {
        brand: brandName,
        products: [],
        count: 0,
      });
    }

    grouped.get(key).products.push(product);
    grouped.get(key).count += 1;
  });

  const brandSections = Array.from(grouped.values()).sort((a, b) => a.brand.localeCompare(b.brand));
%>

<section class="shop-page">
  <div class="shop-hero">
    <div class="shop-hero__content">
      <span class="shop-eyebrow">Vape Collection</span>
      <h1>Shop Premium Vapes</h1>
      <p>
        Browse selected vape products, flavours, brands and fast-moving stock from Snus Village.
      </p>

      <div class="shop-hero__badges">
        <span>18+ Only</span>
        <span>Age Restricted</span>
        <span>Authentic Stock</span>
        <span>London Retail Support</span>
      </div>
    </div>
  </div>

  <div class="shop-toolbar">
    <form class="shop-search-form" action="/collections/vapes" method="GET">
      <div class="shop-search-box">
        <label for="vapeSearch">Search Vapes</label>
        <input
          id="vapeSearch"
          type="text"
          name="search"
          value="<%= query?.search || '' %>"
          placeholder="Search Brand, Flavour Or Vape..."
        >
      </div>

      <div class="shop-filter-box">
        <label for="vapeBrand">Brand</label>
        <select id="vapeBrand" name="brand">
          <option value="">All Brands</option>
          <% brands.forEach((brand) => { %>
            <option value="<%= brand %>" <%= query?.brand === brand ? "selected" : "" %>><%= brand %></option>
          <% }) %>
        </select>
      </div>

      <div class="shop-filter-box">
        <label for="vapeFlavour">Flavour</label>
        <select id="vapeFlavour" name="flavour">
          <option value="">All Flavours</option>
          <% flavours.forEach((flavour) => { %>
            <option value="<%= flavour %>" <%= query?.flavour === flavour ? "selected" : "" %>><%= flavour %></option>
          <% }) %>
        </select>
      </div>

      <div class="shop-filter-box">
        <label for="vapeSort">Sort</label>
        <select id="vapeSort" name="sort">
          <option value="" <%= !query?.sort ? "selected" : "" %>>Newest</option>
          <option value="price-low" <%= query?.sort === "price-low" ? "selected" : "" %>>Price Low</option>
          <option value="price-high" <%= query?.sort === "price-high" ? "selected" : "" %>>Price High</option>
          <option value="name" <%= query?.sort === "name" ? "selected" : "" %>>Name A-Z</option>
        </select>
      </div>

      <div class="shop-filter-actions">
        <button type="submit">Filter</button>
        <a href="/collections/vapes">Reset</a>
      </div>
    </form>
  </div>

  <section class="shop-age-notice" style="width:min(1180px,calc(100% - 28px));margin:18px auto 0;padding:16px 18px;border-radius:20px;background:#fff;border:1px solid rgba(9,31,77,.08);box-shadow:0 14px 34px rgba(6,22,51,.06);">
    <strong style="color:#b41232;">Age Restricted Products</strong>
    <p style="margin:6px 0 0;color:#64748b;font-weight:700;">
      Vape products are intended only for adult customers aged 18 or over. Challenge 25 may apply.
    </p>
  </section>

  <% if (!products || products.length === 0) { %>
    <div class="empty-shop">
      <span>0 Products</span>
      <h2>No Vape Products Found</h2>
      <p>Add vape products from the admin dashboard with category set to <strong>vape</strong> or <strong>vapes</strong>.</p>
      <a href="/shop">Shop Nicotine Pouches</a>
    </div>
  <% } else { %>
    <div class="shop-results-head">
      <div>
        <span class="shop-eyebrow">Available Now</span>
        <h2>Vape Collection</h2>
      </div>

      <p>
        <%= totalProducts || products.length %> Product<%= (totalProducts || products.length) === 1 ? "" : "s" %>
        Across <%= brandSections.length %> Brand<%= brandSections.length === 1 ? "" : "s" %>
      </p>
    </div>

    <div class="shop-brand-layout">
      <% brandSections.forEach(section => { %>
        <section class="shop-brand-section" id="brand-<%= section.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
          <div class="shop-brand-head">
            <div>
              <span class="shop-brand-kicker">Vape Brand Range</span>
              <h3><%= section.brand %></h3>
            </div>

            <span class="shop-brand-count">
              <%= section.count %> Product<%= section.count === 1 ? "" : "s" %>
            </span>
          </div>

          <div class="shop-brand-carousel-wrap">
            <button type="button" class="shop-brand-arrow shop-brand-arrow--prev" aria-label="Scroll <%= section.brand %> Left">‹</button>

            <div class="shop-brand-products" data-brand-carousel>
              <% section.products.forEach(p => { %>
                <% const finalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price; %>

                <article class="shop-product-card">
                  <div class="shop-product-badges">
                    <% if (p.showSaleBadge && p.discountPrice && p.discountPrice > 0) { %>
                      <span class="shop-product-badge sale">Sale</span>
                    <% } %>
                    <% if (p.isBestSeller) { %>
                      <span class="shop-product-badge best">Best Seller</span>
                    <% } %>
                    <% if (p.isFeatured) { %>
                      <span class="shop-product-badge featured">Featured</span>
                    <% } %>
                  </div>

                  <a href="/products/<%= p.slug || p._id %>" class="shop-product-image">
                    <% if (p.images && p.images.length > 0) { %>
                      <img src="<%= optimiseImageUrl(p.images[0], { width: 420 }) %>" alt="<%= p.name %>" loading="lazy" decoding="async">
                    <% } else { %>
                      <span>No Image</span>
                    <% } %>
                  </a>

                  <div class="shop-product-body">
                    <div class="shop-product-top">
                      <span class="strength-badge"><%= p.flavour || "Vape" %></span>
                      <span class="<%= p.stock > 0 ? 'shop-stock in' : 'shop-stock out' %>">
                        <%= p.stock > 0 ? "In Stock" : "Out Of Stock" %>
                      </span>
                    </div>

                    <h2>
                      <a href="/products/<%= p.slug || p._id %>"><%= p.name %></a>
                    </h2>

                    <p>
                      <%= p.description ? p.description.substring(0, 96) : "Adult-only vape product from Snus Village." %><%= p.description && p.description.length > 96 ? "..." : "" %>
                    </p>

                    <div class="shop-product-meta">
                      <span><%= p.brand || "Brand N/A" %></span>
                      <span><%= p.nicotine ? p.nicotine + "mg" : "Nicotine N/A" %></span>
                    </div>

                    <div class="shop-product-bottom">
                      <div class="shop-price-wrap">
                        <% if (p.discountPrice && p.discountPrice > 0) { %>
                          <small>£<%= Number(p.price || 0).toFixed(2) %></small>
                        <% } %>
                        <strong>£<%= Number(finalPrice || 0).toFixed(2) %></strong>
                      </div>

                      <% if (p.stock > 0) { %>
                        <form action="/cart/add/<%= p._id %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit">Add To Cart</button>
                        </form>
                      <% } else { %>
                        <a class="shop-view-btn" href="/products/<%= p.slug || p._id %>">View Product</a>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>

            <button type="button" class="shop-brand-arrow shop-brand-arrow--next" aria-label="Scroll <%= section.brand %> Right">›</button>
          </div>
        </section>
      <% }) %>
    </div>
  <% } %>
</section>


