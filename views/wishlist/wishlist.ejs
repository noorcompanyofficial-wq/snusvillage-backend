<%
  const STRENGTH_META = {
    "LOW": { label: "Low", color: "#22c55e" },
    "MEDIUM": { label: "Medium", color: "#3b82f6" },
    "STRONG": { label: "Strong", color: "#f59e0b" },
    "X-STRONG": { label: "X-Strong", color: "#ef4444" },
    "EXTREME": { label: "Extreme", color: "#7f1d1d" },
  };
%>
<div class="shop-v2">
  <div class="coll-hero">
    <div class="ch-inner">
      <div class="ch-text">
        <div class="ch-eye">Your Account</div>
        <h1 class="ch-title">Wishlist</h1>
        <p class="ch-sub">Products you've saved for later. Add them to your cart whenever you're ready.</p>
      </div>
    </div>
  </div>

  <div class="breadcrumb">
    <a href="/">Home</a>
    <i class="fa-solid fa-chevron-right"></i>
    <span>Wishlist</span>
  </div>

  <div class="main-content" style="padding:24px 40px 60px;">
    <% if (!products || products.length === 0) { %>
      <div class="empty visible">
        <i class="fa-solid fa-heart-crack"></i>
        <h3>Your wishlist is empty</h3>
        <p>Tap the heart icon on any product in the <a href="/shop">shop</a> to save it here.</p>
      </div>
    <% } else { %>
      <div class="prod-grid-v2" id="prodGrid">
        <% products.forEach((p) => {
          const finalPrice = p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price;
          const meta = STRENGTH_META[p.strength] || STRENGTH_META["MEDIUM"];
        %>
          <div class="pc">
            <div class="pc-inner">
              <div class="pc-img-wrap">
                <div class="pc-wish on" data-wish-toggle data-product-id="<%= p._id %>"><i class="fa-solid fa-heart"></i></div>
                <a href="/products/<%= p.slug || p._id %>">
                  <% if (p.images && p.images.length) { %>
                    <img src="<%= optimiseImageUrl(p.images[0], { width: 320 }) %>" alt="<%= p.name %>" loading="lazy">
                  <% } else { %>
                    <span style="color:var(--shop-mu);font-size:11px;">No Image</span>
                  <% } %>
                </a>
                <div class="pc-str-strip" style="background:<%= meta.color %>;"></div>
                <% if (p.stock <= 0) { %><div class="pc-out"><span>Out Of Stock</span></div><% } %>
              </div>
              <div class="pc-body">
                <div class="pc-brand"><%= p.brand || "" %></div>
                <h2 class="pc-name"><a href="/products/<%= p.slug || p._id %>"><%= p.name %></a></h2>
                <div class="pc-str-row">
                  <div class="pc-str-track"><div class="pc-str-fill" style="width:70%;background:<%= meta.color %>;"></div></div>
                  <span class="pc-str-label" style="color:<%= meta.color %>;"><%= meta.label %></span>
                </div>
                <div class="pc-foot">
                  <span class="pc-price">
                    <% if (p.discountPrice && p.discountPrice > 0) { %><small>&pound;<%= Number(p.price).toFixed(2) %></small><% } %>
                    &pound;<%= Number(finalPrice).toFixed(2) %>
                  </span>
                  <div class="pc-meta"><strong><%= p.nicotine ? p.nicotine + "mg" : "" %></strong>per pouch</div>
                </div>
              </div>
              <div class="pc-quick">
                <button type="button" data-quick-add data-product-id="<%= p._id %>" data-product-name="<%= p.name %>" <%= p.stock <= 0 ? "disabled" : "" %>>
                  <i class="fa-solid fa-bag-shopping"></i> <%= p.stock <= 0 ? "Out Of Stock" : "Quick Add" %>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="shop-v2-toast" id="shopToast"><i class="fa-solid fa-circle-check"></i><span id="shopToastMsg">Added to cart!</span></div>
</div>
