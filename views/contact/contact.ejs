<section class="contact-page">
  <div class="contact-hero">
    <div class="contact-copy">
      <span class="eyebrow">CONTACT US</span>
      <h1>Speak with Snus Village.</h1>
      <p>
        Questions about products, store stock, delivery, or wholesale access can
        be sent directly to our team.
      </p>
    </div>

    <div class="contact-cards">
      <a class="contact-card" href="mailto:info@snusvillage.co.uk">
        <span>Email</span>
        <strong>info@snusvillage.co.uk</strong>
      </a>

      <a class="contact-card" href="tel:+447777222771">
        <span>Phone</span>
        <strong>+44 7777 222771</strong>
      </a>

      <a class="contact-card" href="/wholesale">
        <span>Wholesale</span>
        <strong>Trader enquiries</strong>
      </a>
    </div>
  </div>

  <div class="contact-grid">
    <form class="contact-form" action="/contact" method="POST">
      <span class="eyebrow">MESSAGE</span>
      <h2>Send an enquiry</h2>

      <div class="form-row">
        <label>
          Name
          <input type="text" name="name" required>
        </label>

        <label>
          Email
          <input type="email" name="email" required>
        </label>
      </div>

      <div class="form-row">
        <label>
          Phone
          <input type="text" name="phone">
        </label>

        <label>
          Subject
          <input type="text" name="subject" required>
        </label>
      </div>

      <label>
        Message
        <textarea name="message" rows="6" required></textarea>
      </label>

      <button type="submit">Send Message</button>
    </form>

    <div class="store-locations">
      <span class="eyebrow">LOCATIONS</span>
      <h2>Visit our London stores</h2>

      <div class="store-card">
        <iframe
          src="https://www.google.com/maps?q=257%20Camden%20High%20St%20London%20NW1%207BU&output=embed"
          loading="lazy">
        </iframe>
        <div>
          <h3>Camden Town</h3>
          <p>257 Camden High St, London NW1 7BU</p>
        </div>
      </div>

      <div class="store-card">
        <iframe
          src="https://www.google.com/maps?q=339%20Oxford%20St%20London%20W1C%202JB&output=embed"
          loading="lazy">
        </iframe>
        <div>
          <h3>Oxford Street</h3>
          <p>Snus Village, 339 Oxford St, London W1C 2JB</p>
        </div>
      </div>

      <div class="store-card">
        <iframe
          src="https://www.google.com/maps?q=Edgware%20Road%20London&output=embed"
          loading="lazy">
        </iframe>
        <div>
          <h3>Edgware Road</h3>
          <p>Snus Village, Edgware Road, London</p>
        </div>
      </div>
    </div>
  </div>
</section>
