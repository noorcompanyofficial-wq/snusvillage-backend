<section class="contact-page">
  <div class="contact-hero">
    <div class="contact-hero__copy">
      <span class="contact-pill">Contact Snus Village</span>
      <h1>Need help with an order, product or delivery?</h1>
      <p>
        Send our customer service team a message and we will help with product questions,
        order updates, delivery issues, age verification and wholesale enquiries.
      </p>
    </div>

    <div class="contact-quick">
      <a href="mailto:hello@snusvillage.com">
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        <span>Email</span>
        <strong>hello@snusvillage.com</strong>
      </a>

      <a href="/customer-service">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
        <span>Help Centre</span>
        <strong>Customer service FAQ</strong>
      </a>

      <a href="/wholesale">
        <i class="fa-solid fa-store" aria-hidden="true"></i>
        <span>Wholesale</span>
        <strong>Trader enquiries</strong>
      </a>
    </div>
  </div>

  <% if (query && query.success) { %>
    <div class="contact-alert contact-alert--success">
      <i class="fa-solid fa-check" aria-hidden="true"></i>
      <span>Your message has been sent. We will reply as soon as possible.</span>
    </div>
  <% } %>

  <% if (query && query.error) { %>
    <div class="contact-alert contact-alert--error">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <span>We could not send your message. Please check the form and try again.</span>
    </div>
  <% } %>

  <div class="contact-grid">
    <form class="contact-form-panel" action="/contact" method="POST">
      <div class="contact-form-head">
        <span class="contact-pill">Message</span>
        <h2>Send an enquiry</h2>
      </div>

      <div class="contact-row">
        <label>
          <span>Name</span>
          <input type="text" name="name" required>
        </label>

        <label>
          <span>Email</span>
          <input type="email" name="email" required>
        </label>
      </div>

      <div class="contact-row">
        <label>
          <span>Phone optional</span>
          <input type="text" name="phone">
        </label>

        <label>
          <span>Subject</span>
          <input type="text" name="subject" required>
        </label>
      </div>

      <label>
        <span>Message</span>
        <textarea name="message" rows="6" required></textarea>
      </label>

      <% if (captchaEnabled && siteKey) { %>
        <input type="hidden" name="token" id="contactToken">
      <% } %>

      <button class="contact-submit" type="submit">Send Message</button>
    </form>

    <div class="contact-locations">
      <div class="contact-form-head">
        <span class="contact-pill">Office</span>
        <h2>Our location</h2>
      </div>

      <div class="contact-location">
        <iframe
          src="https://www.google.com/maps?q=Snus%20Village%2089%20Edgware%20Road%20London%20W2%202HX&output=embed"
          loading="lazy">
        </iframe>
        <div>
          <h3>Snus Village</h3>
          <p>89 Edgware Road, London W2 2HX</p>
        </div>
      </div>

      <div class="contact-location contact-support-note">
        <div>
          <h3>Customer service</h3>
          <p>
            For the fastest help, include your order number, account email and any
            photos or screenshots that explain the issue.
          </p>
          <a href="/customer-service">Read the FAQ</a>
        </div>
      </div>
    </div>
  </div>
</section>
