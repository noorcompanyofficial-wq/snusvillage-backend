<link rel="stylesheet" href="/css/auth.css" />

<div id="flash-container">
  <% if (error && error.length > 0) { %>
    <div class="flash flash-error">
      <span><%= error %></span>
      <button class="flash-close" onclick="closeFlash(this)" type="button">×</button>
    </div>
  <% } %>

  <% if (success && success.length > 0) { %>
    <div class="flash flash-success">
      <span><%= success %></span>
      <button class="flash-close" onclick="closeFlash(this)" type="button">×</button>
    </div>
  <% } %>
</div>

<section class="auth-page auth-page--login">
  <div class="auth-visual">
    <span class="auth-pill">Customer Login</span>
    <h1>Welcome back to Snus Village.</h1>
    <p>
      Sign in to manage your account, track access, and keep your customer
      details ready for checkout.
    </p>
    <div class="auth-visual__stats">
      <div><strong>18+</strong><span>Verified access only</span></div>
      <div><strong>Secure</strong><span>Protected login monitoring</span></div>
    </div>
  </div>

  <div class="auth-box">
    <span class="auth-pill">Sign In</span>
    <h2>Customer login</h2>
    <p class="auth-sub">Use the email and password from your customer account.</p>

    <form class="auth-form" method="post" action="/auth/login">
      <label class="input-group">
        <i class="fa-solid fa-envelope"></i>
        <input type="email" autocomplete="email" name="email" placeholder="Email" required />
      </label>

      <label class="input-group">
        <i class="fa-solid fa-lock"></i>
        <input
          type="password"
          autocomplete="current-password"
          name="password"
          placeholder="Password"
          required
        />
      </label>

      <div class="extra">
        <label>
          <input type="checkbox" name="remember" />
          Remember me
        </label>

        <a href="/auth/forgot">Forgot password?</a>
      </div>

      <button class="auth-btn" type="submit">Log In</button>

      <p class="switch">
        New customer?
        <a href="/auth/register">Create an account</a>
      </p>
    </form>
  </div>
</section>
